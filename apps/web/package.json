{
  "name": "framework-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "quasar dev",
    "build": "quasar build",
    "preview": "vite preview",
    "prepare:cesium": "node scripts/copy-cesium.mjs",
    "stylelint": "stylelint \"src/**/*.{vue,css,scss}\" --config stylelint.config.mjs",
    "stylelint:fix": "stylelint \"src/**/*.{vue,css,scss}\" --config stylelint.config.mjs --fix",
    "color:gate": "node scripts/check-color-tokens.mjs",
    "lint": "eslint \"src/**/*.{ts,vue}\"",
    "lint:fix": "eslint \"src/**/*.{ts,vue}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css,scss}\"",
    "type-check": "vue-tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify:radar": "cd ../.. && node -e \"require('fs').copyFileSync('docs/ui-verify/run-verify-radar.mjs','apps/web/scripts/run-radar-verify.mjs')\" && node apps/web/scripts/run-radar-verify.mjs"
  },
  "overrides": {
    "@zip.js/zip.js": "2.7.62",
    "@cesium/engine": "11.0.0",
    "@cesium/widgets": "8.0.0"
  },
  "dependencies": {
    "@antv/x6-plugin-dnd": "^2.1.1",
    "@antv/x6-plugin-export": "^2.1.6",
    "@antv/x6-plugin-minimap": "^2.0.7",
    "@types/file-saver": "^2.0.7",
    "@types/qrcode": "^1.5.6",
    "@xterm/addon-search": "^0.16.0",
    "axios": "^1.9.0",
    "dagre": "^0.8.5",
    "echarts": "^6.1.0",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^3.0.2",
    "qrcode": "^1.5.4",
    "quasar": "^2.19.3",
    "vue": "^3.5.17",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.5.1",
    "vue-tsc": "^3.2.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pinia/testing": "^1.0.3",
    "@playwright/test": "^1.62.1",
    "@quasar/app-vite": "^2.6.0",
    "@quasar/extras": "^1.18.0",
    "@types/dagre": "^0.7.54",
    "@types/node": "^24.0.12",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.6.0",
    "jsdom": "^30.0.1",
    "nats": "^2.29.3",
    "postcss-html": "^2.0.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.8.3",
    "sass-embedded": "^1.89.2",
    "stylelint": "^17.11.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^6.3.5",
    "vitest": "^4.1.11",
    "ws": "^8.21.3"
  }
}
