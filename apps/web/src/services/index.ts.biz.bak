  alarmLevelFatal?: string;
  handleAction?: string;
  warningNoticeProfileId?: number;
  fatalNoticeProfileId?: number;
  warningNoticeMode?: string;
  fatalNoticeMode?: string;
  // 多级阈值带（非空时引擎优先于 warning/fatal 两级列）
  thresholds?: ItemThreshold[];
  // Update 需显式清空 thresholds 时置 true（protojson 空数组解码为 nil 无法区分）
  clearThresholds?: boolean;
  sortOrder?: number;
  status?: number;
}
export const alarmDeviceTemplateService = {
  list(opts: PagingRequest & { formValues?: Record<string, unknown> } = {}) {
    const params = buildQueryParams(opts.formValues, opts);
    const fv = opts.formValues ?? {};
    return alarmDeviceTemplateClient.ListDeviceTemplates({
      deviceType: fv.deviceType as string | undefined,
      status: fv.status as number | undefined,
      isDefault: fv.isDefault as number | undefined,
      keyword: fv.keyword as string | undefined,
      page: params.page ? Number(params.page) : undefined,
      pageSize: params.pageSize ? Number(params.pageSize) : undefined,
    }) as Promise<ListResponse<AlarmDeviceTemplateEntity>>;
  },
  get(id: string | number) {
    return alarmDeviceTemplateClient.GetDeviceTemplate({ id: Number(id) }) as Promise<AlarmDeviceTemplateEntity>;
  },
  create(data: Partial<AlarmDeviceTemplateEntity>) {
    return alarmDeviceTemplateClient.CreateDeviceTemplate({ data: data as never }) as Promise<unknown>;
  },
  update(id: string | number, data: Partial<AlarmDeviceTemplateEntity>) {
    return alarmDeviceTemplateClient.UpdateDeviceTemplate({ id: Number(id), data: data as never }) as Promise<unknown>;
  },
  delete(id: string | number) {
    return alarmDeviceTemplateClient.DeleteDeviceTemplate({ id: Number(id) }) as Promise<unknown>;
  },
  listItems(templateId: string | number, opts: PagingRequest & { formValues?: Record<string, unknown> } = {}) {
    const params = buildQueryParams(opts.formValues, opts);
    const fv = opts.formValues ?? {};
    return alarmDeviceTemplateItemClient.ListDeviceTemplateItems({
      templateId: Number(templateId),
      metricType: fv.metricType as string | undefined,
      status: fv.status as number | undefined,
      keyword: fv.keyword as string | undefined,
      page: params.page ? Number(params.page) : undefined,
      pageSize: params.pageSize ? Number(params.pageSize) : undefined,
    }) as Promise<ListResponse<AlarmDeviceTemplateItemEntity>>;
  },
  getItem(id: string | number) {
    return alarmDeviceTemplateItemClient.GetDeviceTemplateItem({
      id: Number(id),
    }) as Promise<AlarmDeviceTemplateItemEntity>;
  },
  createItem(data: Partial<AlarmDeviceTemplateItemEntity>) {
    return alarmDeviceTemplateItemClient.CreateDeviceTemplateItem({ data: data as never }) as Promise<unknown>;
  },
  updateItem(id: string | number, data: Partial<AlarmDeviceTemplateItemEntity>) {
    return alarmDeviceTemplateItemClient.UpdateDeviceTemplateItem({
      id: Number(id),
      data: data as never,
    }) as Promise<unknown>;
