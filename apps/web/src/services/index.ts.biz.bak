  startTime?: string;
  recoverTime?: string;
  duration?: number; // 秒
  thresholdValue?: string;
  actualValue?: string;
  detail?: string; // JSON
  status?: string; // active/recovered
  ackBy?: number;
  ackAt?: string;
  createTime?: string;
}

export const lineEventService = {
  list(
    opts: {
      page?: number;
      pageSize?: number;
      lineIds?: string;
      eventType?: string;
      severity?: string;
      status?: string;
      startTime?: string;
      endTime?: string;
    } = {},
  ) {
    return lineMonitorClient.ListEvents({
      page: opts.page ?? 1,
      pageSize: opts.pageSize ?? 10,
      lineIds: opts.lineIds || undefined,
      eventType: opts.eventType || undefined,
      severity: opts.severity || undefined,
      status: opts.status || undefined,
      startTime: opts.startTime || undefined,
      endTime: opts.endTime || undefined,
    }) as Promise<ListResponse<LineEventEntity>>;
  },
  ack(id: string | number) {
    return lineMonitorClient.AckEvent({ id: Number(id) }) as Promise<unknown>;
  },
};

// ---- 线路统计（日/周/月聚合 + 多线路对比 + 带宽 Top N；详设 §1.7/§2.11）----
export interface LineStatisticEntity {
  lineId?: number;
  statDate?: string; // daily=当日；weekly=周起始日；monthly=月起始日
  availability?: number; // %
  outageCount?: number;
  outageDuration?: number; // 秒
  avgDelay?: number;
  maxDelay?: number;
  avgPacketLossRate?: number;
  avgBandwidthUsage?: number;
  maxBandwidthUsage?: number;
  avgQualityScore?: number;
}

export interface LineComparisonItemEntity extends Omit<LineStatisticEntity, 'statDate'> {
  lineName?: string;
  statDays?: number; // 区间内有统计数据的天数
}

export interface BandwidthTopItemEntity {
  lineId?: number;
  lineName?: string;
  bandwidth?: number; // 线路带宽 Mbps
  avgBandwidthUsage?: number;
  maxBandwidthUsage?: number;
  statDays?: number;
}

export const lineStatisticsService = {
  // 单线路周期统计（period=daily/weekly/monthly）
  statistics(lineId: string | number, opts: { period?: string; startTime?: string; endTime?: string } = {}) {
    return lineMonitorClient.GetLineStatistics({
      id: Number(lineId),
      period: opts.period || 'daily',
      startTime: opts.startTime || undefined,
      endTime: opts.endTime || undefined,
    }) as Promise<{ lineId?: number; period?: string; items?: LineStatisticEntity[] }>;
  },
  // 多线路区间汇总对比（lineIds 逗号分隔）
  comparison(opts: { lineIds: string; startTime?: string; endTime?: string }) {
    return lineMonitorClient.GetLineComparison({
      lineIds: opts.lineIds,
      startTime: opts.startTime || undefined,
      endTime: opts.endTime || undefined,
    }) as Promise<{ items?: LineComparisonItemEntity[] }>;
  },
  // 带宽使用 Top N（orderBy=avg/max）
  bandwidthTop(opts: { startTime?: string; endTime?: string; limit?: number; orderBy?: string } = {}) {
    return lineMonitorClient.GetBandwidthTop({
      startTime: opts.startTime || undefined,
      endTime: opts.endTime || undefined,
      limit: opts.limit ?? 10,
      orderBy: opts.orderBy || 'avg',
    }) as Promise<{ items?: BandwidthTopItemEntity[] }>;
  },
};

// ===================== 局域网发现（08-linemonitor 发现域） =====================

// ---- 发现网段 ----
export interface DiscoveryScanWindowData {
  start?: string; // HH:MM
  end?: string;
}

export interface DiscoverySegmentEntity {
  id?: number;
  name?: string;
  cidr?: string;
  gateway?: string;
  coreDeviceId?: number;
  coreDeviceName?: string;
  protocolBindingId?: number;
  scanMethod?: string; // auto/arp/icmp/syn
  cronExpr?: string;
  rateLimit?: number; // pps
  excludeIps?: string[];
  scanWindow?: DiscoveryScanWindowData;
  synPorts?: number[];
  unknownOnlineRounds?: number;
  manageDeptId?: number;
  useDeptId?: number;
  managerId?: number;
  status?: number; // 1-启用 0-停用
  paused?: number; // 1-暂停周期扫描
  tenantId?: number;
  createTime?: string;
  updateTime?: string;
  // 列表行聚合（仅 ListSegments 响应填充）
  hostTotal?: number;
  hostOnline?: number;
  hostUnregistered?: number;
  hostOffline?: number;
  latestTaskStatus?: string; // pending/running/success/failed
  latestTaskAt?: string;
}

// ---- 扫描任务 ----
export interface DiscoveryTaskEntity {
  id?: number;
  segmentId?: number;
  segmentName?: string;
  triggerType?: string; // manual/cron
  status?: string; // pending/running/success/failed
  startedAt?: string;
  finishedAt?: string;
  totalAddrs?: number;
  onlineHosts?: number;
  newHosts?: number;
  processedAddrs?: number; // 已扫描目标数（运行中实时进度）
  errorMessage?: string;
  createTime?: string;
}

// ---- 发现主机（四态 linkStatus + ignored 正交） ----
export interface DiscoveryHostEntity {
  id?: number;
  segmentId?: number;
  ip?: string;
  mac?: string;
  macVendor?: string;
  hostname?: string;
  deviceType?: string; // server/workstation/switch/router/printer/vm/unknown
  deviceTypeConfidence?: string; // high/medium/low
  deviceTypeSource?: string; // snmp/banner/ttl/oui/port_heuristic
  osFamily?: string;
  osVersion?: string;
  osConfidence?: string;
  osSource?: string;
  openPorts?: string; // JSON 数组
  accessDeviceId?: number;
  accessDeviceName?: string;
  accessPort?: string;
  online?: number; // 1-在线 0-离线
  offlineRounds?: number;
  onlineRounds?: number;
  linkStatus?: string; // monitored_online/registered_unmonitored/unregistered/offline
  ignored?: number; // 1-已忽略（与四态正交）
  assetId?: number;
  deviceId?: number;
  firstSeenAt?: string;
  lastSeenAt?: string;
  createTime?: string;
  updateTime?: string;
}

// ---- 发现事件 ----
export interface DiscoveryEventEntity {
  id?: number;
  segmentId?: number;
  hostId?: number;
  eventType?: string; // new_host_discovered/unknown_host_online/host_offline
  severity?: string; // critical/warning/info
  ip?: string;
  mac?: string;
  assetId?: number;
  detail?: string; // JSON
  status?: string; // active/recovered
  startTime?: string;
  recoverTime?: string;
  ackBy?: number;
  ackAt?: string;
  createTime?: string;
}

// ---- 发现概览 ----
export interface DiscoveryOverviewData {
  segmentTotal?: number;
  hostTotal?: number;
  hostOnline?: number;
  unregistered?: number;
  registeredUnmonitored?: number;
  hostOffline?: number;
  monitoredOnline?: number;
  latestScanAt?: string;
}

// ---- 嗅探拓扑 ----
export interface DiscoveryTopologyNodeEntity {
  id?: string;
  nodeType?: string; // segment/device/host
  refId?: number;
  name?: string;
  ip?: string;
  online?: number;
  ignored?: number;
  linkStatus?: string;
  deviceType?: string;
  confidence?: string;
  // 网段云聚合（L0 segment 节点）
  hostTotal?: number;
  hostOnline?: number;
  unregistered?: number;
  hostOffline?: number;
  activeEvents?: number;
  scanning?: boolean;
}

export interface DiscoveryTopologyLinkEntity {
  id?: number;
  source?: string;
  target?: string;
  linkType?: string; // access/inter_switch/segment_core
  sourceProtocol?: string; // mac_table/lldp/cdp/arp/inferred
  switchPort?: string;
  /** 本端端口名（LLDP/CDP 实测，inter_switch 链路；P0 透出） */
  localPort?: string;
  /** 对端端口名（邻居通告端口描述） */
  peerPort?: string;
  vlanId?: number;
}

export interface DiscoveryTopologyViewData {
  level?: string; // L0/L1
  segmentId?: number;
  nodes?: DiscoveryTopologyNodeEntity[];
  links?: DiscoveryTopologyLinkEntity[];
}

// ---- 录入资产 ----
export interface RegisterAssetForm {
  name?: string;
  needsMonitor?: number; // 1-需要监控 0-不监控；缺省=1
  deviceCategoryId?: number;
  manageDeptId?: number;
  useDeptId?: number;
  managerId?: number;
  remark?: string;
}

export interface RegisterAssetResultEntity {
  hostId?: number;
  assetId?: number;
  assetCode?: string;
  name?: string;
  error?: string; // 非空即失败原因（批量录入逐台结果）
}

export const discoveryService = {
  // ---------- 概览 ----------
  overview() {
    return lineDiscoveryClient.GetOverview({}) as Promise<DiscoveryOverviewData>;
  },
  // ---------- 网段 ----------
  listSegments(opts: { page?: number; pageSize?: number; keyword?: string; status?: number } = {}) {
    return lineDiscoveryClient.ListSegments({
      page: opts.page ?? 1,
      pageSize: opts.pageSize ?? 10,
      keyword: opts.keyword || undefined,
      // 仓储约定 <0 不过滤（proto3 缺省 0 会被按 status=0 过滤）
      status: opts.status ?? -1,
    }) as Promise<ListResponse<DiscoverySegmentEntity>>;
  },
  getSegment(id: string | number) {
    return lineDiscoveryClient.GetSegment({ id: Number(id) }) as Promise<DiscoverySegmentEntity>;
  },
  createSegment(data: Partial<DiscoverySegmentEntity>) {
    return lineDiscoveryClient.CreateSegment({ data: data as never }) as Promise<DiscoverySegmentEntity>;
  },
  updateSegment(id: string | number, data: Partial<DiscoverySegmentEntity>) {
    return lineDiscoveryClient.UpdateSegment({ id: Number(id), data: data as never }) as Promise<unknown>;
  },
  deleteSegment(id: string | number) {
    return lineDiscoveryClient.DeleteSegment({ id: Number(id) }) as Promise<unknown>;
  },
  scanSegment(id: string | number) {
    return lineDiscoveryClient.ScanSegment({ id: Number(id) }) as Promise<DiscoveryTaskEntity>;
  },
  pauseSegment(id: string | number, paused: boolean) {
    return lineDiscoveryClient.PauseSegment({ id: Number(id), paused }) as Promise<unknown>;
  },
  scanAll() {
    return lineDiscoveryClient.ScanAllSegments({}) as Promise<{
      triggered?: DiscoveryTaskEntity[];
      skippedSegmentIds?: number[];
    }>;
  },
  // ---------- 扫描任务 ----------
  listTasks(segmentId: string | number, opts: { page?: number; pageSize?: number } = {}) {
    return lineDiscoveryClient.ListTasks({
      segmentId: Number(segmentId),
      page: opts.page ?? 1,
      pageSize: opts.pageSize ?? 10,
    }) as Promise<ListResponse<DiscoveryTaskEntity>>;
  },
  // ---------- 主机 ----------
  listHosts(
    opts: {
      segmentId?: number;
      keyword?: string;
      linkStatus?: string;
      online?: number;
      ignored?: number;
      page?: number;
      pageSize?: number;
      // 服务端排序白名单：ip/hostname/last_seen_at
      orderBy?: string;
      orderDesc?: boolean;
    } = {},
  ) {
    return lineDiscoveryClient.ListHosts({
      segmentId: opts.segmentId || undefined,
      keyword: opts.keyword || undefined,
      linkStatus: opts.linkStatus || undefined,
      // 仓储约定 <0 不过滤；0/1 精确过滤
      online: opts.online ?? -1,
      ignored: opts.ignored ?? 0,
      page: opts.page ?? 1,
      pageSize: opts.pageSize ?? 10,
      orderBy: opts.orderBy || undefined,
      orderDesc: opts.orderDesc || undefined,
    }) as Promise<ListResponse<DiscoveryHostEntity>>;
  },
  getHost(id: string | number) {
    return lineDiscoveryClient.GetHost({ id: Number(id) }) as Promise<DiscoveryHostEntity>;
  },
  ignoreHost(id: string | number, ignored: boolean) {
    return lineDiscoveryClient.IgnoreHost({ id: Number(id), ignored }) as Promise<unknown>;
  },
  // 一键录入资产（已录入返回 409）
  registerAsset(id: string | number, data: RegisterAssetForm) {
    return lineDiscoveryClient.RegisterAsset({
      id: Number(id),
      name: data.name || undefined,
      needsMonitor: data.needsMonitor,
      deviceCategoryId: data.deviceCategoryId || undefined,
      manageDeptId: data.manageDeptId || undefined,
      useDeptId: data.useDeptId || undefined,
      managerId: data.managerId || undefined,
      remark: data.remark || undefined,
    }) as Promise<RegisterAssetResultEntity>;
  },
  // 批量录入（共用一份表单缺省值，逐台执行，单台失败不中断）
  registerAssets(hostIds: number[], data: RegisterAssetForm) {
    return lineDiscoveryClient.RegisterAssets({
      hostIds,
      needsMonitor: data.needsMonitor,
      deviceCategoryId: data.deviceCategoryId || undefined,
      manageDeptId: data.manageDeptId || undefined,
      useDeptId: data.useDeptId || undefined,
      managerId: data.managerId || undefined,
      remark: data.remark || undefined,
    }) as Promise<{ items?: RegisterAssetResultEntity[] }>;
  },
  // ---------- 拓扑（segmentId=0/缺省 L0；>0 L1） ----------
  topology(segmentId?: number) {
    return lineDiscoveryClient.GetTopology({ segmentId: segmentId || undefined }) as Promise<DiscoveryTopologyViewData>;
  },
  // ---------- 事件 ----------
  listEvents(
    opts: {
      segmentId?: number;
      hostId?: number;
      eventType?: string;
      severity?: string;
      status?: string;
      page?: number;
      pageSize?: number;
    } = {},
  ) {
    return lineDiscoveryClient.ListEvents({
      segmentId: opts.segmentId || undefined,
      hostId: opts.hostId || undefined,
      eventType: opts.eventType || undefined,
      severity: opts.severity || undefined,
      status: opts.status || undefined,
      page: opts.page ?? 1,
      pageSize: opts.pageSize ?? 10,
    }) as Promise<ListResponse<DiscoveryEventEntity>>;
  },
  ackEvent(id: string | number) {
    return lineDiscoveryClient.AckEvent({ id: Number(id) }) as Promise<unknown>;
  },
};

// ===================== 交换机连线盘点（31-连线盘点 P0） =====================

// 盘点目标交换机（device_ext_switch + 启用 SNMP 绑定）
export type SwitchInventoryTarget = InventoryTarget;
// 单交换机端口级盘点结果（含端口行/端点/裁决/台账占用标注）
export type SwitchInventoryResult = InventorySwitchResponse;

// ---- 盘点草稿与对账（31 P2：inventory_drafts / inventory_reconcile_runs）----

// 单条待确认连线草稿（确认即 dc_cables 台账；忽略后同端点不再重复生成）
export interface InventoryDraftEntity {
  id?: number;
  switchDeviceId?: number;
  switchAssetId?: number;
  switchName?: string;
  switchPort?: string;
  assetId?: number;
  assetName?: string;
  mac?: string;
  ip?: string;
  vlanId?: number;
  source?: string; // scan / reconcile
  protocol?: string; // mac_table / arp / lldp
  confidence?: string; // high / medium
  seenAt?: string; // RFC3339
}

// 一次对账运行记录（每日调度/手动触发共用；ghost 告警发布与恢复计数）
export interface InventoryReconcileRunEntity {
  id?: number;
  runAt?: string; // RFC3339
  trigger?: string; // schedule / manual
  matched?: number;
  missing?: number;
  ghost?: number;
  draftsCreated?: number;
  alarmsPublished?: number;
  recoveredPublished?: number;
  ghostSkippedStale?: boolean;
  durationMs?: number;
}

export const inventoryService = {
  // 可盘点交换机清单（名称/IP 模糊过滤；数据权限行级过滤）
  listTargets(keyword?: string) {
    return lineInventoryClient.ListTargets({ keyword: keyword || undefined }) as Promise<{
      items?: SwitchInventoryTarget[];
      total?: number;
    }>;
  },
  // 执行单交换机端口级盘点（SNMP walk 10~30s；protocol 缺省 snmp，P1 支持 ssh）
  inventorySwitch(deviceId: string | number, protocol?: string) {
    return lineInventoryClient.InventorySwitch({
      deviceId: Number(deviceId),
      protocol: protocol || undefined,
    }) as Promise<SwitchInventoryResult>;
  },
  // ---- 31-连线盘点 P2：盘点草稿与每日对账 ----
  // 草稿清单（status 缺省 pending；all 不过滤）
  listDrafts(status?: string, page = 1, pageSize = 50) {
    return lineInventoryClient.ListDrafts({
      status: status || undefined,
      page,
      pageSize,
    }) as Promise<{ items?: InventoryDraftEntity[]; total?: number }>;
  },
  // 待确认草稿计数（「N 条待确认连线」角标）
  countPendingDrafts() {
    return lineInventoryClient.CountPendingDrafts({}) as Promise<{ count?: number }>;
  },
  // 确认草稿为已录入（前端先经 admin dc/cables:batch-create 写台账，成功后调用；幂等仅 pending 生效）
  confirmDrafts(ids: number[]) {
    return lineInventoryClient.ConfirmDrafts({ ids }) as Promise<unknown>;
  },
  // 忽略草稿（dismissed 后同端点不再重复生成）
  dismissDrafts(ids: number[]) {
    return lineInventoryClient.DismissDrafts({ ids }) as Promise<unknown>;
  },
  // 对账运行记录分页（每日调度 + 手动触发）
  listReconcileRuns(page = 1, pageSize = 20) {
    return lineInventoryClient.ListReconcileRuns({ page, pageSize }) as Promise<{
      items?: InventoryReconcileRunEntity[];
      total?: number;
    }>;
  },
  // 手动触发一次全量对账（执行中返回 409）
  triggerReconcile() {
    return lineInventoryClient.TriggerReconcile({}) as Promise<{ run?: InventoryReconcileRunEntity }>;
  },
};

// ===================== 流量分析 / 路由监控 / 配置备份（08-linemonitor P3，详设 §2.12-§2.14） =====================

// ---- 流量分析（NetFlow/sFlow/IPFIX）----
export interface FlowProtocolDistItemEntity {
  protocol?: string; // tcp/udp/icmp/other
  bytes?: number;
  packets?: number;
  percent?: number; // 字节数占比（%）
}

export interface FlowTopItemEntity {
  key?: string; // host=主机 IP；conversation="src -> dst"；port=服务名（HTTPS/SSH…，未知端口为 "port N"）
  srcIp?: string;
  dstIp?: string;
  port?: number; // by=port 时的目的端口
  service?: string; // by=port 时的服务名
  bytes?: number;
  packets?: number;
  percent?: number;
  // 富化字段（by=host 时回显）：scope=IP 范围分类；geo=公网归属地；marks=命中标记 blacklist/watchlist
  scope?: string;
  geo?: string;
  marks?: string[];
}

export interface FlowTrendPointEntity {
  time?: string;
  bytes?: number;
  packets?: number;
}

export interface FlowAnomalyEntity {
  id?: number;
  time?: string;
  anomalyType?: string; // traffic_spike
  severity?: string; // warning/critical
  srcIp?: string;
  description?: string;
  bytes?: number;
  baselineBytes?: number;
}

// 流量概览汇总（概览卡片数据源；峰值桶字节配 bucket 换算峰值速率；prev* 等长前窗总量供环比）
export interface FlowSummaryEntity {
  totalBytes?: number;
  totalPackets?: number;
  activeHosts?: number; // 去重主机数（源 ∪ 目的）
  activeConversations?: number; // 去重会话对数
  topHostIp?: string; // 头号主机（字节最高）
  topHostBytes?: number;
  peakBucketBytes?: number; // 单时间桶峰值字节
  bucket?: string; // 峰值桶粒度（minute/hour/day，与趋势同规则）
  exporters?: string[]; // 窗内有数据的导出器 IP（去重，供筛选下拉）
  prevTotalBytes?: number; // 等长前窗总字节（环比）
  prevTotalPackets?: number; // 等长前窗总包数（环比）
}

// 原始流量记录（采集器解析落库 flow_data；service 为目的端口服务名识别；
// *_scope/*_geo/marks 为查询期富化字段——scope=IP 范围分类 internal/public/multicast/reserved，
// geo=公网 IP 归属地文本（内网/未知为空），marks=源或目的命中标记并集 blacklist/watchlist）
export interface FlowRecordEntity {
  time?: string;
  exporterIp?: string;
  protocol?: string; // tcp/udp/icmp/other
  srcIp?: string;
  dstIp?: string;
  srcPort?: number;
  dstPort?: number;
  bytes?: number;
  packets?: number;
  flows?: number;
  service?: string; // 目的端口服务名（HTTP/DNS/...，无端口为空）
  srcScope?: string;
  dstScope?: string;
  srcGeo?: string;
  dstGeo?: string;
  marks?: string[];
}

// ---- 流量安全对象（Sniffnet 借鉴：IP 黑名单命中告警 + 关注主机自定义阈值）----
// IP 黑名单条目（落库 flow_blacklist；enabled=false 不参与检测但保留配置）
export interface FlowBlacklistItemEntity {
  id?: number;
  cidr?: string; // 单 IP 或 CIDR
  label?: string;
  enabled?: boolean;
  createdAt?: string;
  updatedAt?: string;
}

// 关注主机条目（落库 flow_watch_host；byte_threshold 单位字节/分钟，0=仅展示标记不告警）
export interface FlowWatchHostItemEntity {
  id?: number;
  ip?: string;
  label?: string;
  byteThreshold?: number;
  enabled?: boolean;
  createdAt?: string;
  updatedAt?: string;
}

export const flowService = {
  // 协议分布（hostIp 非空按"源=该主机 或 目的=该主机"过滤——主机下钻用）
  protocolDist(opts: { startTime?: string; endTime?: string; exporterIp?: string; hostIp?: string } = {}) {
    return lineFlowClient.GetFlowProtocolDist({
      startTime: opts.startTime || undefined,
      endTime: opts.endTime || undefined,
      exporterIp: opts.exporterIp || undefined,
      hostIp: opts.hostIp || undefined,
      direction: undefined,
    }) as Promise<{ items?: FlowProtocolDistItemEntity[]; totalBytes?: number; totalPackets?: number }>;
  },
  // Top N（by=host/conversation/port；hostIp 仅对 conversation/port 生效）
  top(
    opts: {
      startTime?: string;
      endTime?: string;
      exporterIp?: string;
      by?: string;
      limit?: number;
      hostIp?: string;
    } = {},
  ) {
    return lineFlowClient.GetFlowTop({
      startTime: opts.startTime || undefined,
      endTime: opts.endTime || undefined,
      exporterIp: opts.exporterIp || undefined,
      by: opts.by || 'host',
      limit: opts.limit ?? 10,
      hostIp: opts.hostIp || undefined,
    }) as Promise<{ items?: FlowTopItemEntity[]; totalBytes?: number }>;
  },
  // 流量趋势（桶粒度按窗口自动：≤2h minute、≤7d hour、否则 day；hostIp 下钻过滤；
  // direction=in/out 配合 hostIp 拆分下/上行）
  trend(opts: { startTime?: string; endTime?: string; exporterIp?: string; hostIp?: string; direction?: string } = {}) {
    return lineFlowClient.GetFlowTrend({
      startTime: opts.startTime || undefined,
      endTime: opts.endTime || undefined,
      exporterIp: opts.exporterIp || undefined,
      hostIp: opts.hostIp || undefined,
      direction: opts.direction || undefined,
    }) as Promise<{ items?: FlowTrendPointEntity[]; bucket?: string }>;
  },
  // 异常流量记录（滑窗基线突增，时间倒序分页；severity 可选 warning/critical）
  anomalies(
    opts: {
      startTime?: string;
      endTime?: string;
      page?: number;
      pageSize?: number;
      severity?: string;
    } = {},
  ) {
    return lineFlowClient.GetFlowAnomalies({
      startTime: opts.startTime || undefined,
      endTime: opts.endTime || undefined,
      page: opts.page ?? 1,
      pageSize: opts.pageSize ?? 10,
      severity: opts.severity || undefined,
    }) as Promise<ListResponse<FlowAnomalyEntity>>;
  },
  // 流量概览汇总（总量/活跃主机/活跃会话/头号主机/峰值桶字节 + prev* 等长前窗环比）
  summary(opts: { startTime?: string; endTime?: string; exporterIp?: string; hostIp?: string } = {}) {
    return lineFlowClient.GetFlowSummary({
      startTime: opts.startTime || undefined,
      endTime: opts.endTime || undefined,
      exporterIp: opts.exporterIp || undefined,
      hostIp: opts.hostIp || undefined,
      direction: undefined,
    }) as Promise<FlowSummaryEntity>;
  },
  // 原始流量记录分页浏览（时间倒序；hostIp/protocol/port 可选过滤；port 匹配源或目的端口）
  listRecords(
    opts: {
      startTime?: string;
      endTime?: string;
      exporterIp?: string;
      hostIp?: string;
      protocol?: string;
      port?: number;
      page?: number;
      pageSize?: number;
    } = {},
  ) {
    return lineFlowClient.ListFlowRecords({
      startTime: opts.startTime || undefined,
      endTime: opts.endTime || undefined,
      exporterIp: opts.exporterIp || undefined,
      hostIp: opts.hostIp || undefined,
      protocol: opts.protocol || undefined,
      port: opts.port || undefined,
      page: opts.page ?? 1,
      pageSize: opts.pageSize ?? 10,
    }) as Promise<{ items?: FlowRecordEntity[]; total?: number }>;
  },

  // ---- 流量安全对象（黑名单/关注主机管理；检测由采集器每分钟窗口执行，命中走 line.events → monitoralarm）----
  // IP 黑名单分页清单（keyword 模糊 cidr/label）
  listBlacklist(opts: { keyword?: string; page?: number; pageSize?: number } = {}) {
    return lineFlowClient.ListFlowBlacklist({
      keyword: opts.keyword || undefined,
      page: opts.page ?? 1,
      pageSize: opts.pageSize ?? 10,
    }) as Promise<{ items?: FlowBlacklistItemEntity[]; total?: number }>;
  },
  // 批量创建黑名单条目（cidr 支持单 IP 或 CIDR；返回 created/skipped 计数）
  createBlacklist(entries: { cidr: string; label?: string }[]) {
    return lineFlowClient.CreateFlowBlacklist({
      entries: entries.map((e) => ({ cidr: e.cidr, label: e.label || '' })),
    }) as Promise<{ created?: number; skipped?: number }>;
  },
  // 更新黑名单条目（label/enabled）
  updateBlacklist(id: number, opts: { label?: string; enabled?: boolean }) {
    return lineFlowClient.UpdateFlowBlacklist({
      id,
      label: opts.label,
      enabled: opts.enabled,
    }) as Promise<unknown>;
  },
  // 删除黑名单条目
  deleteBlacklist(id: number) {
    return lineFlowClient.DeleteFlowBlacklist({ id }) as Promise<unknown>;
  },
  // 关注主机分页清单（keyword 模糊 ip/label）
  listWatchHosts(opts: { keyword?: string; page?: number; pageSize?: number } = {}) {
    return lineFlowClient.ListFlowWatchHosts({
      keyword: opts.keyword || undefined,
      page: opts.page ?? 1,
      pageSize: opts.pageSize ?? 10,
    }) as Promise<{ items?: FlowWatchHostItemEntity[]; total?: number }>;
  },
  // 批量创建关注主机（byteThreshold 单位字节/分钟；返回 created/skipped 计数）
  createWatchHosts(entries: { ip: string; label?: string; byteThreshold?: number }[]) {
    return lineFlowClient.CreateFlowWatchHost({
      entries: entries.map((e) => ({ ip: e.ip, label: e.label || '', byteThreshold: e.byteThreshold ?? 0 })),
    }) as Promise<{ created?: number; skipped?: number }>;
  },
  // 更新关注主机（label/byteThreshold/enabled）
  updateWatchHost(id: number, opts: { label?: string; byteThreshold?: number; enabled?: boolean }) {
    return lineFlowClient.UpdateFlowWatchHost({
      id,
      label: opts.label,
      byteThreshold: opts.byteThreshold,
      enabled: opts.enabled,
    }) as Promise<unknown>;
  },
  // 删除关注主机
  deleteWatchHost(id: number) {
    return lineFlowClient.DeleteFlowWatchHost({ id }) as Promise<unknown>;
  },
};

// ---- 抓包分析（服务端 PCAP/PCAPNG，P1）----
export interface PcapJobEntity {
  id?: number;
  fileName?: string;
  fileSize?: number;
  status?: string; // pending|running|done|failed
  errorMessage?: string;
  createdAt?: string;
  finishedAt?: string;
  report?: PcapReportEntity;
}

export interface PcapReportEntity {
  summary?: {
    packetCount?: number;
    byteCount?: number;
    durationSec?: number;
    linkType?: string;
    truncated?: boolean;
    analyzedPackets?: number;
    captureFormat?: string;
  };
  protocolDist?: Array<{ protocol?: string; packets?: number; bytes?: number; percent?: number }>;
  topConversations?: Array<{
    srcIp?: string;
    dstIp?: string;
    protocol?: string;
    packets?: number;
    bytes?: number;
  }>;
  dnsQueries?: Array<{ query?: string; count?: number; nxdomain?: number }>;
  httpRequests?: Array<{ method?: string; host?: string; path?: string; count?: number }>;
  tcpAnomalies?: { synUnanswered?: number; rstCount?: number; retransmitEstimate?: number };
  topPorts?: Array<{ port?: number; service?: string; packets?: number; bytes?: number }>;
  securityFindings?: Array<{
    rule?: string;
    severity?: string;
    title?: string;
    detail?: string;
    evidence?: string;
  }>;
  briefing?: {
    overview?: string;
    metrics?: string;
    hypotheses?: string;
    risk?: string;
    suggestions?: string;
    text?: string;
  };
  samplePackets?: PcapPacketSample[];
}

export interface PcapPacketSample {
  no?: number;
  timeSec?: number;
  srcIp?: string;
  dstIp?: string;
  protocol?: string;
  length?: number;
  info?: string;
}

export interface PcapNetworkInterface {
  name?: string;
  hardwareAddr?: string;
  up?: boolean;
  loopback?: boolean;
  addrs?: string[];
}

export const pcapService = {
  upload(file: File) {
    const fd = new FormData();
    fd.append('file', file);
    return request.post<{ id?: number; status?: string }>('/api/v1/monitor/linemonitor/pcap/jobs', fd, {
      headers: { 'Content-Type': 'multipart/form-data' },
      timeout: 180000,
    });
  },
  list(opts: { page?: number; pageSize?: number } = {}) {
    return request.get<{ items?: PcapJobEntity[]; total?: number }>('/api/v1/monitor/linemonitor/pcap/jobs', {
      params: { page: opts.page || 1, pageSize: opts.pageSize || 20 },
    });
  },
  get(id: number) {
    return request.get<PcapJobEntity>(`/api/v1/monitor/linemonitor/pcap/jobs/${id}`);
  },
  remove(id: number) {
    return request.delete(`/api/v1/monitor/linemonitor/pcap/jobs/${id}`);
  },
  listInterfaces() {
    return request.get<{
      items?: PcapNetworkInterface[];
      captureBackend?: string;
      captureHint?: string;
    }>('/api/v1/monitor/linemonitor/pcap/interfaces');
  },
  startCapture(body: { iface: string; durationSec?: number; bpf?: string; maxPackets?: number }) {
    return request.post<{ id?: number; status?: string }>('/api/v1/monitor/linemonitor/pcap/captures', body, {
      timeout: 180000,
    });
  },
  async download(id: number) {
    const blob = await request.get<Blob>(`/api/v1/monitor/linemonitor/pcap/jobs/${id}/file`, {
      responseType: 'blob',
      timeout: 180000,
    });
    const url = URL.createObjectURL(blob as unknown as Blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `pcap-job-${id}.pcap`;
    a.click();
    URL.revokeObjectURL(url);
  },
};

// ---- 路由监控（BGP/OSPF SNMP 轮询）----
export interface RoutePeerEntity {
  id?: number;
  deviceId?: number;
  deviceName?: string;
  protocol?: string; // bgp/ospf
  peerIp?: string;
  peerAs?: number;
  state?: string; // BGP: Established/Idle/...；OSPF: Full/Init/...
  healthy?: number; // 1=健康 0=异常
  uptimeSec?: number;
  prefixCount?: number;
  lastSeen?: string;
  inUpdates?: number; // bgpPeerInUpdates 累计入向 UPDATE（OSPF 恒 0）
  outUpdates?: number; // bgpPeerOutUpdates 累计出向 UPDATE（OSPF 恒 0）
  fsmTransitions?: number; // bgpPeerFsmEstablishedTransitions 累计 FSM 迁移（OSPF 恒 0）
}

export interface RouteEventEntity {
  id?: number;
  deviceId?: number;
  deviceName?: string;
  protocol?: string;
  routerIp?: string;
  peerIp?: string;
  previousState?: string;
  currentState?: string;
  severity?: string;
  time?: string;
}

// 路由监控概览（首屏单调用聚合）
export interface RouteOverviewEntity {
  peersTotal?: number;
  peersHealthy?: number;
  peersDown?: number;
  bgpCount?: number;
  ospfCount?: number;
  events24h?: number;
  criticalEvents24h?: number;
  flapPeerCount?: number;
  stateDistribution?: { state?: string; count?: number }[];
  eventTrend24h?: { time?: string; total?: number; critical?: number }[];
  flapPeers?: {
    deviceId?: number;
    deviceName?: string;
    protocol?: string;
    peerIp?: string;
    transitions?: number;
    currentState?: string;
  }[];
  engine?: {
    enabled?: boolean;
    pollIntervalSec?: number;
    targetCount?: number;
    lastPollAt?: string;
    polling?: boolean;
    nextPollAt?: string; // 预计下一轮周期轮询时间（lastPollAt+interval；禁用/未跑过为空）
  };
  // ── 快照新鲜度（页面据此显性降级，禁止把陈旧快照当"当前状态"展示）──
  snapshotFresh?: boolean; // 各目标最近成功轮询均未超阈值
  snapshotStaleTargets?: number; // 陈旧目标数（含从未轮询成功）
  observedTargets?: number; // 轮询成功且观测到邻居的目标数
  emptyTargets?: number; // 轮询成功但无邻居的目标数
}

// 轮询目标设备（含邻居覆盖统计）
export interface RoutePollTargetEntity {
  deviceId?: number;
  deviceName?: string;
  ip?: string;
  peerCount?: number;
  healthyCount?: number;
  lastPollAt?: string; // 最近一轮成功轮询时刻（与 last_seen 解耦）
  /** none=从未轮询成功 / empty=轮询成功但无邻居 / observed=已观测到邻居 */
  pollDegree?: 'none' | 'empty' | 'observed';
  /** 最近成功轮询距今超阈值（或从未成功）→ 快照不可信 */
  stale?: boolean;
  /** 快照中陈旧邻居行数（消失残留） */
  stalePeerCount?: number;
}

export const routeService = {
  // 邻居清单（deviceId=0 全部；protocol/state/keyword 空=全部；healthy 缺省=全部（1=仅健康 0=仅异常）；分页）
  listPeers(
    opts: {
      deviceId?: number;
      protocol?: string;
      state?: string;
      healthy?: number;
      keyword?: string;
      page?: number;
      pageSize?: number;
    } = {},
  ) {
    return lineRouteClient.ListRoutePeers({
      deviceId: opts.deviceId || undefined,
      protocol: opts.protocol || undefined,
      state: opts.state || undefined,
      // protoc-gen-typescript-http 生成 `if (request.healthy)` truthy 检查会丢 healthy=0；
      // 查询参数在线路上本就是字符串，传 '0' 规避生成器缺陷（后端绑定 optional int32 行为一致）
      healthy: opts.healthy === 0 ? ('0' as unknown as number) : opts.healthy,
      keyword: opts.keyword || undefined,
      page: opts.page ?? 1,
      pageSize: opts.pageSize ?? 10,
    }) as Promise<ListResponse<RoutePeerEntity>>;
  },
  // 路由事件（route_change 状态迁移，时间倒序分页；peerIp 精确过滤；startTime/endTime ISO 时间范围）
  listEvents(
    opts: {
      deviceId?: number;
      protocol?: string;
      severity?: string;
      peerIp?: string;
      startTime?: string;
      endTime?: string;
      page?: number;
      pageSize?: number;
    } = {},
  ) {
    return lineRouteClient.ListRouteEvents({
      deviceId: opts.deviceId || undefined,
      protocol: opts.protocol || undefined,
      severity: opts.severity || undefined,
      peerIp: opts.peerIp || undefined,
      startTime: opts.startTime || undefined,
      endTime: opts.endTime || undefined,
      page: opts.page ?? 1,
      pageSize: opts.pageSize ?? 10,
    }) as Promise<ListResponse<RouteEventEntity>>;
  },
  // 手动触发单设备轮询（同步执行一轮，返回最新邻居快照）
  pollDevice(deviceId: string | number) {
    return lineRouteClient.PollRouteDevice({ id: Number(deviceId) }) as Promise<ListResponse<RoutePeerEntity>>;
  },
  // 路由监控概览（KPI + 状态分布 + 24h 事件趋势 + 抖动邻居 TOP + 引擎状态）
  getOverview() {
    return lineRouteClient.GetRouteOverview({}) as Promise<RouteOverviewEntity>;
  },
  // 轮询目标设备清单（含邻居统计与最近轮询时间）
  listPollTargets() {
    return lineRouteClient.ListRoutePollTargets({}) as Promise<ListResponse<RoutePollTargetEntity>>;
  },
  // 批量触发全部目标设备轮询（异步，返回触发设备数）
  pollAllDevices() {
    return lineRouteClient.PollAllRouteDevices({}) as Promise<{ triggered?: number }>;
  },
};

// ---- 配置备份（SSH show running-config + 变更检测）----
export interface ConfigBackupEntity {
  id?: number;
  deviceId?: number;
  deviceName?: string;
  version?: number; // 设备内自增版本号
  filePath?: string;
  sha256?: string;
  sizeBytes?: number;
  trigger?: string; // manual/schedule
  changed?: number; // 1=相对上一版本有变更
  diffPath?: string;
  backupAt?: string;
  createTime?: string;
}

export interface ConfigBackupDiffEntity {
  id?: number;
  againstId?: number;
  changed?: number;
  diff?: string; // unified diff 文本
  addedLines?: number;
  removedLines?: number;
}

// 备份计划行（每设备一条；L1 起兼作设备备份策略行：cronExpr 空=仅自动保存策略）
export interface ConfigBackupScheduleEntity {
  id?: number;
  deviceId?: number;
  deviceName?: string;
  cronExpr?: string;
  retainCount?: number;
  enabled?: number; // 1=启用 0=停用（cronExpr 为空时必须为 0）
  autoSave?: number; // 变更后自动保存开关：1 开 / 0 关
  saveCommand?: string; // 设备级保存命令覆盖；空=按厂商模板表
  nextRunAt?: string;
  createdAt?: string;
  updatedAt?: string;
}

// 备份概览统计卡
export interface ConfigBackupOverviewEntity {
  deviceCount?: number; // 纳管设备数（有启用 SSH 绑定）
  scheduleCount?: number; // 启用计划数
  backupCount24h?: number; // 近24h备份次数
  failedCount24h?: number; // 近24h失败次数
  changedDeviceCount7d?: number; // 近7天有变更设备数
  totalBackupCount?: number; // 备份总版本数
}

// 设备维度备份状态行
export interface ConfigBackupDeviceStatusEntity {
  deviceId?: number;
  deviceName?: string;
  latestVersion?: number;
  latestBackupAt?: string;
  latestChanged?: number;
  hasSchedule?: number; // 1=有计划
  scheduleEnabled?: number; // 1=计划启用
  cronExpr?: string;
  nextRunAt?: string;
  lastJobStatus?: string; // success/failed
  lastJobError?: string;
  lastJobAt?: string;
  changedCount7d?: number; // 近7天变更版本数
  backupCount?: number; // 备份版本总数
  autoSave?: number; // 自动保存策略开关（0/1；无策略行=0）
}

// 备份执行流水行（手动/定时/批量全路径留痕）
export interface ConfigBackupJobEntity {
  id?: number;
  deviceId?: number;
  deviceName?: string;
  trigger?: string; // manual/schedule/batch
  status?: string; // success/failed
  error?: string;
  durationMs?: number;
  backupId?: number;
  changed?: number;
  startedAt?: string;
  finishedAt?: string;
}

// 批量备份单台结果
export interface ConfigBatchBackupResultEntity {
  deviceId?: number;
  deviceName?: string;
  success?: boolean;
  error?: string;
  backupId?: number;
  version?: number;
}

export const configBackupService = {
  // 手动触发单设备备份（同步执行）
  backup(deviceId: string | number) {
    return lineConfigBackupClient.BackupDeviceConfig({ id: Number(deviceId) }) as Promise<ConfigBackupEntity>;
  },
  // 备份记录分页（deviceId=0 全部；changed=-1 全部/0 无变更/1 有变更）
  list(
    opts: {
      deviceId?: number;
      changed?: number;
      page?: number;
      pageSize?: number;
    } = {},
  ) {
    return lineConfigBackupClient.ListConfigBackups({
      deviceId: opts.deviceId || undefined,
      changed: opts.changed ?? -1,
      page: opts.page ?? 1,
      pageSize: opts.pageSize ?? 10,
    }) as Promise<ListResponse<ConfigBackupEntity>>;
  },
  // 备份元数据（内容经 download 获取）
  get(id: string | number) {
    return lineConfigBackupClient.GetConfigBackup({ id: Number(id) }) as Promise<ConfigBackupEntity>;
  },
  // 版本对比（againstId=0 对比同设备上一版本）
  diff(id: string | number, againstId?: number) {
    return lineConfigBackupClient.GetConfigBackupDiff({
      id: Number(id),
      againstId: againstId || undefined,
    }) as Promise<ConfigBackupDiffEntity>;
  },
  // 配置内容下载 URL（自定义 HTTP handler，流式 + Range）
  downloadUrl(id: string | number) {
    return `/api/v1/monitor/linemonitor/config-backups/${Number(id)}/download`;
  },
  // 批量手动备份（deviceIds 空=全部有启用 SSH 绑定的设备；并发限流逐台执行）
  batchBackup(deviceIds?: number[]) {
    return lineConfigBackupClient.BatchBackupDeviceConfigs({
      deviceIds: deviceIds && deviceIds.length > 0 ? deviceIds : undefined,
    }) as Promise<{
      items?: ConfigBatchBackupResultEntity[];
      successCount?: number;
      failedCount?: number;
    }>;
  },
  // 备份计划清单（keyword 模糊设备名；响应含调度器总开关状态）
  listSchedules(
    opts: {
      page?: number;
      pageSize?: number;
      keyword?: string;
    } = {},
  ) {
    return lineConfigBackupClient.ListConfigBackupSchedules({
      page: opts.page ?? 1,
      pageSize: opts.pageSize ?? 10,
      keyword: opts.keyword || undefined,
    }) as Promise<ListResponse<ConfigBackupScheduleEntity> & { schedulerEnabled?: boolean }>;
  },
  // 创建/更新设备备份计划（按 deviceId upsert；保存即热更新调度器；cronExpr 空=仅自动保存策略）
  upsertSchedule(data: {
    deviceId: number;
    cronExpr: string;
    retainCount: number;
    enabled: number;
    autoSave?: number;
    saveCommand?: string;
  }) {
    return lineConfigBackupClient.UpsertConfigBackupSchedule({
      deviceId: data.deviceId,
      cronExpr: data.cronExpr,
      retainCount: data.retainCount,
      enabled: data.enabled,
      autoSave: data.autoSave ?? 0,
      saveCommand: data.saveCommand || undefined,
    }) as Promise<ConfigBackupScheduleEntity>;
  },
  // 删除设备备份计划（同步摘除调度器 cron 条目）
  deleteSchedule(deviceId: string | number) {
    return lineConfigBackupClient.DeleteConfigBackupSchedule({ deviceId: Number(deviceId) }) as Promise<unknown>;
  },
  // 备份概览统计（纳管设备数/计划数/近24h备份与失败/近7天变更设备数/总版本数）
  overview() {
    return lineConfigBackupClient.GetConfigBackupOverview({}) as Promise<ConfigBackupOverviewEntity>;
  },
  // 设备维度备份状态分页（仅含有启用 SSH 绑定的设备；keyword 模糊设备名）
  deviceStatus(
    opts: {
      page?: number;
      pageSize?: number;
      keyword?: string;
    } = {},
  ) {
    return lineConfigBackupClient.ListConfigBackupDeviceStatus({
      page: opts.page ?? 1,
      pageSize: opts.pageSize ?? 10,
      keyword: opts.keyword || undefined,
    }) as Promise<ListResponse<ConfigBackupDeviceStatusEntity>>;
  },
  // 备份执行流水分页（deviceId=0 全部；status 空=全部/success/failed）
  listJobs(
    opts: {
      deviceId?: number;
      status?: string;
      page?: number;
      pageSize?: number;
    } = {},
  ) {
    return lineConfigBackupClient.ListConfigBackupJobs({
      deviceId: opts.deviceId || undefined,
      status: opts.status || undefined,
      page: opts.page ?? 1,
      pageSize: opts.pageSize ?? 10,
    }) as Promise<ListResponse<ConfigBackupJobEntity>>;
  },
};

// ===================== 天气雷达（18-radar 子服务，port 8150） =====================

// ---- 雷达站点 ----
export interface RadarSiteEntity {
  id?: number;
  siteCode?: string;
  name?: string;
  longitude?: number;
  latitude?: number;
  altitude?: number;
  radarModel?: string; // SA/SB/SC/CB/CC/CCJ/CD/XPOL
  band?: string; // S/C/X
  status?: string; // ON/OFF
  createTime?: string;
  updateTime?: string;
  remark?: string;
}

export const radarSiteService = {
  list(opts: { page?: number; pageSize?: number; keyword?: string; status?: string } = {}) {
    return radarClient.ListSites({
      page: opts.page ?? 1,
      pageSize: opts.pageSize ?? 10,
      keyword: opts.keyword || undefined,
      status: opts.status || undefined,
    }) as Promise<ListResponse<RadarSiteEntity>>;
  },
  get(id: string | number) {
    return radarClient.GetSite({ id: Number(id) }) as Promise<RadarSiteEntity>;
  },
  create(data: Partial<RadarSiteEntity>) {
    return radarClient.CreateSite({ data: data as never }) as Promise<unknown>;
  },
  update(id: string | number, data: Partial<RadarSiteEntity>) {
    return radarClient.UpdateSite({ id: Number(id), data: data as never }) as Promise<unknown>;
  },
  delete(id: string | number) {
    return radarClient.DeleteSite({ id: Number(id) }) as Promise<unknown>;
  },
};

// ---- 雷达数据文件（扫描时次） ----
export interface RadarFileEntity {
  id?: number;
  siteId?: number;
  siteCode?: string;
  scope?: string; // SINGLE/MESH/CMAMESH
  dataKind?: string; // BASE/PRODUCT_IMAGE
  productType?: string;
  dataFormat?: string; // STD/SAB/CACB/AR2V/GIF/PNG...
  scanTime?: string;
  prodTime?: string;
  area?: string;
  height?: string;
  filePath?: string;
  fileSize?: number;
  rawFileName?: string;
  source?: string; // THIRD_API/MANUAL
  receiveTime?: string;
  createTime?: string;
  remark?: string;
}

// ---- 雷达基数据解码预览（P8-6 web 验证工具，radar 服务手写路由）----
export interface RadarSweepDecodeInfo {
  index: number; // 层序号（0 基，ppi.png?sweep= 同序号）
  elevNum: number;
  elevDeg: number;
  nyquistVel: number;
  rayCount: number;
  gateCountMin: number;
  gateCountMax: number;
  gateSizeMeters: number;
  firstGateMeters: number;
  minDbz: number;
  maxDbz: number;
  hasData: boolean;
  missingRatio: number; // [0,1]
  azimuthGapMax: number; // 度
}

export interface RadarDecodeInfo {
  fileId: number;
  rawFileName?: string;
  dataFormat?: string; // DB 登记格式
  format: string; // 解码器实判格式
  siteCode?: string;
  longitude?: number;
  latitude?: number;
  altitude?: number;
  radarModel?: string;
  band?: string;
  vcpMode: number;
  beginTime?: string;
  endTime?: string;
  sweepCount: number;
  totalRays: number;
  totalGates: number;
  hasData: boolean;
  minDbz: number;
  maxDbz: number;
  maxRangeKm: number;
  sweeps: RadarSweepDecodeInfo[];
}

export const radarScanService = {
  list(
    opts: {
      page?: number;
      pageSize?: number;
      siteCode?: string;
      productType?: string;
      dataKind?: string;
      scope?: string;
      startTime?: string;
      endTime?: string;
    } = {},
  ) {
    return radarClient.ListScans({
      page: opts.page ?? 1,
      pageSize: opts.pageSize ?? 10,
      siteCode: opts.siteCode || undefined,
      productType: opts.productType || undefined,
      dataKind: opts.dataKind || undefined,
      scope: opts.scope || undefined,
      startTime: opts.startTime || undefined,
      endTime: opts.endTime || undefined,
    }) as Promise<ListResponse<RadarFileEntity>>;
  },
  get(id: string | number) {
    return radarClient.GetScan({ id: Number(id) }) as Promise<RadarFileEntity>;
  },
  // 手动上传登记（multipart/form-data 手写路由，元数据走 query 参数）
  upload(
    file: File,
    meta: {
      siteCode?: string;
      productType: string;
      dataKind?: string;
      scope?: string;
      scanTime?: string;
      area?: string;
      height?: string;
    },
  ) {
    const fd = new FormData();
    fd.append('file', file);
    const params: Record<string, string> = { productType: meta.productType };
    if (meta.siteCode) params.siteCode = meta.siteCode;
    if (meta.dataKind) params.dataKind = meta.dataKind;
    if (meta.scope) params.scope = meta.scope;
    if (meta.scanTime) params.scanTime = meta.scanTime;
    if (meta.area) params.area = meta.area;
    if (meta.height) params.height = meta.height;
    return request.post<RadarFileEntity>('/api/v1/monitor/radar/scans:upload', fd, {
      params,
      headers: { 'Content-Type': 'multipart/form-data' },
      timeout: 300000,
    });
  },
  // 下载数据文件（复用 admin GET /api/v1/monitor/file:download，决策 D6）
  download(entity: RadarFileEntity) {
    if (!entity.filePath) return Promise.resolve();
    const name = entity.rawFileName || `radar_${entity.id}`;
    return request
      .get<Blob>('/api/v1/monitor/file:download', {
        params: { path: entity.filePath },
        responseType: 'blob',
        timeout: 300000,
      })
      .then((blob) => downloadBlob(blob, name));
  },
  // 获取数据文件 Blob（行内图片预览用；同一 file:download 接口，Authorization 头由 request 拦截器注入）
  fetchBlob(entity: RadarFileEntity): Promise<Blob> {
    return request.get<Blob>('/api/v1/monitor/file:download', {
      params: { path: entity.filePath },
      responseType: 'blob',
      timeout: 300000,
    });
  },
  // 基数据解码摘要（P8-6；仅 BASE 可用，非 BASE/解码失败返回 400 错误信息）
  decodeInfo(id: string | number): Promise<RadarDecodeInfo> {
    return request.get(`/api/v1/monitor/radar/scans/${id}/decode-info`, { timeout: 300000 });
  },
  // 基数据 PPI 光栅化图（Blob，Authorization 头由 request 拦截器注入）
  fetchPpiBlob(id: string | number, sweep: number, size = 900): Promise<Blob> {
    return request.get<Blob>(`/api/v1/monitor/radar/scans/${id}/ppi.png`, {
      params: { sweep, size },
      responseType: 'blob',
      timeout: 300000,
    });
  },
  // 单站立体回波体数据（RVOL 二进制：JSON 头 + float32 ENU 网格；综合业务平台 radarVolume 图层）
  fetchVolume(id: string | number): Promise<ArrayBuffer> {
    return request.get<ArrayBuffer>(`/api/v1/monitor/radar/scans/${id}/volume.bin`, {
      responseType: 'arraybuffer',
      timeout: 300000,
    });
  },
};

// ---- 三期接口拉取任务 ----
