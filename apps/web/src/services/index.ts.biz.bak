  // 健康分排行（升序=最不省心在前；窗口默认近 7d；categoryCode 按设备分类过滤，24-08 开发文档 §2.3）
  healthScores(
    opts: { startDate?: string; endDate?: string; limit?: number; minScore?: number; categoryCode?: string } = {},
  ) {
    return analysisClient.GetHealthScores({
      startDate: opts.startDate || undefined,
      endDate: opts.endDate || undefined,
      limit: opts.limit,
      minScore: opts.minScore,
      categoryCode: opts.categoryCode || undefined,
    }) as Promise<{ items?: HealthScoreEntity[]; total?: number }>;
  },
  // 设备运行总榜（24-20 W1）：服务端一次聚合 + 排序分页；默认 health asc=最差在前；
  // sort 白名单 health|availability|alarm|offline|mttr|collect（非白名单服务端 400，前端 utils 已先行归一）。
  deviceOpsRanking(
    opts: {
      startDate?: string;
      endDate?: string;
      categoryCode?: string;
      sort?: string;
      order?: string;
      page?: number;
      pageSize?: number;
      withDeduct?: boolean;
      /** 资产台账位置精确过滤（F2 机房切片接榜；与行 location 同源台账口径） */
      location?: string;
    } = {},
  ) {
    return analysisClient.GetDeviceOpsRanking({
      startDate: opts.startDate || undefined,
      endDate: opts.endDate || undefined,
      categoryCode: opts.categoryCode || undefined,
      sort: opts.sort || undefined,
      order: opts.order || undefined,
      page: opts.page,
      pageSize: opts.pageSize,
      withDeduct: opts.withDeduct,
      location: opts.location || undefined,
    }) as Promise<DeviceOpsRankingResponseEntity>;
  },
  // 运维洞察评估（5min Redis 缓存；refresh=true 强制重算）
  insights(opts: { domains?: string; start?: string; end?: string; levels?: string; refresh?: boolean } = {}) {
    return analysisClient.GetInsights({
      domains: opts.domains || undefined,
      start: opts.start || undefined,
      end: opts.end || undefined,
      levels: opts.levels || undefined,
      refresh: opts.refresh,
    }) as Promise<OpsInsightsEntity>;
  },
};

