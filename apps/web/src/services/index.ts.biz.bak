      request.get<VirtEnvelope<{ items: VirtmanVmPlatformEntity[]; total: number }>>(`${VIRT_BASE}/vm/platforms`),
    );
  },
  createPlatform(data: VirtmanVmPlatformInput) {
    return unwrapVirt(request.post<VirtEnvelope<VirtmanVmPlatformEntity>>(`${VIRT_BASE}/vm/platforms`, data));
  },
  updatePlatform(id: number, data: VirtmanVmPlatformInput) {
    return unwrapVirt(request.put<VirtEnvelope<unknown>>(`${VIRT_BASE}/vm/platforms/${id}`, data));
  },
  removePlatform(id: number) {
    return unwrapVirt(request.delete<VirtEnvelope<unknown>>(`${VIRT_BASE}/vm/platforms/${id}`));
  },
  testPlatform(id: number) {
    return request.post<VirtEnvelope<VirtmanVmPlatformTestResult>>(`${VIRT_BASE}/vm/platforms/${id}/test`, {}, {
      skipErrorNotify: true,
    } as Record<string, unknown>);
  },
  syncPlatform(id: number) {
    return unwrapVirt(request.post<VirtEnvelope<unknown>>(`${VIRT_BASE}/vm/platforms/${id}/sync`));
  },
  // ---- VM 实例 ----
  listVms(params?: { platform_id?: number; power_state?: string; keyword?: string; page?: number; pageSize?: number }) {
    return unwrapVirt(
      request.get<VirtEnvelope<{ items: VirtmanVmEntity[]; total: number }>>(`${VIRT_BASE}/vm/instances`, { params }),
    );
  },
  createVm(data: VirtmanVmCreateInput) {
    return unwrapVirt(
      request.post<VirtEnvelope<{ vm: VirtmanVmEntity; task: VirtmanVmTaskAccepted }>>(
        `${VIRT_BASE}/vm/instances`,
        data,
      ),
    );
  },
  updateVm(id: number, data: VirtmanVmUpdateInput) {
    return unwrapVirt(request.put<VirtEnvelope<unknown>>(`${VIRT_BASE}/vm/instances/${id}`, data));
  },
  removeVm(id: number, force = false) {
    return unwrapVirt(
      request.delete<VirtEnvelope<unknown>>(`${VIRT_BASE}/vm/instances/${id}`, {
        params: force ? { force: 'true' } : undefined,
      }),
    );
  },
  power(id: number, action: 'power-on' | 'power-off' | 'reboot') {
    return unwrapVirt(request.post<VirtEnvelope<VirtmanVmTaskAccepted>>(`${VIRT_BASE}/vm/instances/${id}/${action}`));
  },
  cloneVm(id: number, newName: string, powerOnAfter = false) {
    return unwrapVirt(
      request.post<VirtEnvelope<VirtmanVmTaskAccepted>>(`${VIRT_BASE}/vm/instances/${id}/clone`, {
        new_name: newName,
        power_on_after: powerOnAfter,
      }),
    );
  },
  vmMetrics(id: number, opts?: { silent?: boolean }) {
    // silent：卡片墙后台轮询用，失败不弹全局错误通知（平台不可达时避免刷屏）
    return unwrapVirt(
      request.get<VirtEnvelope<VirtmanVmMetrics>>(`${VIRT_BASE}/vm/instances/${id}/metrics`, {
        ...(opts?.silent ? { skipErrorNotify: true } : {}),
      } as Record<string, unknown>),
    );
  },
  // ---- 快照 ----
  listSnapshots(vmId: number) {
    return unwrapVirt(
      request.get<VirtEnvelope<{ items: VirtmanVmSnapshotEntity[]; total: number }>>(
        `${VIRT_BASE}/vm/instances/${vmId}/snapshots`,
      ),
    );
  },
  createSnapshot(vmId: number, name: string, description = '', withMemory = false) {
    return unwrapVirt(
      request.post<VirtEnvelope<VirtmanVmTaskAccepted>>(`${VIRT_BASE}/vm/instances/${vmId}/snapshots`, {
        name,
        description,
        with_memory: withMemory,
      }),
    );
  },
  removeSnapshot(vmId: number, snapId: number) {
    return unwrapVirt(request.delete<VirtEnvelope<unknown>>(`${VIRT_BASE}/vm/instances/${vmId}/snapshots/${snapId}`));
  },
  revertSnapshot(vmId: number, snapId: number) {
    return unwrapVirt(
      request.post<VirtEnvelope<VirtmanVmTaskAccepted>>(`${VIRT_BASE}/vm/instances/${vmId}/snapshots/${snapId}/revert`),
    );
  },
};

