export const aiopsConfigTemplateService = {
  list(opts: { page?: number; pageSize?: number; templateType?: string; keyword?: string } = {}) {
    return aiopsConfigTemplateClient.ListConfigTemplates({
      page: opts.page ?? 1,
      pageSize: opts.pageSize ?? 10,
      templateType: opts.templateType || undefined,
      keyword: opts.keyword || undefined,
    }) as Promise<AiopsListResponse<AiopsConfigTemplateEntity>>;
  },
  get: (id: number) => aiopsConfigTemplateClient.GetConfigTemplate({ id }) as Promise<AiopsConfigTemplateEntity>,
  create: (data: Partial<CreateConfigTemplateRequest>) =>
    aiopsConfigTemplateClient.CreateConfigTemplate({
      ...data,
      variables: data.variables ?? [],
      tags: data.tags ?? [],
    } as CreateConfigTemplateRequest) as Promise<AiopsConfigTemplateEntity>,
  update(id: number, data: Partial<Omit<UpdateConfigTemplateRequest, 'id' | 'updateMask'>>) {
    const updateMask = buildUpdateMask(data as Record<string, unknown>);
    return aiopsConfigTemplateClient.UpdateConfigTemplate({
      id,
      ...data,
      updateMask,
    } as UpdateConfigTemplateRequest) as Promise<AiopsConfigTemplateEntity>;
  },
  delete: (id: number) => aiopsConfigTemplateClient.DeleteConfigTemplate({ id }) as Promise<unknown>,
  // 渲染预览（替换 {{variable}} 占位符；缺失必填变量后端 131071 报错）
  render: (templateId: number, variables: Record<string, string>) =>
    aiopsConfigTemplateClient.RenderConfigTemplate({ templateId, variables }) as Promise<{ rendered?: string }>,
};

// ---- MCP 服务（§2.3.7）----
export const aiopsMcpService = {
  overview: () => aiopsMcpClient.GetMcpOverview({}) as Promise<AiopsMcpOverview>,
  listTools(
    opts: {
      page?: number;
      pageSize?: number;
      domain?: string;
      riskLevel?: string;
      isEnabled?: number;
      keyword?: string;
    } = {},
  ) {
    return aiopsMcpClient.ListMcpTools({
      page: opts.page ?? 1,
      pageSize: opts.pageSize ?? 10,
      domain: opts.domain || undefined,
      riskLevel: opts.riskLevel || undefined,
      isEnabled: opts.isEnabled,
      keyword: opts.keyword || undefined,
    }) as Promise<AiopsListResponse<AiopsMcpToolEntity>>;
  },
  getTool: (name: string) => aiopsMcpClient.GetMcpTool({ name }) as Promise<AiopsMcpToolEntity>,
  // 工具治理调整（风险等级/启停/放行策略；工具以 name 为标识）
  updateToolPolicy(name: string, data: { riskLevel?: string; isEnabled?: number; grantPolicy?: string }) {
    return aiopsMcpClient.UpdateMcpToolPolicy({
      name,
      riskLevel: data.riskLevel || undefined,
      isEnabled: data.isEnabled,
      grantPolicy: data.grantPolicy || undefined,
    }) as Promise<AiopsMcpToolEntity>;
  },
  // 工具调用测试（经安全层；风险拦截 error 非空且 success=false）
  callTool: (toolName: string, params: Record<string, unknown>) =>
    aiopsMcpClient.CallMcpTool({ toolName, params, callerType: 'user' }) as Promise<{
      success?: boolean;
      result?: Record<string, unknown>;
      durationMs?: number;
      error?: string;
    }>,
  callHistory: (opts: { page?: number; pageSize?: number; toolName?: string; status?: string } = {}) =>
    aiopsMcpClient.ListMcpCallHistory({
      page: opts.page ?? 1,
      pageSize: opts.pageSize ?? 20,
      toolName: opts.toolName || undefined,
      status: opts.status || undefined,
    }) as Promise<AiopsListResponse<AiopsMcpCallRecord>>,
  listClients(opts: { page?: number; pageSize?: number; status?: string; keyword?: string } = {}) {
    return aiopsMcpClient.ListMcpClients({
      page: opts.page ?? 1,
      pageSize: opts.pageSize ?? 10,
      status: opts.status || undefined,
      keyword: opts.keyword || undefined,
    }) as Promise<AiopsListResponse<AiopsMcpClientEntity>>;
  },
  // 签发调用方（secret 仅创建时完整返回一次）
  createClient: (data: Partial<CreateMcpClientRequest>) =>
    aiopsMcpClient.CreateMcpClient({ ...data, toolScope: data.toolScope ?? [] } as CreateMcpClientRequest) as Promise<{
      client?: AiopsMcpClientEntity;
      secret?: string;
    }>,
  updateClient(id: number, data: Partial<Omit<UpdateMcpClientRequest, 'id' | 'updateMask'>>) {
    const updateMask = buildUpdateMask(data as Record<string, unknown>);
    return aiopsMcpClient.UpdateMcpClient({
      id,
      ...data,
      updateMask,
    } as UpdateMcpClientRequest) as Promise<AiopsMcpClientEntity>;
  },
  revokeClient: (id: number) => aiopsMcpClient.RevokeMcpClient({ id }) as Promise<AiopsMcpClientEntity>,
};

// ---- AI 根因分析（§2.3.11）----
export const aiopsRcaService = {
  list(opts: { page?: number; pageSize?: number; status?: string; keyword?: string; assetId?: number } = {}) {
    return aiopsRcaClient.ListRcaRecords({
      page: opts.page ?? 1,
      pageSize: opts.pageSize ?? 12,
      status: opts.status || undefined,
      keyword: opts.keyword || undefined,
      assetId: opts.assetId || undefined,
    }) as Promise<AiopsListResponse<AiopsRcaRecordEntity>>;
  },
