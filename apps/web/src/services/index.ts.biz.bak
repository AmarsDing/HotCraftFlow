// ---- 统计分析（analysis 子服务）----
export interface DeviceStatisticItemEntity {
  deviceId?: number;
  deviceName?: string;
  statDate?: string;
  statPeriod?: string;
  onlineDuration?: number;
  offlineDuration?: number;
  availability?: number;
  alarmTotal?: number;
  alarmInfoCount?: number;
  alarmWarningCount?: number;
  alarmCriticalCount?: number;
  alarmEmergencyCount?: number;
  avgRecoveryTime?: number;
  offlineCount?: number;
  restartCount?: number;
}

export interface TrendPointEntity {
  time?: string;
  value?: number;
}

export interface CompareSeriesEntity {
  label?: string;
  deviceId?: number;
  startTime?: string;
  endTime?: string;
  points?: TrendPointEntity[];
}

export const analysisStatsService = {
  deviceStatistics(
    opts: { deviceIds?: string; startDate?: string; endDate?: string; statPeriod?: string; categoryCode?: string } = {},
  ) {
    return analysisClient.GetDeviceStatistics({
      deviceIds: opts.deviceIds || undefined,
      startDate: opts.startDate || undefined,
      endDate: opts.endDate || undefined,
      statPeriod: opts.statPeriod || undefined,
      categoryCode: opts.categoryCode || undefined,
    }) as Promise<{ items?: DeviceStatisticItemEntity[]; total?: number }>;
  },
  metricTrend(opts: {
    deviceId: number;
    metricKey: string;
    startTime: string;
    endTime: string;
    granularity?: string;
    maxPoints?: number;
  }) {
    return analysisClient.GetMetricTrend({
      deviceId: opts.deviceId,
      metricKey: opts.metricKey,
      startTime: opts.startTime,
      endTime: opts.endTime,
      granularity: opts.granularity || undefined,
      maxPoints: opts.maxPoints,
    }) as Promise<{ deviceId?: number; metricKey?: string; granularity?: string; points?: TrendPointEntity[] }>;
  },
  // mode=device：多设备同指标对比；mode=time：同设备多时间段对比（ranges 上限 4 段）
  compareMetrics(opts: {
    mode: string;
    deviceIds?: string;
    deviceId?: number;
    metricKey: string;
    startTime?: string;
    endTime?: string;
    ranges?: { label?: string; startTime?: string; endTime?: string }[];
    granularity?: string;
    maxPoints?: number;
  }) {
    return analysisClient.CompareMetrics({
      mode: opts.mode,
      deviceIds: opts.deviceIds || undefined,
      deviceId: opts.deviceId,
      metricKey: opts.metricKey,
      startTime: opts.startTime,
      endTime: opts.endTime,
      ranges: (opts.ranges || []) as never,
      granularity: opts.granularity || undefined,
      maxPoints: opts.maxPoints,
    }) as Promise<{ metricKey?: string; granularity?: string; items?: CompareSeriesEntity[] }>;
  },
  // 设备分类日聚合查询（24-09 P1a；全域口径不做权限域过滤，聚合表无明细级权限可筛）
  deviceCategoryStats(opts: { startDate?: string; endDate?: string; categoryCodes?: string } = {}) {
    return analysisClient.GetDeviceCategoryStats({
      startDate: opts.startDate || undefined,
      endDate: opts.endDate || undefined,
      categoryCodes: opts.categoryCodes || undefined,
    }) as Promise<{ items?: DeviceCategoryStatItemEntity[] }>;
  },
  // 域周期统计（24-10 P2a）：period=day|week|month|year，周/月/年由后端对日聚合行再聚合
  domainStats(opts: { period?: string; startDate?: string; endDate?: string; domainCodes?: string } = {}) {
    return analysisClient.GetDomainStats({
      period: opts.period || undefined,
      startDate: opts.startDate || undefined,
      endDate: opts.endDate || undefined,
      domainCodes: opts.domainCodes || undefined,
    }) as Promise<DomainStatsResponseEntity>;
  },
  // 指标字典（24-10 P2a）：available=false 表示口径未落地，前端展示"建设中"不伪造数值
  metricCatalog(opts: { domainCode?: string } = {}) {
    return analysisClient.GetMetricCatalog({
      domainCode: opts.domainCode || undefined,
    }) as Promise<{ metrics?: MetricDefEntity[] }>;
  },
  /** S1 采集日成功率趋势（四层物化；自定义 HTTP） */
  collectionTrend(opts: { startDate: string; endDate: string; deviceIds?: string }) {
    const q = new URLSearchParams();
    q.set('startDate', opts.startDate);
    q.set('endDate', opts.endDate);
    if (opts.deviceIds) q.set('deviceIds', opts.deviceIds);
    return request.get(`/api/v1/monitor/analysis/statistics/collection-trend?${q.toString()}`) as Promise<{
      items?: { statDate?: string; successCount?: number; failCount?: number; successRate?: number }[];
    }>;
  },
  /** W1：S1 采集窗口汇总（KPI/协议/失败 Top；禁 quality.list 大页） */
  collectionSummary(opts: { startDate: string; endDate: string; deviceIds?: string }) {
    const q = new URLSearchParams();
    q.set('startDate', opts.startDate);
    q.set('endDate', opts.endDate);
    if (opts.deviceIds) q.set('deviceIds', opts.deviceIds);
    return request.get(`/api/v1/monitor/analysis/statistics/collection-summary?${q.toString()}`) as Promise<CollectionWindowSummaryEntity>;
  },
  /** R4 域专属槽（S1 有行则有值，否则 building） */
  domainSpecialty(opts: { domainCode: string; startDate: string; endDate: string }) {
    const q = new URLSearchParams();
    q.set('domainCode', opts.domainCode);
    q.set('startDate', opts.startDate);
    q.set('endDate', opts.endDate);
    return request.get(`/api/v1/monitor/analysis/statistics/domain-specialty?${q.toString()}`) as Promise<{
      domainCode?: string;
      startDate?: string;
      endDate?: string;
      slots?: SpecialtySlotEntity[];
    }>;
  },
};

export interface SpecialtySlotEntity {
  key?: string;
  available?: boolean;
  building?: boolean;
  value?: number;
  unit?: string;
  label?: string;
  hint?: string;
}

export interface CollectionWindowSummaryEntity {
  successCount?: number;
  failCount?: number;
  successRate?: number;
  p95LatencyMs?: number;
  deviceCount?: number;
  protocols?: { protocol?: string; successCount?: number; failCount?: number; successRate?: number }[];
  failTop?: { deviceId?: number; failCount?: number; successCount?: number }[];
}

/** E3 领导简报（四层物化） */
export const executiveBriefService = {
  get(opts: { period?: string; periodKey?: string } = {}) {
    const q = new URLSearchParams();
    if (opts.period) q.set('period', opts.period);
    if (opts.periodKey) q.set('periodKey', opts.periodKey);
    const qs = q.toString();
    return request.get(`/api/v1/monitor/analysis/executive-briefs${qs ? `?${qs}` : ''}`) as Promise<ExecutiveBriefEntity>;
  },
  generate(opts: { period?: string; periodKey?: string; refresh?: boolean } = {}) {
    return request.post('/api/v1/monitor/analysis/executive-briefs/generate', {
      period: opts.period || 'week',
      periodKey: opts.periodKey || '',
      refresh: !!opts.refresh,
    }) as Promise<ExecutiveBriefEntity>;
  },
};

export interface ExecutiveBriefEntity {
  id?: number;
  period?: string;
  periodKey?: string;
  title?: string;
  healthIndex?: number;
  summaryText?: string;
  domainConclusions?: { domain?: string; text?: string; level?: string; drillTo?: string }[];
  topRisks?: { title?: string; level?: string; evidence?: string; href?: string }[];
  suggestions?: { text?: string; href?: string }[];
  evidenceLinks?: { label?: string; href?: string }[];
  generatedAt?: string;
}

// ---- 设备分类日聚合（analysis 子服务，device_category_stats_daily；24-09 P1a）----
export interface WorstDeviceItemEntity {
  deviceId?: number;
  deviceName?: string;
  availability?: number;
}

export interface DeviceCategoryStatItemEntity {
  statDate?: string;
  categoryCode?: string;
  deviceTotal?: number;
  deviceActive?: number;
  deviceWithStats?: number; // 当日有统计行设备数：区分"无数据"与"0%"，0 时率/分均值不可消费
  availabilityAvg?: number;
  availabilityMin?: number;
  alarmTotal?: number;
  alarmInfoCount?: number;
  alarmWarningCount?: number;
  alarmCriticalCount?: number; // critical+emergency 合并
  alarmDeviceCount?: number;
  offlineCount?: number;
  mttrSeconds?: number;
  avgHealthScore?: number;
  worstDevices?: WorstDeviceItemEntity[];
}

// ---- 域周期统计与指标字典（analysis 子服务；24-10 P2a）----
export interface DomainStatItemEntity {
  domainCode?: string;
  deviceTotal?: number;
  deviceActive?: number;
  availabilityAvg?: number;
  availabilityMin?: number;
  avgHealthScore?: number;
  alarmTotal?: number;
  alarmCriticalCount?: number;
  offlineCount?: number;
  mttrSeconds?: number;
  availabilityDelta?: number; // 环比百分点（本窗-前窗）
  alarmDelta?: number; // 环比告警差值
  daysWithData?: number; // 窗口内有统计数据的天数：0=无数据（不返回该域）
