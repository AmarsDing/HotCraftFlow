      endPort: opts.endPort ?? undefined,
      timeoutMs: opts.timeoutMs ?? undefined,
    }) as Promise<PortScanResponse>;
  },
  // 本机网络信息（扫描范围示例动态化：opstools 所在主机非回环 IPv4 及网段，主出口排首位）
  getLocalNetworks: () => opstoolsDiscoveryClient.GetLocalNetworks({}) as Promise<GetLocalNetworksResponse>,
};

// ---- 在线诊断（网络测试工具箱融合方案 F2/F3/F9/F12）：Ping / 路由追踪 / 健康度 / DNS / SSL / MTU / 邻居探测 ----
