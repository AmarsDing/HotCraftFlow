// ---- 云图文件（GEOS 重投影后等经纬 PNG，bbox 随帧内嵌下发） ----
export interface SatelliteFileEntity {
  id?: number;
  sourceId?: number;
  sourceCode?: string;
  obsTime?: string;
  product?: string;
  dataFormat?: string;
  filePath?: string;
  fileSize?: number;
  rawFileName?: string;
  width?: number;
  height?: number;
  lonMin?: number;
  lonMax?: number;
  latMin?: number;
  latMax?: number;
  receiveTime?: string;
  /** 抠图派生文件相对路径（方案C：透明底云图；空=未处理，前端回退 filePath 原图） */
  cutoutPath?: string;
  /** 抠图文件大小（字节） */
  cutoutSize?: number;
  /** 云量采样网格 JSON 相对路径（picker 采样用） */
  gridPath?: string;
  createTime?: string;
}

/** 多源融合帧（拼接产物或单源降级回退） */
export interface SatelliteFusedFrameEntity {
  /** 帧文件记录（bbox 随帧内嵌；拼接产物登记于 FUSED_<规则> 虚拟源名下） */
  file?: SatelliteFileEntity;
  /** 参与本帧的源编码（拼接 2 个 / 单源降级 1 个） */
  memberSourceCodes?: string[];
  /** 命中融合规则名（east_asia/america） */
  fusionRule?: string;
  /** 是否像素级拼接产物（false=单源降级） */
  stitched?: boolean;
}

export const satelliteFileService = {
  list(
    opts: {
      page?: number;
      pageSize?: number;
      sourceCode?: string;
      product?: string;
      startTime?: string;
      endTime?: string;
    } = {},
  ) {
    return satelliteClient.ListFiles({
      page: opts.page ?? 1,
      pageSize: opts.pageSize ?? 10,
      sourceCode: opts.sourceCode || undefined,
      product: opts.product || undefined,
      startTime: opts.startTime || undefined,
      endTime: opts.endTime || undefined,
    }) as Promise<ListResponse<SatelliteFileEntity>>;
  },
  get(id: string | number) {
    return satelliteClient.GetFile({ id: Number(id) }) as Promise<SatelliteFileEntity>;
  },
  /** 按数据源编码取最新时次文件（前端实况入口） */
  latest(sourceCode: string, product?: string) {
    return satelliteClient.GetLatestFile({
      sourceCode,
      product: product || undefined,
    }) as Promise<SatelliteFileEntity>;
  },
  /** 贴地动画帧清单（obs_time 倒序取前 limit 帧，bbox 内嵌免查 areas） */
  listFrames(opts: { sourceCode?: string; product?: string; limit?: number } = {}) {
    return satelliteClient.ListFrames({
      sourceCode: opts.sourceCode || undefined,
      product: opts.product || undefined,
      limit: opts.limit ?? 12,
    }) as Promise<{ items?: SatelliteFileEntity[] }>;
  },
  /** 多源融合帧清单（按规则/bbox 选源，双源齐备时像素级羽化拼接，缺源自动单源降级） */
  listFusedFrames(
    opts: {
      fusionRule?: string;
      lonMin?: number;
      lonMax?: number;
      latMin?: number;
      latMax?: number;
      product?: string;
      limit?: number;
    } = {},
  ) {
    return satelliteClient.ListFusedFrames({
      fusionRule: opts.fusionRule || undefined,
      lonMin: opts.lonMin,
      lonMax: opts.lonMax,
      latMin: opts.latMin,
      latMax: opts.latMax,
      product: opts.product || undefined,
      limit: opts.limit ?? 12,
    }) as Promise<{ items?: SatelliteFusedFrameEntity[] }>;
  },
  // 获取云图 PNG Blob（复用 admin file:download，决策 D6；Authorization 由 request 拦截器注入）
  fetchBlob(entity: SatelliteFileEntity): Promise<Blob> {
    return request.get<Blob>('/api/v1/monitor/file:download', {
      params: { path: entity.filePath },
      responseType: 'blob',
      timeout: 300000,
    });
  },
  // 按存储相对路径拉取文件（方案C：cutoutPath/gridPath 派生文件）
  fetchByPath<T = Blob>(relPath: string, responseType: 'blob' | 'json' = 'blob'): Promise<T> {
    return request.get('/api/v1/monitor/file:download', {
      params: { path: relPath },
      responseType,
      timeout: 300000,
    }) as Promise<T>;
  },
  // 下载云图文件（管理页下载动作）
  download(entity: SatelliteFileEntity) {
    if (!entity.filePath) return Promise.resolve();
    const name = entity.rawFileName || `satellite_${entity.id}.png`;
    return request
      .get<Blob>('/api/v1/monitor/file:download', {
        params: { path: entity.filePath },
        responseType: 'blob',
        timeout: 300000,
      })
      .then((blob) => downloadBlob(blob, name));
  },
};

