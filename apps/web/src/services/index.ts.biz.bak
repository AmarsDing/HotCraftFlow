  },
  preview(
    id: string | number,
    sampleData?: Record<string, unknown>,
    // v2.3：内联模板字段——非空时后端优先使用，配合 id=0 支持新建态未保存的真实渲染预览
    inline?: { titleTemplate?: string; bodyTemplate?: string; ttsTemplate?: string; channelType?: string },
  ) {
    return noticeTemplateClient.PreviewTemplate({
      id: Number(id) || 0,
      sampleData,
      titleTemplate: inline?.titleTemplate,
      bodyTemplate: inline?.bodyTemplate,
      ttsTemplate: inline?.ttsTemplate,
      channelType: inline?.channelType,
    }) as Promise<{
      title?: string;
      body?: string;
      tts?: string;
    }>;
  },
};

