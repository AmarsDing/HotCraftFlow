// ===================== ops（12 系统运维备份恢复，Phase 5.9） =====================
const OPS_BASE = '/api/v1/monitor/ops';

export interface OpsBackupEntity {
  id?: number;
  file_name?: string;
  kind?: string; // database / files / config / logs（缺省按 database 处理）
  db_name?: string; // database：twinmonitor / twinmonitor_log；非 database：scope 标签（storage/config/logs）
  backup_format?: string; // dump / sql_gz（非 database 固定 tar.gz）
  file_size?: number;
  storage_type?: string;
  storage_path?: string;
  source?: string; // manual / upload / safety_snapshot / scheduled
  status?: string; // pending / running / success / failed / restoring / expired
  progress?: number;
  error_message?: string;
  restore_of_id?: number;
  restored_at?: string;
  retention_days?: number;
  checksum?: string;
  operator_id?: number;
  created_at?: string;
  updated_at?: string;
}

export interface OpsBackupConfig {
  retention_days?: number;
  retention_count?: number;
  upload_max_size_mb?: number;
}

export interface OpsBackupProgress {
  task_type?: string; // backup / restore
  stage?: string; // exporting / restoring / finished
  exported_bytes?: number;
  progress?: number;
  elapsed_seconds?: number;
  status?: string;
}

// 定时备份策略（执行产物写入备份记录，source=scheduled）
export interface OpsBackupSchedule {
  id?: number;
  name?: string;
  kind?: string; // database / files / config / logs（默认 database）
  targets?: string[]; // files 专用：存储桶名单，空=全部
  db_name?: string; // twinmonitor / twinmonitor_log
  backup_format?: string; // dump / sql_gz
  cron_spec?: string; // 5 字段标准 cron（分 时 日 月 周）
  enabled?: boolean;
  retention_days?: number;
  last_run_at?: string;
  last_status?: string; // pending / running / success / failed
  last_backup_id?: number;
  created_at?: string;
  updated_at?: string;
}

export interface OpsBackupScheduleInput {
  name?: string;
  kind?: string; // database / files / config / logs（默认 database）
  targets?: string[]; // files 专用：存储桶名单，空=全部
  db_name?: string;
  backup_format?: string;
  cron_spec?: string;
  enabled?: boolean;
  retention_days?: number;
}

// 文件/配置/日志恢复预览（GET /backups/{id}/restore-preview，仅非 database）
export interface OpsBackupRestorePreview {
  kind?: string;
  scope?: string; // storage / config / logs
  total_files?: number;
  new_files?: number;
  overwrite_files?: number;
  unchanged_files?: number;
  entries?: { path?: string; action?: string; size?: number }[]; // action: new / overwrite
  truncated?: boolean; // entries 仅含前 200 条
}

// 恢复演练记录（POST /backups/{id}/drill 发起，GET /backups/{id}/drills 查询历史）
export interface OpsBackupDrill {
  id?: number;
  backup_id?: number;
  kind?: string;
  db_name?: string;
  status?: string; // running / success / failed
  detail?: string;
  error_message?: string;
  duration_ms?: number;
  operator_id?: number;
  created_at?: string;
  updated_at?: string;
}

export interface OpsStorageCapacity {
  disk?: {
    path?: string;
    total_bytes?: number;
    free_bytes?: number;
    used_bytes?: number;
    used_percent?: number;
  };
  storage_total_bytes?: number;
  backups_bytes?: number;
  buckets?: { name?: string; bytes?: number }[];
  alert?: {
    state?: string; // normal / warning / critical
    warn_percent?: number;
    critical_percent?: number;
  };
  updated_at?: string;
}

export interface OpsDiskAlert {
  warn_percent?: number;
  critical_percent?: number;
  state?: string; // normal / warning / critical
  used_percent?: number;
}

export const opsBackupService = {
  list(
    opts: {
      page?: number;
      pageSize?: number;
      kind?: string;
      dbName?: string;
      status?: string;
      source?: string;
    } = {},
  ) {
    return unwrapVirt(
      request.get<VirtEnvelope<{ list: OpsBackupEntity[]; total: number }>>(`${OPS_BASE}/backups`, {
        params: {
          page: opts.page ?? 1,
          page_size: opts.pageSize ?? 10,
          kind: opts.kind || undefined,
          db_name: opts.dbName || undefined,
          status: opts.status || undefined,
          source: opts.source || undefined,
        },
      }),
    );
  },
  // 创建备份任务（异步执行，返回 {id,status} 后轮询 progress）
  // kind=database：{db_name,backup_format}；files：{targets}（空=全部桶）；config/logs：仅 kind
  create(payload: { kind?: string; db_name?: string; backup_format?: string; targets?: string[] }) {
    return unwrapVirt(request.post<VirtEnvelope<{ id: number; status: string }>>(`${OPS_BASE}/backups`, payload));
  },
  // 上传备份文件（multipart，字段 file + db_name）
  upload(dbName: string, file: File) {
    const form = new FormData();
    form.append('db_name', dbName);
    form.append('file', file);
    return unwrapVirt(
      request.post<VirtEnvelope<OpsBackupEntity>>(`${OPS_BASE}/backups/upload`, form, {
        headers: { 'Content-Type': 'multipart/form-data' },
        timeout: 600000,
      }),
    );
  },
  config() {
    return unwrapVirt(request.get<VirtEnvelope<OpsBackupConfig>>(`${OPS_BASE}/backups/config`));
  },
  progress(id: number) {
    return unwrapVirt(request.get<VirtEnvelope<OpsBackupProgress>>(`${OPS_BASE}/backups/${id}/progress`));
  },
  // 恢复（二次确认库名 + 操作密码头；恢复期间网关联动维护模式）
  restore(id: number, confirmDbName: string, operationPassword: string) {
    return unwrapVirt(
      request.post<VirtEnvelope<unknown>>(
        `${OPS_BASE}/backups/${id}/restore`,
        { confirm_db_name: confirmDbName },
        { headers: { 'X-Operation-Password': operationPassword } },
      ),
    );
  },
  // 恢复预览（仅非 database：文件/配置/日志，返回差异统计与明细）
  restorePreview(id: number) {
    return unwrapVirt(request.get<VirtEnvelope<OpsBackupRestorePreview>>(`${OPS_BASE}/backups/${id}/restore-preview`));
  },
  // 恢复演练（database=临时库恢复抽检；文件类=解压完整性校验）
  drill(id: number) {
    return unwrapVirt(request.post<VirtEnvelope<OpsBackupDrill>>(`${OPS_BASE}/backups/${id}/drill`));
  },
  listDrills(id: number) {
    return unwrapVirt(
      request.get<VirtEnvelope<{ list: OpsBackupDrill[]; total: number }>>(`${OPS_BASE}/backups/${id}/drills`),
    );
  },
  delete(id: number) {
    return unwrapVirt(request.delete<VirtEnvelope<unknown>>(`${OPS_BASE}/backups/${id}`));
  },
  // ---- 定时备份策略（schedules） ----
  listSchedules(opts: { page?: number; pageSize?: number; dbName?: string; enabled?: boolean } = {}) {
    return unwrapVirt(
      request.get<VirtEnvelope<{ list: OpsBackupSchedule[]; total: number }>>(`${OPS_BASE}/backups/schedules`, {
        params: {
          page: opts.page ?? 1,
          page_size: opts.pageSize ?? 10,
          db_name: opts.dbName || undefined,
          enabled: opts.enabled === undefined ? undefined : String(opts.enabled),
        },
      }),
    );
  },
  createSchedule(data: OpsBackupScheduleInput) {
    return unwrapVirt(request.post<VirtEnvelope<OpsBackupSchedule>>(`${OPS_BASE}/backups/schedules`, data));
  },
  updateSchedule(id: number, data: OpsBackupScheduleInput) {
    return unwrapVirt(request.put<VirtEnvelope<unknown>>(`${OPS_BASE}/backups/schedules/${id}`, data));
  },
  deleteSchedule(id: number) {
    return unwrapVirt(request.delete<VirtEnvelope<unknown>>(`${OPS_BASE}/backups/schedules/${id}`));
  },
  // 立即执行一次该策略（异步触发，产物为 source=scheduled 的备份记录）
  runSchedule(id: number) {
    return unwrapVirt(request.post<VirtEnvelope<unknown>>(`${OPS_BASE}/backups/schedules/${id}/run`));
  },
  // ---- 存储容量与磁盘告警阈值 ----
  capacity() {
    return unwrapVirt(request.get<VirtEnvelope<OpsStorageCapacity>>(`${OPS_BASE}/storage/capacity`));
  },
  diskAlert() {
    return unwrapVirt(request.get<VirtEnvelope<OpsDiskAlert>>(`${OPS_BASE}/storage/disk-alert`));
  },
  updateDiskAlert(data: { warn_percent?: number; critical_percent?: number }) {
    return unwrapVirt(request.put<VirtEnvelope<unknown>>(`${OPS_BASE}/storage/disk-alert`, data));
  },
  // 下载备份文件（流式响应，非信封）
  download(entity: OpsBackupEntity) {
    if (!entity.id) return Promise.resolve();
    return request
      .get<Blob>(`${OPS_BASE}/backups/${entity.id}/download`, { responseType: 'blob', timeout: 600000 })
      .then((blob) => downloadBlob(blob, entity.file_name || `backup_${entity.id}.dump`));
  },
};

export const knowledgeBaseService = {
  ...makeCrudServiceFromClient<KnowledgeBaseEntity>(knowledgeBaseClient),
  listCategories() {
    return knowledgeBaseClient.ListCategories({}) as Promise<{ items?: KnowledgeCategoryItem[] }>;
  },
  statistics() {
    return knowledgeBaseClient.Statistics({}) as Promise<KnowledgeBaseStatistics>;
  },
  recordView(id: string | number) {
    return knowledgeBaseClient.RecordView({ id: Number(id) }) as Promise<unknown>;
  },
  recordHelpful(id: string | number) {
    return knowledgeBaseClient.RecordHelpful({ id: Number(id) }) as Promise<unknown>;
  },
};

export const knowledgeTagService = makeListWriteServiceFromClient<KnowledgeTagEntity>(knowledgeTagClient);

// ===================== Remediation（14 自动修复与自愈，remediation 服务 HTTP:8110） =====================
// 实体类型直接复用 buf 生成的 proto 类型（全可选字段，camelCase 与 protojson 对齐）。
export type {
  RemediationPolicyEntity,
  RemediationExecutionEntity,
  RemediationAIRecordEntity,
  RemediationDashboardStats,
  RemediationTrendPoint,
  RemediationPolicyRankItem,
  RemediationSourceDistItem,
  RemediationMatchTestResultItem,
  AiScenarioEntity,
};

export interface RemediationListResponse<T> {
  items?: T[];
  total?: number;
}

export const remediationService = {
  // ---- 策略 ----
  listPolicies(
    opts: {
      page?: number;
      pageSize?: number;
      name?: string;
      status?: number;
      alertSource?: string;
      alertLevel?: string;
      executionMode?: string;
    } = {},
  ) {
    // 生成 client 对 falsy 值不拼 query，status=0（禁用）会被丢弃，此处走 axios 直传
    if (opts.status === 0) {
      return request.get<RemediationListResponse<RemediationPolicyEntity>>('/api/v1/monitor/remediation/policies', {
        params: {
          page: opts.page ?? 1,
          pageSize: opts.pageSize ?? 10,
          status: 0,
          name: opts.name || undefined,
          alertSource: opts.alertSource || undefined,
          alertLevel: opts.alertLevel || undefined,
          executionMode: opts.executionMode || undefined,
        },
      });
    }
    return remediationClient.ListPolicies({
      page: opts.page ?? 1,
      pageSize: opts.pageSize ?? 10,
      name: opts.name || undefined,
      status: opts.status,
      alertSource: opts.alertSource || undefined,
      alertLevel: opts.alertLevel || undefined,
      executionMode: opts.executionMode || undefined,
    }) as Promise<RemediationListResponse<RemediationPolicyEntity>>;
  },
  getPolicy: (id: number) => remediationClient.GetPolicy({ id }),
  createPolicy: (data: Partial<RemediationPolicyEntity>) =>
    remediationClient.CreatePolicy(data) as Promise<RemediationPolicyEntity>,
  // data 允许携带 null：null 是"显式置空"语义（buildUpdateMask 保留 null 路径，后端据 mask 清空可选字段）
  updatePolicy(id: number, data: Record<string, unknown>) {
    // update_mask 采用 proto JSON 约定（camelCase 逗号串），protojson 内部转为 snake 路径
    const updateMask = buildUpdateMask(data);
    return remediationClient.UpdatePolicy({
      id,
      ...data,
      updateMask,
    } as unknown as RemediationUpdatePolicyRequest) as Promise<RemediationPolicyEntity>;
  },
  deletePolicy: (id: number) => remediationClient.DeletePolicy({ id }) as Promise<unknown>,
  togglePolicy: (id: number, status: number) =>
    remediationClient.TogglePolicy({ id, status }) as Promise<RemediationPolicyEntity>,
  // 策略匹配测试（模拟告警上下文，纯读不落库；详设 §2.11.1）
  matchTestPolicies(data: { source?: string; level?: string; title?: string; tags?: string[] }) {
    return remediationClient.MatchTestPolicy({
      source: data.source || undefined,
      level: data.level || undefined,
      title: data.title || undefined,
      tags: data.tags ?? [],
    }) as Promise<{ total?: number; matched?: number; results?: RemediationMatchTestResultItem[] }>;
  },

  // ---- 执行记录 ----
  listExecutions(
    opts: {
      page?: number;
      pageSize?: number;
      status?: string;
      policyId?: number;
      triggerType?: string;
      alertId?: string;
      rcaRecordId?: number;
      startTime?: string;
      endTime?: string;
    } = {},
  ) {
    return remediationClient.ListExecutions({
      page: opts.page ?? 1,
      pageSize: opts.pageSize ?? 10,
      status: opts.status || undefined,
      policyId: opts.policyId,
      triggerType: opts.triggerType || undefined,
      alertId: opts.alertId || undefined,
      rcaRecordId: opts.rcaRecordId,
      startTime: opts.startTime || undefined,
      endTime: opts.endTime || undefined,
    }) as Promise<RemediationListResponse<RemediationExecutionEntity>>;
  },
  getExecution: (id: number) => remediationClient.GetExecution({ id }),
  approveExecution: (id: number, comment?: string) =>
    remediationClient.ApproveExecution({ id, comment: comment || undefined }),
  rejectExecution: (id: number, reason: string) => remediationClient.RejectExecution({ id, reason }),
  retryExecution: (id: number) => remediationClient.RetryExecution({ id }),
  cancelExecution: (id: number, reason?: string) =>
    remediationClient.CancelExecution({ id, reason: reason || undefined }),
  rollbackExecution: (id: number) => remediationClient.RollbackExecution({ id }),
  verifyExecution: (id: number) => remediationClient.VerifyExecution({ id }),

  // ---- 工作台 ----
  getPendingQueue: (opts: { page?: number; pageSize?: number } = {}) =>
    remediationClient.GetPendingQueue({ page: opts.page ?? 1, pageSize: opts.pageSize ?? 20 }) as Promise<
      RemediationListResponse<RemediationExecutionEntity>
    >,
  getRecentExecutions: (opts: { page?: number; pageSize?: number; limit?: number } = {}) =>
    remediationClient.GetRecentExecutions({
      page: opts.page ?? 1,
      pageSize: opts.pageSize ?? 20,
      limit: opts.limit ?? 20,
    }) as Promise<RemediationListResponse<RemediationExecutionEntity>>,

  // ---- 仪表盘 ----
  getDashboardStats: () => remediationClient.GetDashboardStats({}),
  getDashboardTrend: (days = 7) => remediationClient.GetDashboardTrend({ days }),
  getPolicyRank: (limit = 10) => remediationClient.GetPolicyRank({ limit }),
  getSourceDist: () => remediationClient.GetSourceDist({}),

  // ---- AI 修复记录 ----
  listAIRecords(opts: { page?: number; pageSize?: number; status?: string; assetId?: number; alertId?: string } = {}) {
    return remediationClient.ListAIRecords({
      page: opts.page ?? 1,
      pageSize: opts.pageSize ?? 10,
      status: opts.status || undefined,
      assetId: opts.assetId,
      alertId: opts.alertId || undefined,
    }) as Promise<RemediationListResponse<RemediationAIRecordEntity>>;
  },
  getAIRecord: (id: number) => remediationClient.GetAIRecord({ id }),
  // ---- P1 手动触发 AI 修复（运维中心设备卡片 AI 运维弹框·模式 A 经验修复）----
  triggerAiRemediation(req: {
    assetId: number;
    assetName?: string;
    assetIp?: string;
    assetType?: string;
    description?: string;
    alertId?: string;
    rcaRecordId?: number;
  }) {
    return remediationClient.TriggerAiRemediation(req);
  },
  confirmAiRemediation: (id: number) => remediationClient.ConfirmAiRemediation({ id }),
};

// 13-AI 智能运维场景模板选项（策略编辑器下拉；仅取启用场景，详设 §3.2 is_enabled=1）
