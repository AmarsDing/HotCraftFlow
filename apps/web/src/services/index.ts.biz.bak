  cancelTask: (id: number) => opstoolsDiscoveryClient.CancelDiscoveryTask({ id }) as Promise<DiscoveryTask>,
  deleteTask: (id: number) => opstoolsDiscoveryClient.DeleteDiscoveryTask({ id }) as Promise<unknown>,
  listResults(id: number, opts: { page?: number; pageSize?: number; status?: string } = {}) {
