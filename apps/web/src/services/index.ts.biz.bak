// ---- 风场网格二进制切片（综合业务平台 GPU 粒子层；WF32 小端 Float32Array）----
export const windfieldGridService = {
  /** 取文件某气压层的 U/V 网格二进制（responseType=arraybuffer，前端自行解析 WF32 头）。
   *  v 缺省 4（v4=v3 扩展头 + 标量要素段，P5 色斑图层数据源；旧服务端不支持时回退由调用方负责）；
   *  lod 1..3=box 2×2 均值降采样（FR-07/P2C-T13，仅 v≥3 + WRF_REGIONAL ≥1024×1024 网格生效，
   *  其余源服务端直通 lod=0 全分辨率，老语义不破；缺省/0=不携带该参数） */
  fetchGrid(id: string | number, level?: string | number, v?: number, lod?: number): Promise<ArrayBuffer> {
    const params: Record<string, string> = { v: String(v ?? 4) };
    if (level != null && level !== '') params.level = String(level);
    if (lod != null && lod > 0) params.lod = String(lod);
    return request.get(`/api/v1/monitor/windfield/files/${Number(id)}/grid`, {
      params,
      responseType: 'arraybuffer',
      timeout: 300000,
    }) as Promise<unknown> as Promise<ArrayBuffer>;
  },
  /** 网格差值（FR-12 多模式对比差值色斑数据源）：WF32 v4 同构二进制，标量段=A−B 差值场，
   *  尾迹 8B diffOf={fileA,fileB}（parseWf32 逐段定长解析，尾迹不参与）。
   *  仅同网格可减（服务端校验异网格 400 GRID_MISMATCH）；element=WSPD 等 3D 要素须带 level(hPa)，2D 要素省略。 */
  fetchGridDiff(fileA: number, fileB: number, element: string, level?: number): Promise<ArrayBuffer> {
    const params: Record<string, string> = { fileA: String(fileA), fileB: String(fileB), element };
    if (level != null && level > 0) params.level = String(level);
    return request.get('/api/v1/monitor/windfield/grid-diff', {
      params,
      responseType: 'arraybuffer',
      timeout: 300000,
    }) as Promise<unknown> as Promise<ArrayBuffer>;
  },
};

