  // 模型版本号（每次更新文件自增，只读）
  version?: number;
  // 最后同步时间（UE5 客户端上报，只读；未同步过为空）
  lastSyncedAt?: string;
  // 模型参数详情（jsonb；场景模型约定存 kind/origin/triangles 等，与后端 proto params 字段一致）
  // null = 显式清空（换文件后无新参数可提取时置 null，走 updateMask null → SetNull 链路）
  params?: Record<string, unknown> | null;
}

// 3D 模型文件在本地存储根目录下的一级子目录（与后端 modelStorageBucket 对齐）
const MODEL_STORAGE_BUCKET = 'models';

// 从 file:upload 返回的 url（/api/v1/monitor/file:download?path=<rel>）中提取存储相对路径
function extractStoredPath(url: string): string {
  const idx = url.indexOf('path=');
  const rel = idx >= 0 ? decodeURIComponent(url.slice(idx + 5)) : url;
  return rel;
}

function uploadToBucket(
  file: File,
  objectName: string,
  onProgress?: (percent: number) => void,
  bucketName: string = MODEL_STORAGE_BUCKET,
): Promise<string> {
  const fd = new FormData();
  fd.append('file', file);
  return request
    .post<{ url?: string }>('/api/v1/monitor/file:upload', fd, {
      params: { bucketName, objectName },
      headers: { 'Content-Type': 'multipart/form-data' },
      timeout: 0, // 模型文件上限 500MB，禁用默认 30s 超时
      onUploadProgress: (evt) => {
        if (onProgress && evt.total) onProgress(Math.round((evt.loaded * 100) / evt.total));
      },
    })
    .then((resp) => {
      const rel = extractStoredPath(resp?.url || '');
      if (!rel) return Promise.reject(new Error('上传返回缺少文件路径'));
      return rel;
    });
}

// 3D 模型历史版本（更新模型文件时后端自动归档；应用=回滚到该版本，删除=记录与磁盘文件一并清除）
export interface Device3dModelVersionEntity {
  id?: number;
  modelId?: number;
  // 归档时的模型版本号
  version?: number;
  name?: string;
  filePath?: string;
  thumbnailPath?: string;
  fileFormat?: string;
  fileSize?: number;
  checksum?: string;
  params?: Record<string, unknown>;
  createTime?: string;
  updateTime?: string;
}

export const device3dModelService = {
  ...makeCrudServiceFromClient<Device3dModelEntity>(device3dModelClient),
  // 静默 Get（skipErrorNotify）：大屏/场景装配等后台自动加载链路专用——404/失败由调用方自行降级，
  // 不弹全局错误 toast（如机场大屏 screen.twin.scene_model_id 配置指向已删模型时，回落程序化场景不打扰值班员；
  // 交互式页面仍用 CRUD get，错误提示由拦截器承担）
  getQuiet(id: string | number): Promise<Device3dModelEntity> {
    return request.get<Device3dModelEntity>(`/api/v1/monitor/device-3d-models/${Number(id)}`, {
      skipErrorNotify: true,
    });
  },
  // 上传模型文件（fbx/gltf/glb/obj/datasmith），返回 DB file_path 所需的相对路径（不含 models/ 前缀，
  // 后端 computeModelFileMeta/GetModelDownloadURL 会自行补前缀）及文件元信息。
  // 存储路径按详设 §2.5.4 组织为 {category}/{yyyyMMdd}/{uuid}.{ext}，categorySegment 由调用方按分类编码传入
  uploadModelFile(
    file: File,
    onProgress?: (percent: number) => void,
    categorySegment?: string,
  ): Promise<{ path: string; size: number; format: string }> {
    const ext = (file.name.split('.').pop() || '').toLowerCase();
    const day = new Date().toISOString().slice(0, 10).replace(/-/g, '');
    const prefix = categorySegment ? `${categorySegment}/` : '';
    const objectName = `${prefix}${day}/${crypto.randomUUID()}.${ext}`;
    return uploadToBucket(file, objectName, onProgress).then((rel) => ({
      path: rel.startsWith(MODEL_STORAGE_BUCKET + '/') ? rel.slice(MODEL_STORAGE_BUCKET.length + 1) : rel,
      size: file.size,
      format: ext,
    }));
  },
  // 上传缩略图，返回含 models/ 前缀的存储相对路径（缩略图无服务端前缀补全，消费方直接用 file:download?path= 读取）
  uploadThumbnail(file: File): Promise<string> {
    const ext = (file.name.split('.').pop() || '').toLowerCase();
    return uploadToBucket(file, `thumbnails/${crypto.randomUUID()}.${ext}`);
  },
  // 拉取文件 Blob（缩略图行内预览/大屏 GLB 场景下载用，Authorization 头由 request 拦截器注入；
  // onProgress 可选：大文件下载进度上报，total=0 表示服务端未给 Content-Length；
  // opts.silent：跳过全局错误 toast，供大屏自动加载等"失败静默降级"链路使用）
  fetchFileBlob(
    relPath: string,
    onProgress?: (loaded: number, total: number) => void,
    opts?: { silent?: boolean },
  ): Promise<Blob> {
    return request.get<Blob>('/api/v1/monitor/file:download', {
      params: { path: relPath },
      responseType: 'blob',
      timeout: 0, // GLB 场景模型可达数百 MB，禁用默认 30s 超时（与 uploadToBucket 同口径）
      skipErrorNotify: opts?.silent === true,
      onDownloadProgress: onProgress
        ? (evt) => {
            onProgress(evt.loaded, evt.total ?? 0);
          }
        : undefined,
    });
  },
  // ---- 版本历史（编辑弹框历史记录横条：应用=回滚并归档当前版本，删除=磁盘级清除）----
  listVersions: (modelId: string | number) =>
    device3dModelClient.ListVersions({ modelId: Number(modelId) }) as Promise<ListResponse<Device3dModelVersionEntity>>,
  applyVersion: (modelId: string | number, versionId: number) =>
    device3dModelClient.ApplyVersion({ modelId: Number(modelId), versionId }) as Promise<unknown>,
  deleteVersion: (modelId: string | number, versionId: number) =>
    device3dModelClient.DeleteVersion({ modelId: Number(modelId), versionId }) as Promise<unknown>,
};

