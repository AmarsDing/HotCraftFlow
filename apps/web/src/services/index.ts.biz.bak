export const metradarWizardService = {
  listTemplates() {
    return request.get<{ items?: MetradarTemplateEntity[] }>('/api/v1/admin/metradar/templates');
  },
  validate(body: { templateCode?: string; host?: string; port?: number }) {
    return request.post<{
      ok?: boolean;
