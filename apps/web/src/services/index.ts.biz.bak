// ---- 数据查询服务（06-query 子服务：历史指标 + 告警统计） ----
export interface MetricSeriesEntity {
  metricKey?: string;
  metricName?: string;
  metricUnit?: string;
  granularity?: string;
  points?: { time?: string; value?: number }[];
}

// 06-query 子服务的告警统计（与告警服务自身的 AlarmStatisticsEntity 区分，避免接口合并冲突）
export interface QueryAlarmStatisticsEntity {
  total?: number;
  byLevel?: { level?: string; count?: number }[];
  byStatus?: { status?: string; count?: number }[];
  topDevices?: { deviceId?: number; deviceName?: string; count?: number }[];
  topRules?: { ruleId?: number; count?: number }[];
  mttrSeconds?: number;
  confirmRate?: number;
  recoveryRate?: number;
  trend?: { time?: string; level?: string; count?: number; mttrSeconds?: number }[];
  byDeviceType?: { deviceType?: string; count?: number }[];
  topMetrics?: { metricKey?: string; count?: number }[];
  // 告警专项统计扩展（24-统计分析与AI洞察 05 文档 §4.3；proto monitorquery/v1 query.proto）
  topMessages?: { message?: string; count?: number; maxAlertLevel?: number }[];
  byHourOfWeek?: { dayOfWeek?: number; hour?: number; count?: number }[];
  // 分类轴聚合（2026-09-21 告警分类化）：category=分类树根 code 或保留轴 line/data/misc
  byCategory?: { category?: string; categoryName?: string; count?: number; activeCount?: number; criticalCount?: number }[];
  suppressedCount?: number; // 窗口内进入抑制记录数（窗口全局口径，不受设备过滤）
  duplicatedCount?: number; // 窗口内归并冗余条数（窗口全局口径）
  // 噪声率 = (suppressedCount + duplicatedCount) / total（健康线 <40%）
}

// 按设备告警统计（P1-2，2026-09-15；proto monitorquery/v1 DeviceAlarmStat）。
// 计数均为 proto uint32 → JSON number（不适用 int64 字符串化陷阱），无需 normalize。
export interface DeviceAlarmStatEntity {
  deviceId?: number;
  deviceName?: string;
  total?: number;
  criticalCount?: number; // critical + emergency 合计（最致命口径）
  warningCount?: number;
  infoCount?: number;
  activeCount?: number; // status='active'（未处理）
  mttrSeconds?: number; // 平均恢复时间（秒），无已恢复告警时为 0
  lastAlarmTime?: string;
}
export interface DeviceAlarmStatisticsEntity {
  items?: DeviceAlarmStatEntity[];
  total?: number; // 有告警的设备总数（分页用）
}

export interface AlarmHistoryItemEntity {
  alarmId?: string;
  ruleId?: number;
  deviceId?: number;
  deviceName?: string;
  alarmLevel?: string;
  alertLevel?: number;
  status?: string;
  metricKey?: string;
  metricValue?: number;
  threshold?: number;
  message?: string;
  description?: string;
  alarmTime?: string;
  recoveredAt?: string;
  alarmDuration?: number;
}

export const monitorQueryService = {
  getDeviceHistory: (params: {
    id: number;
    metricKeys: string;
    startTime: string;
    endTime: string;
    granularity?: string;
    maxPoints?: number;
    sampleMethod?: string;
  }) =>
    monitorQueryClient.GetDeviceHistory({
      id: params.id,
      metricKeys: params.metricKeys,
      startTime: params.startTime,
      endTime: params.endTime,
      granularity: params.granularity,
      maxPoints: params.maxPoints,
      sampleMethod: params.sampleMethod,
    }) as Promise<{
      deviceId?: number;
      series?: MetricSeriesEntity[];
    }>,
  getDeviceLatestMetrics: (params: { id: number; metricKeys: string; staleAfterSeconds?: number }) =>
    monitorQueryClient.GetDeviceLatestMetrics({
      id: params.id,
      metricKeys: params.metricKeys,
      staleAfterSeconds: params.staleAfterSeconds,
    }) as Promise<{
      deviceId?: number;
      items?: {
        metricKey?: string;
        metricName?: string;
        metricUnit?: string;
        value?: number;
        time?: string;
        found?: boolean;
        stale?: boolean;
      }[];
    }>,
  // 批量查询多设备历史数据（同指标多设备对比，deviceIds 逗号分隔，上限 20）
  getDeviceHistoryBatch: (params: {
    deviceIds: string;
    metricKey: string;
    startTime: string;
    endTime: string;
    granularity?: string;
    maxPoints?: number;
    sampleMethod?: string;
  }) =>
    monitorQueryClient.GetDeviceHistoryBatch({
      deviceIds: params.deviceIds,
      metricKey: params.metricKey,
      startTime: params.startTime,
      endTime: params.endTime,
      granularity: params.granularity,
      maxPoints: params.maxPoints,
      sampleMethod: params.sampleMethod,
    }) as Promise<{
      items?: { deviceId?: number; series?: MetricSeriesEntity }[];
    }>,
  getAlarmHistory: (params: {
    deviceId?: number;
    alarmLevel?: string;
    status?: string;
    ruleId?: number;
    keyword?: string;
    startTime?: string;
    endTime?: string;
    page?: number;
    pageSize?: number;
    sort?: string;
    order?: string;
    alertLevel?: number;
  }) =>
    monitorQueryClient.GetAlarmHistory({
      deviceId: params.deviceId,
      alarmLevel: params.alarmLevel,
      status: params.status,
      ruleId: params.ruleId,
      keyword: params.keyword,
      startTime: params.startTime,
      endTime: params.endTime,
      page: params.page,
      pageSize: params.pageSize,
      sort: params.sort,
      order: params.order,
      alertLevel: params.alertLevel,
    }) as Promise<{
      items?: AlarmHistoryItemEntity[];
      total?: number;
    }>,
  getAlarmStatistics: (params: {
    startTime: string;
    endTime: string;
    deviceId?: number;
    topN?: number;
    trendInterval?: string;
    categoryCode?: string;
  }) =>
    monitorQueryClient.GetAlarmStatistics({
      startTime: params.startTime,
      endTime: params.endTime,
      deviceId: params.deviceId,
      topN: params.topN,
      trendInterval: params.trendInterval,
      categoryCode: params.categoryCode,
    }) as Promise<QueryAlarmStatisticsEntity>,
  // 分类域指标 TOP 榜（W3/G-1 性能 TOP）：categoryCode 域内设备按 metricKey 聚合（mean/max）降序。
  // 返回 deviceId = monitor_devices.id；端口速率类（if_in_octets/if_out_octets）采集侧已落 bps，agg=max 取窗口峰值。
  getMetricTop: (params: { categoryCode: string; metricKey: string; hours?: number; topN?: number; agg?: string }) =>
    monitorQueryClient.GetMetricTop({
      categoryCode: params.categoryCode,
      metricKey: params.metricKey,
      hours: params.hours,
      topN: params.topN,
      agg: params.agg,
    }) as Promise<{
      metricKey?: string;
      items?: { deviceId?: number; value?: number }[];
    }>,
  // 告警分类轴枚举集（2026-09-21 告警分类化）：设备域分类树根 ∪ 保留轴 line/data/misc，
  // 供告警域各页面分类筛选器/瓷贴条驱动。
  getAlarmCategoryMeta: () =>
    monitorQueryClient.GetAlarmCategoryMeta({}) as Promise<AlarmCategoryMetaResponse>,
  // 按设备告警统计（P1-2，2026-09-15）：告警 Tab 全量设备表数据源。
  // sort 白名单（后端校验）：total/critical_count/active_count/mttr/last_alarm_time；order：asc/desc
  getDeviceAlarmStatistics: (params: {
    startTime: string;
    endTime: string;
    page?: number;
    pageSize?: number;
    sort?: string;
    order?: string;
  }) =>
    monitorQueryClient.GetDeviceAlarmStatistics({
      startTime: params.startTime,
      endTime: params.endTime,
      page: params.page,
      pageSize: params.pageSize,
      sort: params.sort,
      order: params.order,
    }) as Promise<DeviceAlarmStatisticsEntity>,
  // F2 语义层：指标字典分页查询（keyword 模糊 + category 过滤，供编辑器指标选择器）
  listMetricDictionary: (params?: { keyword?: string; category?: string; page?: number; pageSize?: number }) =>
    monitorQueryClient.ListMetricDictionary({
      keyword: params?.keyword,
      category: params?.category,
      page: params?.page,
      pageSize: params?.pageSize,
    }) as Promise<{
      items?: MetricDictionaryEntryEntity[];
      total?: number;
    }>,
  // F2 语义层：按 metric_keys 批量取字典条目（三层缺省链中间层批量回填，一次请求免 N+1）
  getMetricDictionaryByKeys: (metricKeys: string[]) =>
    monitorQueryClient.GetMetricDictionaryByKeys({ metricKeys }) as Promise<{
      items?: MetricDictionaryEntryEntity[];
      total?: number;
    }>,
  // E4 收尾：指标字典管理写入（upsert：metric_key 主键，空字段不覆盖既有值）+ 删除
  upsertMetricDictionary: (entry: MetricDictionaryEntryEntity) =>
    monitorQueryClient.UpsertMetricDictionary({ entry: entry as never }) as Promise<unknown>,
  deleteMetricDictionary: (metricKey: string) =>
    monitorQueryClient.DeleteMetricDictionary({ metricKey }) as Promise<unknown>,
};

export const metricDictionaryService = {
  list: (params?: { keyword?: string; category?: string; page?: number; pageSize?: number }) =>
    monitorQueryClient.ListMetricDictionary({
      keyword: params?.keyword,
      category: params?.category,
      page: params?.page,
      pageSize: params?.pageSize,
    }) as Promise<{
      items?: MetricDictionaryEntryEntity[];
      total?: number;
    }>,
  upsert: (entry: MetricDictionaryEntryEntity) =>
    monitorQueryClient.UpsertMetricDictionary({ entry: entry as never }) as Promise<unknown>,
  delete: (metricKey: string) => monitorQueryClient.DeleteMetricDictionary({ metricKey }) as Promise<unknown>,
};

// F2 语义层：指标字典条目（与 monitorquery/v1 MetricDictionaryEntry 对齐）。
// defaultThresholds 为 JSON 串（[{op,value,color}]），消费方解析。
export interface MetricDictionaryEntryEntity {
  metricKey?: string;
  displayName?: string;
  unit?: string;
  decimals?: number;
  aliases?: string[];
  semanticKey?: string;
  defaultThresholds?: string;
  collectIntervalSec?: number;
  recommendedChart?: string;
  deviceCategories?: string[];
  isKeyMetric?: boolean;
  displayGroup?: string;
  nominalValue?: string;
  valueMap?: string;
}

