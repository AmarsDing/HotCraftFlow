// ---- 数据备份（analysis 子服务，data_backup_records）----
export interface BackupRecordEntity {
  id?: number;
  backupNo?: string;
  backupType?: string; // full / incremental
  backupScope?: string; // all / device_metrics / device_metrics_aggregated / device_statistics / analysis_results / prediction_results
  backupTarget?: string;
  backupStorage?: string; // local / nfs（存储目标类型）
  storageTargetCode?: string; // 存储目标编码（'local'=本地既有存储；下载/恢复按此路由）
  backupSize?: number;
  recordCount?: number;
  status?: string; // pending/running/success/failed
  progress?: number;
  errorMessage?: string;
  compression?: string; // gzip
  checksum?: string;
  scheduled?: boolean;
  dataStart?: string;
  dataEnd?: string;
  startedAt?: string;
  completedAt?: string;
  createdBy?: number;
  createdAt?: string;
  downloadUrl?: string;
}

async function fetchBackupBlob(id: string | number): Promise<Blob> {
  return request.get<Blob>(`/api/v1/monitor/data-management/backup/${Number(id)}/download`, {
    responseType: 'blob',
    timeout: 300000,
  });
}

export const backupService = {
  list(opts: { page?: number; pageSize?: number; backupType?: string; backupScope?: string; status?: string } = {}) {
    return analysisClient.ListBackupRecords({
      page: opts.page ?? 1,
      pageSize: opts.pageSize ?? 10,
      backupType: opts.backupType || undefined,
      backupScope: opts.backupScope || undefined,
      status: opts.status || undefined,
    }) as Promise<ListResponse<BackupRecordEntity>>;
  },
  get(id: string | number) {
    return analysisClient.GetBackupRecord({ id: Number(id) }) as Promise<BackupRecordEntity>;
  },
  create(data: { backupType: string; backupScope: string; dataStart?: string; dataEnd?: string; measurements?: string[]; storageTargetCode?: string }) {
    return analysisClient.CreateBackup({
      backupType: data.backupType,
      backupScope: data.backupScope,
      dataStart: data.dataStart,
      dataEnd: data.dataEnd,
      measurements: data.measurements,
      storageTargetCode: data.storageTargetCode,
    }) as Promise<BackupRecordEntity>;
  },
  restore(id: string | number) {
    return analysisClient.RestoreBackup({ id: Number(id) }) as Promise<unknown>;
  },
  delete(id: string | number) {
    return analysisClient.DeleteBackup({ id: Number(id) }) as Promise<unknown>;
  },
  // 鉴权流式下载（gzip CSV）
  async download(rec: BackupRecordEntity) {
    const blob = await fetchBackupBlob(rec.id as number);
    downloadBlob(blob, `${rec.backupNo || 'backup'}.csv.gz`);
  },
};

