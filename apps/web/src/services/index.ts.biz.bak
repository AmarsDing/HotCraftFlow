  timeRangeMin?: number;
  enabled?: boolean;
  lastRunAt?: string;
  lastStatus?: string; // SUCCESS/FAILED/RUNNING
  lastError?: string;
  fetchedCount?: number;
  // 时效性配置（雷达监控增强 Phase 1 proto 字段 17/18；后端 Update 全量覆盖，编辑时需携带原值）
  freshnessThresholdSec?: number; // 时效性阈值（秒），默认 600
  freshnessAlertEnabled?: boolean; // 是否启用时效性告警
  createTime?: string;
  updateTime?: string;
  remark?: string;
}

