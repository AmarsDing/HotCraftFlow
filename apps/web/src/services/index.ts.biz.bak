// ===================== Collector: SNMP 监控模板 =====================
export interface SnmpMonitorProfileEntity extends CrudEntity {
  profileName?: string;
  profileCode?: string;
  // 适用设备分类码（device_categories.code，多选可挂任意层级；空=通用）
  categoryCodes?: string[];
  // 适用设备型号 ID（device_models.id，多选；空=不限型号）
  modelIds?: number[];
  vendor?: string;
  description?: string;
  isSystem?: boolean;
  status?: number;
  tenantId?: number;
}
export interface SnmpProfileOIDEntity {
  id?: number;
  profileId?: number;
  oid?: string;
  metricKey?: string;
  displayName?: string;
  description?: string;
  dataType?: string;
  unit?: string;
  scale?: number;
  operation?: string;
  isPortMetric?: boolean;
  parentOid?: string;
  portIndexOid?: string;
  portNameOid?: string;
  portAliasOid?: string;
  sortOrder?: number;
  status?: number;
}
export const snmpProfileService = {
  listProfiles(opts: PagingRequest & { formValues?: Record<string, unknown> } = {}) {
    const params = buildQueryParams(opts.formValues, opts);
    // 生成 client 用 truthy 判断拼 query，会丢弃 status=0（停用）；此处手动构建保证 0 值可达
    const query = new URLSearchParams();
    const fv = opts.formValues ?? {};
    for (const k of ['categoryCode', 'vendor', 'keyword'] as const) {
      const v = fv[k];
      if (v !== undefined && v !== null && v !== '') query.set(k, String(v));
    }
    if (fv.status !== undefined && fv.status !== null && fv.status !== '') {
      query.set('status', String(fv.status));
    }
    if (params.page) query.set('page', String(params.page));
    if (params.pageSize) query.set('pageSize', String(params.pageSize));
    const qs = query.toString();
    return request.get<ListResponse<SnmpMonitorProfileEntity>>(
      `/api/v1/monitor/collector/snmp/profiles${qs ? `?${qs}` : ''}`,
    );
  },
  getProfile(id: string | number) {
    return snmpProfileClient.GetProfile({ id: Number(id) }) as Promise<SnmpMonitorProfileEntity>;
  },
  createProfile(data: Partial<SnmpMonitorProfileEntity>) {
    return snmpProfileClient.CreateProfile({ data: data as never }) as Promise<unknown>;
  },
  updateProfile(id: string | number, data: Partial<SnmpMonitorProfileEntity>) {
    return snmpProfileClient.UpdateProfile({ id: Number(id), data: data as never }) as Promise<unknown>;
  },
  deleteProfile(id: string | number) {
    return snmpProfileClient.DeleteProfile({ id: Number(id) }) as Promise<unknown>;
  },
  listProfileOIDs(profileId: string | number, status?: number) {
    // status=0 需显式可达（生成 client truthy 判断会丢弃）
    const qs = status !== undefined && status !== null ? `?status=${status}` : '';
    return request.get<ListResponse<SnmpProfileOIDEntity>>(
      `/api/v1/monitor/collector/snmp/profiles/${profileId}/oids${qs}`,
    );
  },
  createProfileOID(profileId: string | number, data: Partial<SnmpProfileOIDEntity>) {
    return snmpProfileClient.CreateProfileOID({
      profileId: Number(profileId),
      data: data as never,
    }) as Promise<unknown>;
  },
  updateProfileOID(profileId: string | number, oidId: string | number, data: Partial<SnmpProfileOIDEntity>) {
    return snmpProfileClient.UpdateProfileOID({
      profileId: Number(profileId),
      oidId: Number(oidId),
      data: data as never,
    }) as Promise<unknown>;
  },
  deleteProfileOID(profileId: string | number, oidId: string | number) {
    return snmpProfileClient.DeleteProfileOID({
      profileId: Number(profileId),
      oidId: Number(oidId),
    }) as Promise<unknown>;
  },
  // 在线试采 OID（先试后存，结果不落库）；skipErrorNotify 由调用方展示整体性错误
  testOIDs(data: { protocolBindingId: number; oids: string[]; operation?: string; timeoutSec?: number }) {
    return request.post<{ items?: SnmpOIDTestResult[] }>('/api/v1/monitor/collector/snmp/oids/test', data, {
      skipErrorNotify: true,
    } as Record<string, unknown>);
  },
  // ===== 历史版本（编辑历史 / 快照查看 / 恢复 / 恢复出厂） =====
  listProfileVersions(profileId: string | number) {
    return snmpProfileClient.ListProfileVersions({ profileId: Number(profileId) }) as Promise<
      ListResponse<ProfileVersionEntity>
    >;
  },
  getProfileVersion(profileId: string | number, version: number) {
    return snmpProfileClient.GetProfileVersion({ profileId: Number(profileId), version }) as Promise<
      ProfileVersionSnapshotEntity
    >;
  },
  restoreProfileVersion(profileId: string | number, version: number, remark?: string) {
    return snmpProfileClient.RestoreProfileVersion({
      profileId: Number(profileId),
      version,
      remark,
    }) as Promise<unknown>;
  },
  restoreFactoryDefault(profileId: string | number, remark?: string) {
    return snmpProfileClient.RestoreFactoryDefault({ profileId: Number(profileId), remark }) as Promise<unknown>;
  },
};

// OID 在线试采结果项（与后端 OIDTestResult 对齐）
export interface SnmpOIDTestResult {
  oid?: string;
  success?: boolean;
  value?: string;
  valueType?: string;
  valueCount?: number;
  values?: string[]; // walk 全部返回值（≤50）；get 为空
  durationMs?: number;
  error?: string;
}

// 模板历史版本元信息（不含快照体）
export interface ProfileVersionEntity {
  id?: number;
  profileId?: number;
  version?: number;
  changeType?: string; // create/update_meta/oid_add/oid_update/oid_delete/delete/restore/factory_reset
  remark?: string;
  changedBy?: number;
  createTime?: string;
}

// 模板历史版本快照（snapshot 为 JSON 文本，供查看/对比）
export interface ProfileVersionSnapshotEntity extends ProfileVersionEntity {
  snapshot?: string;
}

