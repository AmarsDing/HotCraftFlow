export interface WiringDiagramEntity {
  id?: number;
  wiringId?: number;
  filePath?: string;
  fileName?: string;
  fileSize?: number;
  mimeType?: string;
  version?: string;
  isCurrent?: number; // 0-否 1-是
  remark?: string;
  createBy?: number;
  createTime?: string;
  updateTime?: string;
}

export const wiringDiagramService = {
  list(opts: PagingRequest & { formValues?: Record<string, unknown> } = {}) {
    return request.get<ListResponse<WiringDiagramEntity>>('/api/v1/monitor/wiring-diagrams', {
      params: buildQueryParams(opts.formValues, opts),
    });
  },
  get(id: string | number) {
    return request.get<WiringDiagramEntity>(`/api/v1/monitor/wiring-diagrams/${id}`);
  },
  delete(id: string | number) {
    return request.delete(`/api/v1/monitor/wiring-diagrams/${id}`);
  },
  // 上传（multipart 手写路由，元数据走 query 参数；版本号留空时后端自动递增 minor）
  upload(file: File, meta: { wiringId: number; version?: string }) {
    const fd = new FormData();
    fd.append('file', file);
    const params: Record<string, string> = { wiringId: String(meta.wiringId) };
    if (meta.version) params.version = meta.version;
    return request.post<{ data?: WiringDiagramEntity }>('/api/v1/monitor/wiring-diagrams:upload', fd, {
      params,
      headers: { 'Content-Type': 'multipart/form-data' },
      timeout: 300000,
    });
  },
  // 下载/预览均走 JWT 鉴权的手写流式路由，前端以 axios 取 blob 后本地处理
  fetchBlob(id: string | number, kind: 'download' | 'preview'): Promise<Blob> {
    return request.get<Blob>(`/api/v1/monitor/wiring-diagrams/${id}/${kind}`, {
      responseType: 'blob',
      timeout: 300000,
    });
  },
  download(entity: WiringDiagramEntity) {
    if (!entity.id) return Promise.resolve();
    return this.fetchBlob(entity.id, 'download').then((blob) =>
      downloadBlob(blob, entity.fileName || `diagram_${entity.id}`),
    );
  },
};

