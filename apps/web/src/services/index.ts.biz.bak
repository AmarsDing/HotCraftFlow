  analyze: (id: number) => aiopsRcaClient.AnalyzeRcaRecord({ id }) as Promise<AiopsRcaRecordEntity>,
  markFalsePositive: (id: number, isFalsePositive: number, reason?: string) =>
    aiopsRcaClient.MarkRcaFalsePositive({
      id,
      isFalsePositive,
      reason: reason || undefined,
    }) as Promise<AiopsRcaRecordEntity>,
  // 知识沉淀（仅 completed；幂等）
  depositKnowledge: (id: number) => aiopsRcaClient.DepositRcaKnowledge({ id }) as Promise<AiopsRcaRecordEntity>,
};

