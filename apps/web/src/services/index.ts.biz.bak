// ---- 远程维护能力开关（与后端 opstools MaintCap* 常量同口径） ----
// monitor_devices.maintenance_caps / device_categories.default_maintenance_caps；
// NULL/{} = 自动（跟随协议绑定）；显式 map 以用户配置为准（缺 key = 关闭，fail-closed）。
export const MAINT_CAP_WEB_TERMINAL = 'web_terminal';
export const MAINT_CAP_REMOTE_DESKTOP = 'remote_desktop';
export const MAINT_CAP_COMMAND_EXEC = 'command_exec';
export type MaintenanceCaps = Record<string, boolean>;

/** 维护能力是否开启：caps 空（undefined/null/{}）= 自动跟随协议绑定（视为开启）；显式配置以 map 值为准 */
export function maintenanceCapEnabled(caps: MaintenanceCaps | null | undefined, key: string): boolean {
  if (!caps || Object.keys(caps).length === 0) return true;
  return caps[key] === true;
}

/** 是否自动模式（未显式配置，跟随协议绑定） */
export function maintenanceCapsIsAuto(caps: MaintenanceCaps | null | undefined): boolean {
  return !caps || Object.keys(caps).length === 0;
}

// 设备扩展表
export interface MonitorDeviceEntity extends CrudEntity {
  assetId?: number;
  monitorStatus?: number;
  // 远程维护能力开关（web_terminal/remote_desktop/command_exec）；空=自动（跟随协议绑定）
  maintenanceCaps?: MaintenanceCaps;
  // 设备级监控面板模板 ID（panel_templates.id，设备监控面板 P3）；0/未设置=跟随分类默认 → 通用兜底
  panelTemplateId?: number;
  internal?: number;
  rebootInterval?: number;
  enableGpsSync?: number;
  /** @deprecated v1 遗留死字段（后端无消费方），告警模板请用 alarm_device_templates */
  dashboardId?: number;
  instance?: string;
  emergencyId?: number;
  /** @deprecated v1 遗留死字段（后端无消费方），告警通知请用 alarm_notice_profiles */
  noticeId?: number;
  isSendNormal?: number;
  systemInfoId?: number;
  // v2.0 硬件回写摘要（只读，采集器 UpdateHardwareInfo 写入）
  osName?: string;
  cpuCores?: number;
  memTotalGb?: number;
  diskTotalGb?: number;
  lastCollectedAt?: string;
}
export const monitorDeviceService = makeCrudServiceFromClient<MonitorDeviceEntity>(monitorDeviceClient);

/**
 * 监控域设备选项行：id 为 monitor_devices.id（监控域 ID）。
 * 采集器写 InfluxDB、monitorquery 历史/导出、monitoralarm 告警、analysis 统计/对比/预测
 * 全部以 monitor_devices.id 为设备标识（数据权限范围同样返回该空间），
 * 因此查监控类数据的设备下拉必须用此函数；name/assetCode 由 monitor_assets 按 assetId 回填。
 * 禁止直接拿 monitor_assets.id 查监控数据（资产域 ID，与监控域不同，会查空）。
 */
export async function listMonitorDeviceRows(): Promise<MonitorAssetEntity[]> {
  const [devResp, assetResp] = await Promise.all([
    monitorDeviceService.list({ noPaging: true }),
    monitorAssetService.list({ noPaging: true }),
  ]);
  const assetMap = new Map((assetResp.items ?? []).map((a) => [Number(a.id), a]));
  return (devResp.items ?? [])
    .filter((d) => d.id != null)
    .map((d) => {
      const asset = d.assetId != null ? assetMap.get(Number(d.assetId)) : undefined;
      return {
        id: Number(d.id),
        assetId: d.assetId,
        name: asset?.name,
        assetCode: asset?.assetCode,
        // 分类/位置/分组随资产带回（历史数据页分组选择器等消费；不使用方无感）
        deviceCategoryId: asset?.deviceCategoryId,
        // 型号随资产带回（设备告警配置页指标目录适配标记用）
        modelId: asset?.modelId,
        location: asset?.location,
        remark: asset?.remark,
        groupId: asset?.groupId,
        // 资源中心设备图片（AMOS 跑道图等设备点渲染用；无图为 undefined 走回退图标）
        picturePath: asset?.picturePath,
        // 资产级 3D 模型绑定（monitor_assets.model_3d_id；机场大屏 AMOS 图层 GLB 上屏用，D5 最高优先级）
        model3dId: asset?.model3dId,
      } as MonitorAssetEntity;
    });
}

