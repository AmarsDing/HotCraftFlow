  },
};

// ===================== 雷达产品目录与派生数据（雷达数据整合平台 Phase 1-2，radar 服务 MonitorRadarProductService；Phase 3 工作台消费） =====================
export interface RadarProductEntity {
  id?: number;
  name?: string; // 产品名称（如 CAPPI@3km，唯一）
  productType?: string; // CAPPI/CR/VIL/ET
  baseProduct?: string; // 派生源矩：REF
  params?: Record<string, unknown>; // 产品参数（如 {"height_m":3000}）
  unit?: string; // dBZ/mm/km
  colorTable?: string;
  description?: string;
  isBuiltin?: boolean; // 内置产品不可删除
  enabled?: boolean; // 启用后参与派生管线
  createBy?: number;
  updateBy?: number;
  createTime?: string;
  updateTime?: string;
}

// GetProductData 响应（proto 注解 handler JSON 口径：bytes 字段为 base64 字符串）
export interface RadarProductDataResult {
  product?: RadarProductEntity;
  gridData?: string; // GRID 格式时返回（gridFileBytes 二进制，base64 编码）
  imageUrl?: string; // IMAGE 格式时返回
  geojsonUrl?: string; // GEOJSON 格式时返回
}

export const radarProductService = {
  // 产品目录查询（按类型/关键词/启用状态过滤）
  list(
    opts: {
      productType?: string;
      keyword?: string;
      enabledOnly?: boolean;
      page?: number;
      pageSize?: number;
    } = {},
  ) {
    return request.get<ListResponse<RadarProductEntity>>('/api/v1/monitor/radar/products', {
      params: {
        productType: opts.productType || undefined,
        keyword: opts.keyword || undefined,
        enabledOnly: opts.enabledOnly || undefined,
        page: opts.page ?? 1,
        pageSize: opts.pageSize ?? 100,
      },
    });
  },
  // 获取产品数据（GRID 网格二进制 / IMAGE 图片 / GEOJSON 矢量；scanTime 缺省=最新时次）
  getProductData(
    id: number,
    opts: {
      siteCode?: string;
      scanTime?: string; // RFC3339
      format?: 'GRID' | 'IMAGE' | 'GEOJSON';
    } = {},
  ) {
    return request.get<RadarProductDataResult>(`/api/v1/monitor/radar/products/${id}/data`, {
      params: {
        siteCode: opts.siteCode || undefined,
        scanTime: opts.scanTime || undefined,
        format: opts.format || undefined,
      },
      timeout: 300000,
    });
  },
  // 手动触发产品派生（指定基数据文件，立即走派生管线；baseFileId 缺省=最新时次）
  triggerDerivation(id: number, opts: { baseFileId?: number } = {}) {
    return request.post(`/api/v1/monitor/radar/products/${id}:derive`, {
      baseFileId: opts.baseFileId || undefined,
    });
  },
};

// decodeGridDataBase64 GRID base64 载荷 → ArrayBuffer（gridFileBytes：magic + uint32 头长 + JSON 头 + float32 体数据，前端自行解析头体）
export function decodeGridDataBase64(b64: string): ArrayBuffer {
  const bin = atob(b64);
  const bytes = new Uint8Array(bin.length);
  for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
  return bytes.buffer;
}

// ===================== 雷达产品自定义（雷达数据整合平台 Phase 5，T62-T64，radar 服务 MonitorRadarCustomProductService） =====================
export type RadarCustomProductEntity = CustomProduct;
export type RadarProductTemplateEntity = ProductTemplate;

// 公式校验结果（合法时 variables 为引用变量列表；非法时经 axios 拦截器抛错透出 reason）
export interface RadarCustomFormulaValidateResult {
  valid?: boolean;
  variables?: string[];
}

// 产品预览结果（size×size 行主序合成矩阵 + 有效值域；NaN=非法格点）
export interface RadarCustomProductPreviewResult {
  size?: number;
  values?: number[];
  minValue?: number;
  maxValue?: number;
}

export const radarCustomProductService = {
  // 产品列表（公开 OR 本人；mineOnly=true 仅本人）
  list(opts: { mineOnly?: boolean; keyword?: string; page?: number; pageSize?: number } = {}) {
    return radarCustomProductClient.ListCustomProducts({
      mineOnly: opts.mineOnly || undefined,
      keyword: opts.keyword || undefined,
      page: opts.page ?? 1,
      pageSize: opts.pageSize ?? 10,
    }) as Promise<ListResponse<RadarCustomProductEntity>>;
  },
  get(id: string | number) {
    return radarCustomProductClient.GetCustomProduct({ id: Number(id) }) as Promise<{
      product: RadarCustomProductEntity | undefined;
    }>;
  },
  create(data: Partial<RadarCustomProductEntity>) {
    return radarCustomProductClient.CreateCustomProduct({
      name: data.name || undefined,
      description: data.description || undefined,
      formula: data.formula || undefined,
      baseProducts: data.baseProducts,
      unit: data.unit || undefined,
      colorTable: data.colorTable || undefined,
      public: data.public || undefined,
    }) as Promise<{ product: RadarCustomProductEntity | undefined }>;
  },
  update(id: string | number, data: Partial<RadarCustomProductEntity>) {
    return radarCustomProductClient.UpdateCustomProduct({
      id: Number(id),
      name: data.name || undefined,
      description: data.description || undefined,
      formula: data.formula || undefined,
      baseProducts: data.baseProducts,
      unit: data.unit || undefined,
      colorTable: data.colorTable || undefined,
      public: data.public || undefined,
    }) as Promise<{ product: RadarCustomProductEntity | undefined }>;
  },
  delete(id: string | number) {
    return radarCustomProductClient.DeleteCustomProduct({ id: Number(id) }) as Promise<unknown>;
  },
  // 公式校验（编辑器即时反馈；非法时抛错，message 透出原因）
  validateFormula(formula: string, baseProducts: string[]) {
    return radarCustomProductClient.ValidateCustomFormula({
      formula: formula || undefined,
      baseProducts,
    }) as Promise<RadarCustomFormulaValidateResult>;
  },
  // 产品预览（合成渐变网格逐格计算公式；仅供样式预览，不表示真实气象意义）
  preview(formula: string, baseProducts: string[], size = 64) {
    return radarCustomProductClient.PreviewCustomProduct({
      formula: formula || undefined,
      baseProducts,
      size,
    }) as Promise<RadarCustomProductPreviewResult>;
  },
  // 模板列表（内置在前）
  listTemplates() {
    return radarCustomProductClient.ListProductTemplates({}) as Promise<{
      items: RadarProductTemplateEntity[] | undefined;
      total: number | undefined;
    }>;
  },
  // 从模板创建产品（公式/基产品/单位/色标预填）
  createFromTemplate(templateId: number, name: string, isPublic?: boolean) {
    return radarCustomProductClient.CreateCustomProductFromTemplate({
      templateId,
      name: name || undefined,
      public: isPublic || undefined,
    }) as Promise<{ product: RadarCustomProductEntity | undefined }>;
  },
  // 创建模板（API 创建的均为非内置模板；名称唯一）
  createTemplate(data: Partial<RadarProductTemplateEntity>) {
    return radarCustomProductClient.CreateProductTemplate({
      name: data.name || undefined,
      description: data.description || undefined,
      formula: data.formula || undefined,
      baseProducts: data.baseProducts,
      unit: data.unit || undefined,
      colorTable: data.colorTable || undefined,
    }) as Promise<{ template: RadarProductTemplateEntity | undefined }>;
  },
  // 删除模板（软删；内置模板不可删除）
  deleteTemplate(id: string | number) {
    return radarCustomProductClient.DeleteProductTemplate({ id: Number(id) }) as Promise<unknown>;
  },
};

// ===================== 雷达组网拼图（雷达数据整合平台 Phase 4，T45 后端 / T48 视图，radar 服务 MonitorRadarMosaicService） =====================
export const radarMosaicService = {
  // 生成组网拼图（配置按 name 幂等落库；同配置+同时次结果覆盖写，重生成幂等）
