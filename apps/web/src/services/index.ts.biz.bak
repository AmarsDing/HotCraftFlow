// ---- 风场数据文件（NetCDF v3 元数据；决策 D1：后端自动拉取唯一入口，无上传） ----
export interface WindFieldFileEntity {
  id?: number;
  sourceId?: number;
  sourceCode?: string;
  baseTime?: string;
  forecastHour?: number;
  dimsLon?: number;
  dimsLat?: number;
  dimsLev?: number;
  uMin?: number;
  uMax?: number;
  vMin?: number;
  vMax?: number;
  dataFormat?: string; // NETCDF3
  filePath?: string;
  fileSize?: number;
  rawFileName?: string;
  receiveTime?: string;
  elements?: string[]; // 文件实际包含要素名清单（ingest 打标写入，FR-15b 文件页标签列）
  qualityFlag?: string; // 质量标记：OK/PARTIAL（部分 best-effort 要素缺失）
  createTime?: string;
  remark?: string;
}

/** 综合业务平台风场图层主数据源（全球 0.25°；区域/演示源不进生产展示时间轴） */
export const WIND_PRIMARY_SOURCE_CODE = 'GFS_NOMADS_GLOBAL';

export const windfieldFileService = {
  list(
    opts: {
      page?: number;
      pageSize?: number;
      sourceCode?: string;
      startTime?: string;
      endTime?: string;
      productId?: number;
      elementGroup?: string;
    } = {},
  ) {
    return windfieldClient.ListFiles({
      page: opts.page ?? 1,
      pageSize: opts.pageSize ?? 10,
      sourceCode: opts.sourceCode || undefined,
      startTime: opts.startTime || undefined,
      endTime: opts.endTime || undefined,
      productId: opts.productId || undefined,
      elementGroup: opts.elementGroup || undefined,
    }) as Promise<ListResponse<WindFieldFileEntity>>;
  },
  /**
   * 综合业务平台图层单源帧清单：库里多源并存（GFS/ECMWF/区域调试源），裸 list 会把
   * 不同源（不同地理范围/不同模式）的帧混进同一时间轴，色斑与粒子显示域逐帧跳动。
   * 统一锚定主源 GFS_NOMADS_GLOBAL 最新 N 帧；主源无数据时回退"最新帧所属源"。
   * FR-12 T6 分屏对比：opts.sourceCode 显式钉源（右屏绑源 B / 左屏绑源 A），跳过主源锚定与回退。
   */
  async listLatestSingleSource(opts: { pageSize?: number; sourceCode?: string } = {}) {
    const pageSize = opts.pageSize ?? 10;
    if (opts.sourceCode) return this.list({ page: 1, pageSize, sourceCode: opts.sourceCode });
    const primary = await this.list({ page: 1, pageSize, sourceCode: WIND_PRIMARY_SOURCE_CODE });
    if ((primary.items ?? []).length > 0) return primary;
    const latest = await this.list({ page: 1, pageSize: 1 });
    const code = latest.items?.[0]?.sourceCode;
    if (!code) return latest;
    return this.list({ page: 1, pageSize, sourceCode: code });
  },
  get(id: string | number) {
    return windfieldClient.GetFile({ id: Number(id) }) as Promise<WindFieldFileEntity>;
  },
  // 下载数据文件（复用 admin GET /api/v1/monitor/file:download，决策 D6）
  download(entity: WindFieldFileEntity) {
    if (!entity.filePath) return Promise.resolve();
    const name = entity.rawFileName || `windfield_${entity.id}.nc`;
    return request
      .get<Blob>('/api/v1/monitor/file:download', {
        params: { path: entity.filePath },
        responseType: 'blob',
        timeout: 300000,
      })
      .then((blob) => downloadBlob(blob, name));
  },
  // 拉取数据文件 Blob（预览页行内解析用，不触发浏览器下载）
  fetchBlob(entity: WindFieldFileEntity): Promise<Blob> {
    if (!entity.filePath) return Promise.reject(new Error('filePath missing'));
    return request.get<Blob>('/api/v1/monitor/file:download', {
      params: { path: entity.filePath },
      responseType: 'blob',
      timeout: 300000,
    });
  },
};

// ---- 点值提取（多源整合三期 FR-11：Meteogram/Airgram 数据源，服务端双线性采样+LRU） ----
export interface WindPointLevelValue {
  level?: number; // 气压层 hPa
  value?: number; // 采样值（角点缺测 NaN 传播为缺省）
}

export interface WindPointSeriesItem {
  baseTime?: string; // 起报时间（UTC，RFC3339）
  forecastHour?: number; // 预报时效（小时）；X 轴业务时刻 = baseTime + forecastHour
  value?: number; // 采样值（level!=all；要素缺失/NaN 为缺省）
  fileId?: number;
  qualityFlag?: string; // OK/PARTIAL（PARTIAL 前端置灰）
  values?: WindPointLevelValue[]; // 全层值列（level=all；2D 要素禁 all）
}

export const windfieldPointService = {
  /**
   * 单点要素时间序列（GET /api/v1/monitor/windfield/point-series）。
   * level：缺省/'0'=2D 要素或首层；'>0'=气压层 hPa；'all'=全气压层值列（Airgram，文件上限 48）。
   * 单请求文件上限 96（超出截断 truncated=true）；出域时次缺席（items 缺，不报错）。
   */
  series(opts: {
    sourceId: number;
    lon: number;
    lat: number;
    element: string;
    level?: string;
    from: string; // RFC3339
    to: string; // RFC3339
  }) {
    return windfieldClient.GetPointSeries({
      sourceId: opts.sourceId,
      lon: opts.lon,
      lat: opts.lat,
      element: opts.element,
      level: opts.level || undefined,
      from: opts.from,
      to: opts.to,
    }) as Promise<{
      items: WindPointSeriesItem[] | undefined;
      element?: string;
      unit?: string;
      lon?: number;
      lat?: number;
      truncated?: boolean;
    }>;
  },
};

