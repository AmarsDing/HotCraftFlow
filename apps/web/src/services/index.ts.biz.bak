  // 新建分析（传 alarm_id 自动拉取告警详情并异步启动）
  create: (alarmId: string) => aiopsRcaClient.CreateRcaRecord({ alarmId }) as Promise<AiopsRcaRecordEntity>,
  // 设备维度发起（运维中心 AI 运维弹框）：asset_id+title+description，无告警也可诊断
  createForAsset(data: { assetId?: number; title?: string; description?: string; alarmId?: string }) {
    return aiopsRcaClient.CreateRcaRecord({
      alarmId: data.alarmId || undefined,
      assetId: data.assetId,
