export const analysisTaskService = {
  list(
    opts: {
      page?: number;
      pageSize?: number;
      analysisType?: string;
      status?: string;
      keyword?: string;
      scheduledOnly?: boolean;
    } = {},
  ) {
    return analysisClient.ListAnalysisTasks({
      page: opts.page ?? 1,
      pageSize: opts.pageSize ?? 10,
      analysisType: opts.analysisType || undefined,
      status: opts.status || undefined,
      keyword: opts.keyword || undefined,
      scheduledOnly: opts.scheduledOnly,
    }) as Promise<ListResponse<AnalysisTaskEntity>>;
  },
  get(id: string | number) {
    return analysisClient.GetAnalysisTask({ id: Number(id) }) as Promise<AnalysisTaskEntity>;
  },
  create(data: Partial<AnalysisTaskEntity>) {
    return analysisClient.CreateAnalysisTask({
      name: data.name,
      code: data.code,
      analysisType: data.analysisType,
      modelId: data.modelId,
      targetType: data.targetType || 'device',
      targetIds: data.targetIds,
      metricKeys: data.metricKeys,
      dataStart: data.dataStart,
      dataEnd: data.dataEnd,
      parameters: data.parameters || undefined,
      scheduled: data.scheduled,
      cronExpression: data.cronExpression || undefined,
    }) as Promise<AnalysisTaskEntity>;
  },
  update(id: string | number, data: Partial<AnalysisTaskEntity>) {
    return analysisClient.UpdateAnalysisTask({
      id: Number(id),
      name: data.name,
      modelId: data.modelId,
      targetType: data.targetType || undefined,
      targetIds: data.targetIds,
      metricKeys: data.metricKeys,
      dataStart: data.dataStart,
      dataEnd: data.dataEnd,
      parameters: data.parameters || undefined,
      scheduled: data.scheduled,
      cronExpression: data.cronExpression || undefined,
    }) as Promise<AnalysisTaskEntity>;
  },
  delete(id: string | number) {
    return analysisClient.DeleteAnalysisTask({ id: Number(id) }) as Promise<unknown>;
  },
  run(id: string | number) {
    return analysisClient.RunAnalysisTask({ id: Number(id) }) as Promise<AnalysisTaskEntity>;
  },
  cancel(id: string | number) {
    return analysisClient.CancelAnalysisTask({ id: Number(id) }) as Promise<AnalysisTaskEntity>;
  },
  results(id: string | number, opts: { resultType?: string; limit?: number } = {}) {
    return analysisClient.GetAnalysisTaskResults({
      id: Number(id),
      resultType: opts.resultType || undefined,
      limit: opts.limit ?? 500,
    }) as Promise<{ items?: AnalysisResultItemEntity[]; total?: number }>;
  },
};

