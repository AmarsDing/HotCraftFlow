// ---- 手动处理（自定义端点，不在 proto 内；POST /api/v1/monitor/remediation/manual/process） ----
// 响应为标准信封 {code,message,data}，data 为 snake_case 键（04 侧契约）。
export interface RemediationManualProcessPolicy {
  policy_id?: number;
  policy_name?: string;
  execution_mode?: string;
  execution_id?: number;
}
export interface RemediationManualProcessResult {
  matched_strategies?: number;
  created_executions?: number;
  matched_policies?: RemediationManualProcessPolicy[];
  process_id?: number;
}
interface ManualProcessEnvelope {
  code?: number;
  message?: string;
  data?: RemediationManualProcessResult;
}

export const remediationManualService = {
  async process(alarmId: string): Promise<RemediationManualProcessResult> {
    const resp = await request.post<ManualProcessEnvelope>('/api/v1/monitor/remediation/manual/process', {
      alarm_id: alarmId,
    });
    if (resp && resp.code !== 0) {
      throw new Error(resp.message || 'manual process failed');
    }
    return resp?.data ?? {};
  },
};

