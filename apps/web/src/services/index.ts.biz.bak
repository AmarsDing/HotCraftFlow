  categoryId?: number;
  description?: string;
  keywords?: string;
  manageDeptId?: number;
  currentVersionId?: number;
  downloadCount?: number;
  viewCount?: number;
  status?: number; // 1-正常 0-归档
  remark?: string;
  tagIds?: number[];
  categoryName?: string; // 只读输出
  tags?: DocumentTagEntity[]; // 只读输出
  currentVersion?: DocumentVersionEntity; // 只读输出
}

export const documentService = {
  list(opts: PagingRequest & { formValues?: Record<string, unknown> } = {}) {
    return request.get<ListResponse<DocumentGroupEntity>>('/api/v1/monitor/document-groups', {
      params: buildQueryParams(opts.formValues, opts),
    });
  },
  // 关键字全文搜索（name + keywords，GIN 索引）
  search(opts: { query: string; categoryId?: number; topK?: number }) {
    return request.post<{ items?: DocumentGroupEntity[] }>('/api/v1/monitor/document-groups:search', {
      query: opts.query,
      categoryId: opts.categoryId || undefined,
      topK: opts.topK || undefined,
    });
  },
  get(id: string | number) {
    return request.get<DocumentGroupEntity>(`/api/v1/monitor/document-groups/${id}`);
  },
  update(id: string | number, data: Partial<DocumentGroupEntity>) {
    const updateMask = buildUpdateMask(data as Record<string, unknown>);
    return request.put(`/api/v1/monitor/document-groups/${id}`, { data, updateMask });
  },
  delete(id: string | number) {
    return request.delete(`/api/v1/monitor/document-groups/${id}`);
  },
  // 浏览计数（无请求体的动作型 POST）
  recordView(id: string | number) {
    return request.post(`/api/v1/monitor/document-groups/${id}/view`);
  },
  versions(id: string | number) {
    return request.get<ListResponse<DocumentVersionEntity>>(`/api/v1/monitor/document-groups/${id}/versions`);
  },
  // 首次上传（multipart 手写路由，元数据走 query 参数；tagIds 重复键传递）
  upload(
    file: File,
    meta: {
      name?: string;
      categoryId?: number;
      description?: string;
      keywords?: string;
      manageDeptId?: number;
      tagIds?: number[];
    },
  ) {
    const fd = new FormData();
    fd.append('file', file);
    const qs = new URLSearchParams();
    if (meta.name) qs.set('name', meta.name);
    if (meta.categoryId) qs.set('categoryId', String(meta.categoryId));
    if (meta.description) qs.set('description', meta.description);
    if (meta.keywords) qs.set('keywords', meta.keywords);
    if (meta.manageDeptId) qs.set('manageDeptId', String(meta.manageDeptId));
    for (const id of meta.tagIds ?? []) qs.append('tagIds', String(id));
    const query = qs.toString();
    const url = '/api/v1/monitor/document-groups:upload' + (query ? `?${query}` : '');
    return request.post<{ data?: DocumentGroupEntity }>(url, fd, {
      headers: { 'Content-Type': 'multipart/form-data' },
      timeout: 300000,
    });
  },
  // 上传新版本（版本号留空时后端自动递增 minor）
  uploadVersion(groupId: string | number, file: File, meta: { version?: string; changeLog?: string } = {}) {
    const fd = new FormData();
    fd.append('file', file);
    const params: Record<string, string> = {};
    if (meta.version) params.version = meta.version;
    if (meta.changeLog) params.changeLog = meta.changeLog;
    return request.post<{ data?: DocumentVersionEntity }>(
      `/api/v1/monitor/document-groups/${groupId}/versions:upload`,
      fd,
      { params, headers: { 'Content-Type': 'multipart/form-data' }, timeout: 300000 },
    );
  },
  // 签发 24h 一次性预览 token（JWT 鉴权），供下载/预览白名单 URL 消费
  issuePreviewToken(versionId: string | number) {
    return request.post<{ token?: string; expiresIn?: number }>(
      `/api/v1/monitor/document-versions/${versionId}/preview-token`,
    );
  },
  // 构造带一次性 token 的下载/预览 URL（<iframe>/<img>/新标签无法携带 Authorization 头，§2.9）
  async buildVersionUrl(versionId: string | number, kind: 'preview' | 'download'): Promise<string> {
    const resp = await this.issuePreviewToken(versionId);
    const token = resp?.token;
    if (!token) throw new Error('preview token missing');
    return `/api/v1/monitor/document-versions/${versionId}/${kind}?preview_token=${encodeURIComponent(token)}`;
  },
  // 下载：签发 token 后以隐藏 <a> 触发浏览器下载（attachment）
  async downloadVersion(version: DocumentVersionEntity) {
    if (!version.id) return;
    const url = await this.buildVersionUrl(version.id, 'download');
    const a = document.createElement('a');
    a.href = url;
    a.download = version.fileName || `document_${version.id}`;
    document.body.appendChild(a);
    a.click();
    a.remove();
  },
};

// ===================== 许可证（10-license 子服务，§1.21/§2.6/§3.7） =====================
// 生成客户端为空壳（protoc-gen-typescript-http 未生成方法），按既有手写请求惯例封装。
// 签名模型（§2.6.0）：厂商离线签发，系统仅验签；激活/吊销/导入走动作型 POST。

// 授权模块（licenses.authorized_modules JSON 数组元素）
export interface LicenseModuleItem {
  moduleCode?: string;
  moduleName?: string;
  maxUsers?: number;
}

// 许可证（licenses）
export interface LicenseEntity extends CrudEntity {
  licenseNo?: string;
  customerName?: string;
  contactName?: string;
  contactPhone?: string;
  contactEmail?: string;
  authorizedModules?: LicenseModuleItem[];
  authorizedDevices?: number;
  maxUsers?: number;
  startDate?: string; // yyyy-MM-dd
  expireDate?: string; // yyyy-MM-dd
  machineFingerprint?: string;
  signature?: string;
  status?: string; // pending-待激活 active-已激活 expired-已过期 revoked-已吊销
  activatedAt?: string;
  revokedAt?: string;
  revokedReason?: string;
  remark?: string;
}

// 导出申请文件响应（JSON 文本，前端触发下载后交付厂商离线签发）
export interface LicenseApplicationFile {
  fileName?: string;
  content?: string;
}

// 许可证验证响应（§2.6.8：硬失败立即受限，软失败仅告警通知）
export interface LicenseVerifyResult {
  valid?: boolean;
  hardFailReason?: string; // not_found/inactive/expired/revoked/signature_invalid/fingerprint_mismatch
  softFailReasons?: string[]; // device_limit_exceeded/user_limit_exceeded
  license?: LicenseEntity;
  verifiedAt?: string;
}

// 使用统计项（按使用类型分组，§2.6.7）
export interface LicenseUsageStatItem {
  usageType?: string; // module_access/device_registration/user_login
  totalCount?: number;
}

// 授权概览（配额看板：当前生效许可证 + 实时用量 + 剩余天数）
export interface LicenseOverview {
  activeLicense?: LicenseEntity;
  deviceCount?: number;
  userCount?: number;
  daysRemaining?: number;
  quotaWarning?: boolean; // 设备或用户用量 >= 授权上限 90%（含超限）
}

// 验证审计日志条目（license_verification_logs，§1.24）
export interface LicenseVerificationLogEntity extends CrudEntity {
  licenseId?: number;
  licenseNo?: string;
  result?: string; // success-通过 failed-失败
  failReason?: string; // 硬失败原因码或软失败原因逗号串
  detail?: string; // 验证详情 JSON 文本（caller/check_type/verified_at/soft_fail_reasons）
  verifiedAt?: string;
}

export const licenseService = {
  list(opts: PagingRequest & { formValues?: Record<string, unknown> } = {}) {
    return request.get<ListResponse<LicenseEntity>>('/api/v1/monitor/licenses', {
      params: buildQueryParams(opts.formValues, opts),
    });
  },
  get(id: string | number) {
    return request.get<LicenseEntity>(`/api/v1/monitor/licenses/${Number(id)}`);
  },
  // 创建申请（signature 空串占位、status=pending 由后端落库）
  create(data: Partial<LicenseEntity>) {
    return request.post('/api/v1/monitor/licenses', { data });
  },
  // 已签发记录仅 remark/contact_* 可改（后端强制，§2.6.1 第 4 条）
  update(id: string | number, data: Partial<LicenseEntity>) {
    const updateMask = buildUpdateMask(data as Record<string, unknown>);
    return request.put(`/api/v1/monitor/licenses/${Number(id)}`, { data, updateMask });
  },
  // 仅允许 pending 且未签发的申请（后端强制，软删）
  delete(id: string | number) {
    return request.delete(`/api/v1/monitor/licenses/${Number(id)}`);
  },
  // 导出申请文件（下载 JSON 交付厂商；续期场景复用）
  exportApplication(id: string | number) {
    return request.get<LicenseApplicationFile>(`/api/v1/monitor/licenses/${Number(id)}/request-file`);
  },
  // 导入厂商签发文件（验签 + 指纹校验；失败由拦截器抛出后端具体原因）
  importSigned(id: string | number, fileContent: string) {
    return request.post(`/api/v1/monitor/licenses/${Number(id)}/import`, { fileContent });
  },
  // 激活（pending → active）
  activate(id: string | number) {
    return request.post(`/api/v1/monitor/licenses/${Number(id)}/activate`);
  },
  // 吊销（active → revoked，本地操作即时生效）
  revoke(id: string | number, reason: string) {
    return request.post(`/api/v1/monitor/licenses/${Number(id)}/revoke`, { reason });
  },
  // 验证（caller=manual，§2.6.3）
  verify(licenseNo: string) {
    return request.post<LicenseVerifyResult>('/api/v1/monitor/licenses/verify', {
      licenseNo,
      caller: 'manual',
    });
  },
  // 使用统计（§2.6.7；licenseId 为空统计全部）
  usage(opts: { licenseId?: number; startDate?: string; endDate?: string } = {}) {
    return request.get<{ items?: LicenseUsageStatItem[] }>('/api/v1/monitor/licenses/usage', {
      params: {
        licenseId: opts.licenseId || undefined,
        startDate: opts.startDate || undefined,
        endDate: opts.endDate || undefined,
      },
    });
  },
  // 本机机器指纹（详情抽屉一键复制，便于线下与厂商核对）
  getMachineFingerprint() {
    return request.get<{ machineFingerprint?: string }>('/api/v1/monitor/licenses/machine-fingerprint');
  },
  // 授权概览（配额看板数据源）
  overview() {
    return request.get<LicenseOverview>('/api/v1/monitor/licenses/overview');
  },
  // 验证审计日志分页查询（支持 licenseNo/result/verifiedAt 过滤）
  verificationLogs(opts: PagingRequest & { formValues?: Record<string, unknown> } = {}) {
    return request.get<ListResponse<LicenseVerificationLogEntity>>('/api/v1/monitor/licenses/verification-logs', {
      params: buildQueryParams(opts.formValues, opts),
    });
  },
};

