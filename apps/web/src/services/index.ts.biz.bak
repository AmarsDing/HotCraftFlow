  serviceDist?: GatewayDashboardSvcDist[];
}

// 网关层拦截流量的哨兵服务名（后端 biz.RejectedXxx 写入 access log service_name 列）：
// 维护模式/许可受限/IP 规则/认证/限流/无路由拦截的请求无法归属真实服务，
// 仪表盘服务分布与访问日志列表以此映射本地化标签展示。
export const GATEWAY_REJECTED_LABEL: Record<string, string> = {
  '_rejected:maintenance': 'gateway.rejectedMaintenance',
  '_rejected:license_restricted': 'gateway.rejectedLicense',
  '_rejected:ip_rule': 'gateway.rejectedIpRule',
  '_rejected:auth': 'gateway.rejectedAuth',
  '_rejected:rate_limit': 'gateway.rejectedRateLimit',
  '_rejected:no_route': 'gateway.rejectedNoRoute',
};

export const gatewayDashboardService = {
  stats(range: string = '1h') {
    return request.get<GatewayDashboardStats>(`${GW_BASE}/dashboard`, { params: { range } });
  },
};

// ===================== virtman（15 容器与虚拟化管理，Phase 5.5） =====================
// 薄服务手写 net/http（无 proto），响应信封 {code:0,message:"success",data}，此处统一解包。
const VIRT_BASE = '/api/v1/monitor/virtman';

export interface VirtEnvelope<T> {
  code: number;
  message: string;
  data: T;
}
const unwrapVirt = <T>(p: Promise<VirtEnvelope<T>>) => p.then((r) => r.data);

// 端点状态：available-可用 / abnormal-采集异常 / unavailable-不可达
export interface VirtmanEndpointEntity {
  id?: number;
  name?: string;
  host?: string;
  port?: number;
  protocol?: string; // socket / tcp / tcp+tls
  status?: string;
  is_local?: boolean;
  // 宿主机监控资产绑定（接入中心登记；容器未显式绑定时继承此资产身份）
  asset_id?: number;
  asset_name?: string;
  asset_code?: string;
  has_credential?: boolean;
  docker_version?: string;
  api_version?: string;
  last_test_at?: string;
  last_error?: string;
  remark?: string;
  created_at?: string;
  updated_at?: string;
}

export interface VirtmanEndpointTestResult {
  success?: boolean;
  status?: string;
  docker_version?: string;
  api_version?: string;
  error?: string;
}

// 端点创建/更新入参（TLS 三件套仅 tcp+tls 需要，明文提交后端加密落库）
export interface VirtmanEndpointInput {
  name: string;
  host: string;
  port: number;
  protocol: string;
  tls_ca_cert?: string;
  tls_cert?: string;
  tls_key?: string;
  remark?: string;
}

export interface VirtmanContainerEntity {
  id?: number;
  endpoint_id?: number;
  container_id?: string;
  name?: string;
  image?: string;
  image_id?: string;
  state?: string; // running / exited / paused / created / restarting / dead
  status_text?: string;
  ports?: unknown;
  env?: unknown;
  mounts?: unknown;
  restart_policy?: string;
  memory_limit_mb?: number;
  cpu_shares?: number;
  cmd?: string;
  entrypoint?: string;
  labels?: unknown;
  asset_id?: number;
  // 资产联表只读冗余（悬停详情/名称展示）
  asset_name?: string;
  asset_code?: string;
  asset_ip?: string;
  // 端点宿主机资产（容器未显式绑定时的继承来源）
  endpoint_asset_id?: number;
  endpoint_asset_name?: string;
  started_at?: string;
  finished_at?: string;
  container_created_at?: string;
  last_sync_at?: string;
  created_at?: string;
  updated_at?: string;
}

export interface VirtmanContainerMetrics {
  endpoint_id?: number;
  container_id?: string;
  container_name?: string;
  image?: string;
  asset_id?: number;
  state?: string;
  cpu_percent?: number;
  memory_usage_mb?: number;
  memory_limit_mb?: number;
  memory_percent?: number;
  network_rx_kbps?: number;
  network_tx_kbps?: number;
  pids?: number;
  timestamp?: string;
}

// WS type=state 状态变更事件（PublishStateChange 联动 hub 即时下发，不经 stats 节流）
export interface VirtmanContainerStateEvent {
  endpoint_id?: number;
  container_id?: string;
  name?: string;
  old_state?: string;
  new_state?: string;
  reason?: string;
  operation?: string;
  timestamp?: string;
}

export const virtmanEndpointService = {
  list() {
    return unwrapVirt(
      request.get<VirtEnvelope<{ items: VirtmanEndpointEntity[]; total: number }>>(`${VIRT_BASE}/endpoints`),
    );
  },
  create(data: VirtmanEndpointInput) {
    return unwrapVirt(request.post<VirtEnvelope<VirtmanEndpointEntity>>(`${VIRT_BASE}/endpoints`, data));
  },
  update(id: number, data: VirtmanEndpointInput) {
    return unwrapVirt(request.put<VirtEnvelope<unknown>>(`${VIRT_BASE}/endpoints/${id}`, data));
  },
  delete(id: number) {
    return unwrapVirt(request.delete<VirtEnvelope<unknown>>(`${VIRT_BASE}/endpoints/${id}`));
  },
  // 连通性测试（Ping + ServerVersion 回填）
  test(id: number) {
    return unwrapVirt(request.post<VirtEnvelope<VirtmanEndpointTestResult>>(`${VIRT_BASE}/endpoints/${id}/test`));
  },
  // 立即全量同步该端点容器清单
  refresh(id: number) {
    return unwrapVirt(request.post<VirtEnvelope<unknown>>(`${VIRT_BASE}/endpoints/${id}/refresh`));
  },
  // 绑定/解绑宿主机监控资产（assetId null = 解绑；容器未显式绑定时继承此资产）
  bindAsset(id: number, assetId: number | null) {
    return unwrapVirt(request.post<VirtEnvelope<unknown>>(`${VIRT_BASE}/endpoints/${id}/asset`, { asset_id: assetId }));
  },
};

// 创建容器入参（POST /containers；restart_policy ∈ no/always/on-failure/unless-stopped，0=不限/默认）
export interface VirtmanContainerCreateInput {
  endpoint_id: number;
  image: string;
  name: string;
  ports?: string[];
  env?: string[];
  mounts?: string[];
  restart_policy?: string;
  memory_limit_mb?: number;
  cpu_shares?: number;
}

// 容器生命周期操作回执（start/stop/restart）：status=ok/failed；
// failed 时附退出码/daemon 状态错误/OOM 标记/最近日志尾部（破除"操作成功但没起来"黑盒）。
export interface VirtmanContainerOperateResult {
  status?: string; // ok / failed
  op?: string;
  state?: string;
  status_text?: string;
  exit_code?: number;
  state_error?: string;
  oom_killed?: boolean;
  log_tail?: string;
}

// 列表统计卡（与列表同 endpoint/keyword 过滤，不含 state 过滤）
export interface VirtmanContainerStateCounts {
  total?: number;
  by_state?: Record<string, number>;
  unbound?: number; // 未绑定资产（显式绑定与端点继承均无）
  exit_fail?: number; // 非 0 退出码（Exited (N!=0)）
}

// 指标历史时序（GET /containers/{id}/metrics）
export interface VirtmanMetricPoint {
  ts: string;
  val: number;
}
export interface VirtmanMetricSeries {
  key: string;
  name: string;
  unit: string;
  points: VirtmanMetricPoint[];
}

export const virtmanContainerService = {
  list(
    opts: {
      page?: number;
      pageSize?: number;
      endpointId?: number;
      keyword?: string;
      state?: string;
    } = {},
  ) {
    return unwrapVirt(
      request.get<
        VirtEnvelope<{ items: VirtmanContainerEntity[]; total: number; state_counts?: VirtmanContainerStateCounts }>
      >(`${VIRT_BASE}/containers`, {
        params: {
          page: opts.page ?? 1,
          pageSize: opts.pageSize ?? 10,
          endpoint_id: opts.endpointId || undefined,
          keyword: opts.keyword || undefined,
          state: opts.state || undefined,
        },
      }),
    );
  },
  get(id: number) {
    return unwrapVirt(request.get<VirtEnvelope<VirtmanContainerEntity>>(`${VIRT_BASE}/containers/${id}`));
  },
  // 创建容器（创建不自动启动；ports "8080:80"、env "K=V"、mounts "/host:/container" 或 "vol:/container"）
  create(input: VirtmanContainerCreateInput) {
    return unwrapVirt(request.post<VirtEnvelope<VirtmanContainerEntity>>(`${VIRT_BASE}/containers`, input));
  },
  // 生命周期操作（DELETE = remove 强制删除）；start/stop/restart 返回终态回执（failed 附诊断）
  operate(id: number, op: 'start' | 'stop' | 'restart', timeout = 10) {
    return unwrapVirt(
      request.post<VirtEnvelope<VirtmanContainerOperateResult>>(`${VIRT_BASE}/containers/${id}/${op}`, null, {
        params: { timeout },
      }),
    );
  },
  remove(id: number) {
    return unwrapVirt(request.delete<VirtEnvelope<unknown>>(`${VIRT_BASE}/containers/${id}`));
  },
  // 最新指标快照（hub 缓存优先，无缓存一次性实时采集兜底）
  stats(id: number) {
    return unwrapVirt(request.get<VirtEnvelope<VirtmanContainerMetrics>>(`${VIRT_BASE}/containers/${id}/stats`));
  },
  // 指标历史时序（图表；windowMinutes 默认 60，上限 1440）
  metrics(id: number, windowMinutes = 60) {
    return unwrapVirt(
      request.get<VirtEnvelope<{ series: VirtmanMetricSeries[] }>>(`${VIRT_BASE}/containers/${id}/metrics`, {
        params: { window_minutes: windowMinutes },
      }),
    ).then((d) => d.series ?? []);
  },
  // 日志快照（text/plain 流，非信封）
  logs(id: number, tail = 200, timestamps = false) {
    return request.get<string>(`${VIRT_BASE}/containers/${id}/logs`, {
      params: { tail, timestamps },
      responseType: 'text',
      transformResponse: (v: unknown) => v,
    });
  },
  // 绑定/解绑监控资产（assetId null = 解绑）
  bindAsset(id: number, assetId: number | null) {
    return unwrapVirt(request.put<VirtEnvelope<unknown>>(`${VIRT_BASE}/containers/${id}/asset`, { asset_id: assetId }));
  },
};

// ---- 容器周期统计（24-统计分析与AI洞察 S1-T1.5/T1.8，设计 §4.2；端点子动作 GET 只读） ----

// 单时间桶统计点（cpu/mem 为使用率 %，rx/tx 为 KB/s）
export interface VirtmanContainerStatsPoint {
  t?: string;
  cpu_avg?: number;
  cpu_max?: number;
  mem_avg?: number;
  mem_p95?: number;
  rx_avg?: number;
  tx_avg?: number;
}

// 单容器历史序列
export interface VirtmanContainerStatsSeries {
  container_id?: string;
  container_name?: string;
  image?: string;
  points?: VirtmanContainerStatsPoint[];
}

// 饱和度 TopN 项（按 mem_p95 降序）
export interface VirtmanContainerSaturation {
  container_name?: string;
  mem_p95?: number;
  cpu_avg?: number;
}

// compose 项目用量（container_name `{project}-` 前缀归组；命名约定失效时后端降级为空榜）
export interface VirtmanComposeUsage {
  project?: string;
  cpu_sum?: number;
  mem_sum_mb?: number;
}

// 容器平台周期汇总（Tab3 KPI 区）
export interface VirtmanContainerStatsSummary {
  total?: number;
  running?: number;
  restart_events?: number; // 异常重启（exited/dead→running）
  restart_events_user?: number; // 人工重启（operation=restart）
  prev_restart_events?: number; // 等长前窗异常重启（环比）
  saturation_top?: VirtmanContainerSaturation[];
  compose_usage?: VirtmanComposeUsage[];
}

export const virtmanContainerStatsService = {
  // 历史统计：端点全量（或 containerId 单容器）六统计列时序；granularity raw/1m/1h/1d 空=后端按窗长路由
  history(endpointId: number, opts: { containerId?: string; start?: string; end?: string; granularity?: string } = {}) {
    return unwrapVirt(
      request.get<VirtEnvelope<{ items: VirtmanContainerStatsSeries[] }>>(
        `${VIRT_BASE}/endpoints/${endpointId}/containers/stats/history`,
        {
          // 8h×1m 聚合实测 ~40s，显式 60s 覆盖 axios 默认 30s（对齐网关路由 timeout_ms=60000）
          timeout: 60000,
          params: {
            container_id: opts.containerId || undefined,
            start: opts.start || undefined,
            end: opts.end || undefined,
            granularity: opts.granularity || undefined,
          },
        },
      ),
    ).then((d) => d.items ?? []);
  },
  // 周期汇总：总量/运行中 + 重启事件（异常/人工/环比）+ 饱和度 TopN + compose 用量
  summary(endpointId: number, opts: { start?: string; end?: string } = {}) {
    return unwrapVirt(
      request.get<VirtEnvelope<VirtmanContainerStatsSummary>>(
        `${VIRT_BASE}/endpoints/${endpointId}/containers/stats/summary`,
        // 同 history：8h 窗口聚合可能超 axios 默认 30s，显式 60s
        { timeout: 60000, params: { start: opts.start || undefined, end: opts.end || undefined } },
      ),
    );
  },
};

// stats WS 推送地址（浏览器 WebSocket 无法自定义请求头，走 ?token= 查询参数）
export function virtmanStatsWsUrl(endpointId: number, containerId?: string): string {
  const proto = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
  const token = localStorage.getItem('twin_access_token') ?? '';
  let url = `${proto}//${window.location.host}${VIRT_BASE}/ws/containers/stats?endpoint_id=${endpointId}&token=${encodeURIComponent(token)}`;
  if (containerId) url += `&container_id=${encodeURIComponent(containerId)}`;
  return url;
}

// 容器流式日志 WS 地址（tail 100–5000；timestamps=true 时服务端解析行首时间戳）
export function virtmanLogsWsUrl(endpointId: number, containerId: string, tail = 500, timestamps = false): string {
  const proto = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
  const token = localStorage.getItem('twin_access_token') ?? '';
  return `${proto}//${window.location.host}${VIRT_BASE}/ws/containers/logs?endpoint_id=${endpointId}&container_id=${encodeURIComponent(containerId)}&tail=${tail}&timestamps=${timestamps}&token=${encodeURIComponent(token)}`;
}

