// ===================== Collector: 采集失败记录 =====================
export interface CollectionFailureEntity extends CrudEntity {
  deviceId?: number;
  taskId?: number;
  protocolType?: string;
  errorType?: string;
  errorMessage?: string;
  errorStack?: string;
  retryCount?: number;
  maxRetry?: number;
  durationMs?: number;
  nodeId?: number;
  rawResponse?: string;
  resolved?: boolean;
  resolvedAt?: string;
  // 后端 proto 字段为 created_at（json_name createdAt），与 CrudEntity.createTime 命名不同
  createdAt?: string;
}
export const failureService = {
  listDeviceFailures(
    deviceId: string | number,
    opts: {
      errorType?: string;
      unresolvedOnly?: boolean;
      page?: number;
      pageSize?: number;
    } = {},
  ) {
    return failureClient.ListDeviceFailures({
      deviceId: Number(deviceId),
      errorType: opts.errorType,
      unresolvedOnly: opts.unresolvedOnly,
      page: opts.page,
      pageSize: opts.pageSize,
    }) as Promise<ListResponse<CollectionFailureEntity>>;
  },
  list(
    opts: {
      errorType?: string;
      resolved?: boolean;
      deviceId?: number;
      taskId?: number;
      page?: number;
      pageSize?: number;
      formValues?: Record<string, unknown>;
    } = {},
  ) {
    // 手拼查询串而非走生成客户端：protoc-gen-typescript-http 对 optional 字段做真值判断，
    // resolved=false（筛"未解决"）会被静默丢弃；deviceId/taskId 为后补参数同样需显式透传。
    const params = buildQueryParams(opts.formValues, opts);
    const qs = new URLSearchParams();
    if (opts.errorType) qs.set('errorType', opts.errorType);
    if (opts.resolved !== undefined) qs.set('resolved', String(opts.resolved));
    if (opts.deviceId) qs.set('deviceId', String(opts.deviceId));
    if (opts.taskId) qs.set('taskId', String(opts.taskId));
    qs.set('page', params.page ?? String(opts.page ?? 1));
    qs.set('pageSize', params.pageSize ?? String(opts.pageSize ?? 10));
    // 前导斜杠不可省：相对路径会基于当前路由解析（/collector/failure → /collector/api/... 404）
    return request.get(`/api/v1/monitor/collector/failures?${qs.toString()}`) as Promise<
      ListResponse<CollectionFailureEntity>
    >;
  },
  resolve(id: string | number) {
    return failureClient.ResolveFailure({ failureId: Number(id) });
  },
  // 手动清空失败记录（olderThanDays=0 清全部；onlyResolved 仅清已解决）
  clearFailures(data: { olderThanDays?: number; onlyResolved?: boolean }) {
    return failureClient.ClearFailures(data) as Promise<{ deleted?: number }>;
  },
  // 日志保留设置（yaml 默认 + DB 运行时覆盖）
  getRetentionSettings() {
    return failureClient.GetRetentionSettings({}) as Promise<RetentionSettingsEntity>;
  },
  updateRetentionSettings(data: {
    enabled?: boolean;
    failuresDays?: number;
    trapDays?: number;
    batchSize?: number;
  }) {
    return failureClient.UpdateRetentionSettings(data) as Promise<unknown>;
  },
  // 立即执行一轮清理（同步返回两表删除行数）
  runRetentionNow() {
    return failureClient.RunRetentionNow({}) as Promise<{ failuresDeleted?: number; trapDeleted?: number }>;
  },
};

// 日志保留设置（yaml 默认 + collector_retention_settings 单行覆盖）
