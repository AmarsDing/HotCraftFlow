    return assetLifecycleClient.ListAssets(buildPaging(opts)) as Promise<ListResponse<BusinessAssetEntity>>;
  },
  // 维护记录
  listMaintenanceRecords(opts: PagingRequest & { formValues?: Record<string, unknown> } = {}) {
    return assetLifecycleClient.ListMaintenanceRecords(buildPaging(opts)) as Promise<
      ListResponse<AssetMaintenanceRecordEntity>
    >;
  },
  getMaintenanceRecord(id: string | number) {
    return assetLifecycleClient.GetMaintenanceRecord({ id: Number(id) }) as Promise<AssetMaintenanceRecordEntity>;
  },
  createMaintenanceRecord(data: Partial<AssetMaintenanceRecordEntity>) {
    return assetLifecycleClient.CreateMaintenanceRecord({ data: data as never }) as Promise<unknown>;
  },
  updateMaintenanceRecord(id: string | number, data: Partial<AssetMaintenanceRecordEntity>) {
    const updateMask = buildUpdateMask(data as Record<string, unknown>);
    return assetLifecycleClient.UpdateMaintenanceRecord({
      id: Number(id),
      data: data as never,
      updateMask,
    }) as Promise<unknown>;
  },
  deleteMaintenanceRecord(id: string | number) {
    return assetLifecycleClient.DeleteMaintenanceRecord({ id: Number(id) }) as Promise<unknown>;
  },
  executeMaintenanceRecord(
    id: string | number,
    data: { actualDate?: string; executor?: string; result?: string; cost?: number; usedParts?: PartUsageItem[] },
  ) {
    // 生成类型中 usedParts 为必选属性（可空数组），且 actualDate 为 wellKnownTimestamp(string)
    return assetLifecycleClient.ExecuteMaintenanceRecord({
      id: Number(id),
      actualDate: data.actualDate,
      executor: data.executor,
      result: data.result,
      cost: data.cost,
      usedParts: (data.usedParts ?? []) as never,
    }) as Promise<unknown>;
  },
  getMaintenanceSummary(assetId?: number) {
    return assetLifecycleClient.GetMaintenanceSummary({ assetId }) as Promise<MaintenanceSummary>;
  },
  // 报废记录
  listScrapRecords(opts: PagingRequest & { formValues?: Record<string, unknown> } = {}) {
    return assetLifecycleClient.ListScrapRecords(buildPaging(opts)) as Promise<ListResponse<AssetScrapRecordEntity>>;
  },
  getScrapRecord(id: string | number) {
    return assetLifecycleClient.GetScrapRecord({ id: Number(id) }) as Promise<AssetScrapRecordEntity>;
  },
  createScrapRecord(data: Partial<AssetScrapRecordEntity>) {
    return assetLifecycleClient.CreateScrapRecord({ data: data as never }) as Promise<unknown>;
  },
  approveScrapRecord(id: string | number, approved: boolean, approvalComment?: string) {
    return assetLifecycleClient.ApproveScrapRecord({ id: Number(id), approved, approvalComment }) as Promise<unknown>;
  },
  executeScrapRecord(id: string | number, data: { scrapValue?: number; scrapValueCurrency?: string } = {}) {
    return assetLifecycleClient.ExecuteScrapRecord({ id: Number(id), ...data }) as Promise<unknown>;
  },
  deleteScrapRecord(id: string | number) {
    return assetLifecycleClient.DeleteScrapRecord({ id: Number(id) }) as Promise<unknown>;
  },
  // 计量检定记录
  listCalibrationRecords(opts: PagingRequest & { formValues?: Record<string, unknown> } = {}) {
    return assetLifecycleClient.ListCalibrationRecords(buildPaging(opts)) as Promise<
      ListResponse<AssetCalibrationRecordEntity>
    >;
  },
