  insights?: InsightItemEntity[];
  insightsDegraded?: string[];
  // 预览图表结构化产物（P1 图形化，前端 echarts 消费；与 markdown 章节表格同源同序）
  charts?: PreviewChartItem[];
}

// 预览图表（声明式渲染器无关描述，与后端 report.v1.ChartItem 同构）
export interface PreviewChartItem {
  id?: string;
  kind?: string; // bar/line/pie
  title?: string;
  unit?: string;
  sectionTitle?: string;
  labels?: string[];
  series?: { name?: string; values?: number[] }[];
}

async function toExportBlob(data: Blob | Record<string, unknown> | string): Promise<Blob> {
  if (data instanceof Blob) {
    if (data.type.includes('json') || data.size < 4096) {
      const text = await data.text();
      const trimmed = text.trim();
      if (trimmed.startsWith('{')) {
        try {
          const parsed = JSON.parse(trimmed) as { kind?: string; message?: string };
          if (parsed.kind === 'twinmonitor-report-template') {
            return new Blob([trimmed], { type: 'application/json' });
          }
          if (parsed.message && !parsed.kind) {
            throw new Error(parsed.message);
          }
        } catch (err) {
          if (err instanceof Error && err.message && !err.message.startsWith('Unexpected')) throw err;
        }
      }
    }
    return data;
  }
  if (typeof data === 'string') return new Blob([data], { type: 'application/json' });
  return new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
}

export const reportTemplateService = {
  list(
    opts: {
      page?: number;
      pageSize?: number;
      keyword?: string;
      reportType?: string;
      businessDomain?: string;
      status?: number;
    } = {},
  ) {
    return monitorReportClient.ListTemplates({
      page: opts.page ?? 1,
      pageSize: opts.pageSize ?? 10,
      keyword: opts.keyword || undefined,
      reportType: opts.reportType || undefined,
      businessDomain: opts.businessDomain || undefined,
      // -1 全部（后端 >=0 才过滤）；生成客户端对 0 不发参，后端 proto 默认 0 等效过滤禁用，语义一致
      status: opts.status ?? -1,
    }) as Promise<ListResponse<ReportTemplateEntity>>;
  },
  get(id: string | number) {
    return monitorReportClient.GetTemplate({ id: Number(id) }) as Promise<ReportTemplateEntity>;
  },
  create(data: Partial<ReportTemplateEntity>) {
    return monitorReportClient.CreateTemplate({ data: data as never }) as Promise<unknown>;
  },
  update(id: string | number, data: Partial<ReportTemplateEntity>) {
    return monitorReportClient.UpdateTemplate({ id: Number(id), data: data as never }) as Promise<unknown>;
  },
  delete(id: string | number) {
    return monitorReportClient.DeleteTemplate({ id: Number(id) }) as Promise<unknown>;
  },
  // 克隆派生 T2 用户模板（06 文档 §4.1「克隆即所得」：T2 唯一创建入口；parent_code 溯源根 T1）
  clone(id: string | number, name: string, code: string) {
    return monitorReportClient.CloneTemplate({ id: Number(id), name, code }) as Promise<ReportTemplateEntity>;
  },
  // 恢复为系统模板（06 文档 §4.4：parent_code 指向的 T1 内容覆盖本 T2 配置，保留 name/code/status）
  reset(id: string | number) {
    return monitorReportClient.ResetTemplate({ id: Number(id) }) as Promise<ReportTemplateEntity>;
  },
  // 手动生成（创建任务入队，异步执行）
  generate(
    id: string | number,
    opts: {
      statisticCycle?: string;
      statisticStart?: string;
      statisticEnd?: string;
      outputFormat?: string;
      reportName?: string;
    } = {},
  ) {
    return monitorReportClient.GenerateReport({
      id: Number(id),
      statisticCycle: opts.statisticCycle || undefined,
      statisticStart: opts.statisticStart || undefined,
      statisticEnd: opts.statisticEnd || undefined,
      outputFormat: opts.outputFormat || undefined,
      reportName: opts.reportName || undefined,
    }) as Promise<GenerateReportResult>;
  },
  // 预览（实时取数渲染 markdown 返回，不落库）；
  // configOverride 未保存配置覆盖（P1 设计器所见即所得：仅消费 dataSource/statisticCycle
  // 与 field/style/filter/chart 四配置键，后端渲染前合并，不落库）
  preview(
    id: string | number,
    opts: {
      statisticStart?: string;
      statisticEnd?: string;
      configOverride?: Record<string, unknown>;
    } = {},
  ) {
    return monitorReportClient.PreviewTemplate({
      id: Number(id),
      statisticStart: opts.statisticStart || undefined,
      statisticEnd: opts.statisticEnd || undefined,
      configOverride: opts.configOverride || undefined,
    }) as Promise<PreviewReportResult>;
  },
  // 上传 docx 模板文档（multipart 手写路由，字段 file；Bearer 经 axios 拦截器注入）。
  // 响应含占位符校验结果 inspection（上传即校验，未识别键仅警告不阻断）
  uploadTemplateFile(id: string | number, file: File) {
    const fd = new FormData();
    fd.append('file', file);
    return request.post<TemplateFileUploadResult>(`/api/v1/monitor/report/templates/${Number(id)}/template-file`, fd, {
      headers: { 'Content-Type': 'multipart/form-data' },
      timeout: 120000,
    });
  },
  // 删除已配置的模板文档（清除 style_config.template_file 并删除服务端文件）
  deleteTemplateFile(id: string | number) {
    return request.delete<unknown>(`/api/v1/monitor/report/templates/${Number(id)}/template-file`);
  },
  // docx 占位符目录（P1 设计器占位符面板；权威清单由后端 render 包同口径产出）
  listDocxPlaceholders() {
    return request.get<DocxPlaceholderListResult>('/api/v1/monitor/report/docx-placeholders');
  },
  // 导出模板为 .twreport.json（P2 模板工程化：机场间风格分享）。
  // 成功体是附件字节；若被当成 JSON 对象返回，仍按载荷落盘。立刻 revokeObjectURL 会让下载还没开始就被回收。
  async exportTemplate(id: string | number, code?: string) {
    const data = await request.get<Blob | Record<string, unknown>>(
      `/api/v1/monitor/report/templates/${Number(id)}/export`,
      { responseType: 'blob' },
    );
    const blob = await toExportBlob(data);
    const filename = `${(code || 'template').replace(/[\\/:*?"<>|]/g, '_')}.twreport.json`;
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    a.style.display = 'none';
    document.body.appendChild(a);
    a.click();
    window.setTimeout(() => {
      a.remove();
      URL.revokeObjectURL(url);
    }, 1500);
  },
  // 导入 .twreport.json（multipart 字段 file；后端强制 is_system=0、parent_code 空，编码冲突自动 _imp 后缀）
  importTemplate(file: File) {
    const fd = new FormData();
    fd.append('file', file);
    return request.post<TemplateImportResult>('/api/v1/monitor/report/templates/import', fd, {
      headers: { 'Content-Type': 'multipart/form-data' },
      timeout: 60000,
    });
  },
  // 下载示例 docx 模板（含全部占位符 + 速查附页；blob 走 blobUrl 触发浏览器保存）
  async downloadDocxSample() {
    const resp = await request.get<Blob>('/api/v1/monitor/report/docx-sample', { responseType: 'blob' });
    const url = URL.createObjectURL(resp as unknown as Blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'report-template-sample.docx';
    a.click();
    URL.revokeObjectURL(url);
  },
};

// docx 模板文档上传响应（手写路由 template_file.go；inspection=上传即校验结果）
export interface TemplateFileUploadResult {
  templateFile: string;
  inspection?: {
    recognized?: string[];
    unrecognized?: string[];
    tableAnchors?: string[];
  };
}

// docx 占位符目录条目（/docx-placeholders；key=占位符原文，kind=scalar/table/ai）
export interface DocxPlaceholderItem {
  key: string;
  kind: string;
  example: string;
  desc: string;
}
export interface DocxPlaceholderListResult {
  items: DocxPlaceholderItem[];
}

// 模板导入结果（POST /templates/import；code 为去重后实际编码）
export interface TemplateImportResult {
  id: number;
  name: string;
  code: string;
}

// ---- 生成任务 ----
export interface ReportTaskEntity {
  id?: number;
  taskNo?: string;
  templateId?: number;
  templateName?: string;
  scheduledTaskId?: number;
  reportName?: string;
  reportType?: string;
  outputFormat?: string;
  statisticCycle?: string;
  statisticStart?: string;
  statisticEnd?: string;
  status?: string; // pending/generating/completed/failed/cancelled
  progress?: number;
  filePath?: string;
  fileSize?: number;
  errorMessage?: string;
  retryCount?: number;
  maxRetry?: number;
  startedAt?: string;
  completedAt?: string;
  generatedBy?: number;
  createdAt?: string;
  downloadUrl?: string;
  narrativeStatus?: string; // none/ai/degraded（AI 叙述生成状态）
  aiModel?: string;
}

// 输出格式 → 文件扩展名（后端 render 落盘命名规则）
const REPORT_FORMAT_EXT: Record<string, string> = {
  word: 'docx',
  excel: 'xlsx',
  pdf: 'pdf',
  markdown: 'md',
  html: 'html',
};

export function reportFormatExt(format?: string): string {
  return REPORT_FORMAT_EXT[format || ''] || 'bin';
}

async function fetchReportBlob(taskId: string | number): Promise<Blob> {
  return request.get<Blob>(`/api/v1/monitor/report/tasks/${Number(taskId)}/download`, {
    responseType: 'blob',
    timeout: 120000,
  });
}

// 批量任务操作结果（逐项守卫：成功数 + 失败项逐项原因）
export interface BatchTaskResult {
  succeeded?: number;
  failures?: { id?: number; reason?: string }[];
}

export const reportTaskService = {
  list(
    opts: {
      page?: number;
      pageSize?: number;
      templateId?: number;
      scheduledTaskId?: number;
      status?: string;
      keyword?: string;
      outputFormat?: string;
      taskId?: number;
    } = {},
  ) {
    return monitorReportClient.ListTasks({
      page: opts.page ?? 1,
      pageSize: opts.pageSize ?? 10,
      templateId: opts.templateId || undefined,
      scheduledTaskId: opts.scheduledTaskId || undefined,
      status: opts.status || undefined,
      keyword: opts.keyword || undefined,
      outputFormat: opts.outputFormat || undefined,
      taskId: opts.taskId || undefined,
    }) as Promise<ListResponse<ReportTaskEntity>>;
  },
  get(id: string | number) {
    return monitorReportClient.GetTask({ id: Number(id) }) as Promise<ReportTaskEntity>;
  },
  cancel(id: string | number) {
    return monitorReportClient.CancelTask({ id: Number(id) }) as Promise<unknown>;
  },
  // 重试失败任务（仅 failed 状态可重试，后端校验并重新入队）
  retry(id: string | number) {
    return monitorReportClient.RetryTask({ id: Number(id) }) as Promise<unknown>;
  },
  // 删除任务记录（软删 + 物理删除报表文件；pending/generating 后端拒绝）
  remove(id: string | number) {
    return monitorReportClient.DeleteTask({ id: Number(id) }) as Promise<unknown>;
  },
  // 批量删除（逐项守卫：pending/generating 该项失败不阻断其余）
  batchDelete(ids: number[]) {
    return monitorReportClient.BatchDeleteTasks({ ids }) as Promise<BatchTaskResult>;
  },
  // 批量重试（仅 failed 项成功，其余逐项返回原因）
  batchRetry(ids: number[]) {
    return monitorReportClient.BatchRetryTasks({ ids }) as Promise<BatchTaskResult>;
  },
  // 鉴权下载（Bearer 经 axios 拦截器注入），文件名取 taskNo+扩展名
  async download(task: ReportTaskEntity) {
    const blob = await fetchReportBlob(task.id as number);
    const name = `${task.taskNo || 'report'}.${reportFormatExt(task.outputFormat)}`;
    downloadBlob(blob, name);
  },
  // markdown/html 在线查看：新窗口打开 blob（Content-Type 由后端按格式设置）
  async viewOnline(task: ReportTaskEntity): Promise<string> {
    const blob = await fetchReportBlob(task.id as number);
    const typed = new Blob([blob], { type: task.outputFormat === 'html' ? 'text/html' : 'text/plain' });
    const url = URL.createObjectURL(typed);
    window.open(url, '_blank');
    return url;
  },
};

// ---- 定时任务 ----
export interface ReportScheduledTaskEntity {
  id?: number;
  name?: string;
  code?: string;
  templateId?: number;
  templateName?: string;
  cronExpression?: string;
  description?: string;
  statisticCycle?: string; // daily/weekly/monthly/quarterly/yearly
  statisticOffset?: number; // 统计前 N 个周期，默认 1
  outputFormat?: string; // 覆盖格式，空=继承模板
  effectiveFormat?: string; // 生效格式（只读）
  status?: number;
  lastRunAt?: string;
  nextRunAt?: string;
  lastTaskId?: number;
  lastTaskStatus?: string;
  notifyOnComplete?: number;
  notifyUsers?: unknown[];
  noticeChannel?: string; // 投递渠道：email/dingtalk/webhook/wecom/internal，空=仅记录不投递
  createdBy?: number;
  updatedBy?: number;
  createdAt?: string;
  updatedAt?: string;
}

export const reportScheduledTaskService = {
  list(opts: { page?: number; pageSize?: number; keyword?: string; status?: number } = {}) {
    return monitorReportClient.ListScheduledTasks({
      page: opts.page ?? 1,
      pageSize: opts.pageSize ?? 10,
      keyword: opts.keyword || undefined,
      status: opts.status ?? -1,
    }) as Promise<ListResponse<ReportScheduledTaskEntity>>;
  },
  get(id: string | number) {
    return monitorReportClient.GetScheduledTask({ id: Number(id) }) as Promise<ReportScheduledTaskEntity>;
  },
  create(data: Partial<ReportScheduledTaskEntity>) {
    return monitorReportClient.CreateScheduledTask({ data: data as never }) as Promise<unknown>;
  },
  update(id: string | number, data: Partial<ReportScheduledTaskEntity>) {
    return monitorReportClient.UpdateScheduledTask({ id: Number(id), data: data as never }) as Promise<unknown>;
  },
  delete(id: string | number) {
    return monitorReportClient.DeleteScheduledTask({ id: Number(id) }) as Promise<unknown>;
  },
  toggle(id: string | number, status: number) {
    return monitorReportClient.ToggleScheduledTask({ id: Number(id), status }) as Promise<unknown>;
  },
  trigger(id: string | number) {
    return monitorReportClient.TriggerScheduledTask({ id: Number(id) }) as Promise<GenerateReportResult>;
  },
};

// ===================== 网络线路监控（08-linemonitor 子服务） =====================

// ---- 线路配置 ----
export interface NetworkLineEntity {
  id?: number;
  name?: string;
  lineType?: string; // fiber/ethernet/vpn/leased_line/mpls/4g/5g/satellite
  bandwidth?: number; // Mbps
  sourceDeviceId?: number;
  targetDeviceId?: number;
  sourceIp?: string;
  sourcePort?: string;
  targetIp?: string;
  targetPort?: string;
  priority?: number;
  isPrimary?: number; // 1-主 0-备
  backupLineId?: number;
  description?: string;
  location?: string;
  provider?: string;
  contractNo?: string;
  manageDeptId?: number;
  useDeptId?: number;
  managerId?: number;
  status?: number; // 1-启用 0-停用
  createTime?: string;
  updateTime?: string;
}

export const lineService = {
  list(
    opts: {
      page?: number;
      pageSize?: number;
      keyword?: string;
      lineType?: string;
      status?: number;
      onlyMine?: number;
    } = {},
  ) {
    return lineMonitorClient.ListLines({
      page: opts.page ?? 1,
      pageSize: opts.pageSize ?? 10,
      keyword: opts.keyword || undefined,
      lineType: opts.lineType || undefined,
      // proto3 缺省 0 会被后端按 status=0 过滤，全部必须显式传 -1（-1 为 JS truthy 会下发）
      status: opts.status ?? -1,
      onlyMine: opts.onlyMine || undefined,
      // 生成客户端 exactOptionalPropertyTypes 风格：全部键必须显式存在（本封装一期不暴露 dept/属主筛选）
      deptId: undefined,
      owner: undefined,
    }) as Promise<ListResponse<NetworkLineEntity>>;
  },
  get(id: string | number) {
    return lineMonitorClient.GetLine({ id: Number(id) }) as Promise<NetworkLineEntity>;
  },
  create(data: Partial<NetworkLineEntity>) {
    return lineMonitorClient.CreateLine({ data: data as never }) as Promise<NetworkLineEntity>;
  },
  update(id: string | number, data: Partial<NetworkLineEntity>) {
    return lineMonitorClient.UpdateLine({ id: Number(id), data: data as never }) as Promise<unknown>;
  },
  delete(id: string | number) {
    return lineMonitorClient.DeleteLine({ id: Number(id) }) as Promise<unknown>;
  },
};

// ---- 线路批量导入导出（详设 §2.22；server 手写路由，非 proto 注解）----
export interface ImportLineRowResult {
  rowNo: number;
  valid: boolean;
  errors?: string[];
  data?: NetworkLineEntity;
}
export interface ImportLinesResult {
  total: number;
  validCount: number;
  invalidCount: number;
  imported: number; // dryRun=true 时恒 0
  skipped: number; // 重名跳过（mode=skip）
  failed: number; // 写入失败行数
  rows?: ImportLineRowResult[];
}
export const lineIOService = {
  // 导出按当前列表筛选条件（数据权限行级过滤由后端按当前用户强制）
  async exportLines(params: { keyword?: string; lineType?: string; status?: number; onlyMine?: number } = {}) {
    const blob = await request.get<Blob>('/api/v1/monitor/linemonitor/lines/export', {
      params: {
        keyword: params.keyword || undefined,
        line_type: params.lineType || undefined,
        status: params.status ?? -1,
        only_mine: params.onlyMine || undefined,
      },
      responseType: 'blob',
      timeout: 120000,
    });
    downloadBlob(blob, excelFileName('lines'));
  },
  downloadImportTemplate() {
    return downloadExcel('/api/v1/monitor/linemonitor/lines/import-template', 'line_import_template.xlsx');
  },
  // dryRun=true 仅解析校验预览（不落库）；false 确认写入，重名按 mode 处理
  importLines(file: File, opts: { dryRun?: boolean; mode?: 'skip' | 'overwrite' } = {}) {
    const fd = new FormData();
    fd.append('file', file);
    return request.post<ImportLinesResult>('/api/v1/monitor/linemonitor/lines/import', fd, {
      params: { dry_run: opts.dryRun ? 'true' : 'false', mode: opts.mode || 'skip' },
      headers: { 'Content-Type': 'multipart/form-data' },
      timeout: 120000,
    });
  },
};

