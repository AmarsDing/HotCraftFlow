  deleteKnownHost: (id: number) => opstoolsDiscoveryClient.DeleteKnownHost({ id }) as Promise<unknown>,
  upsertKnownHost: (mac: string, name?: string) =>
    opstoolsDiscoveryClient.UpsertKnownHost({ mac, name: name || undefined }) as Promise<KnownHost>,
  wakeOnLan(mac: string, opts: { broadcast?: string; port?: number } = {}) {
