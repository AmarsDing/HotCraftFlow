  domain?: string;
  chainType?: string;
  scopeLabel?: string;
  state?: string;
  stateSince?: string;
  memberCount?: number;
  alarmCount?: number;
  degradedReason?: string;
  runwayEndId?: number;
  enabled?: boolean;
  redundancy?: string;
  /** 成员健康摘要（health / collectLagS / activeAlarms），列表接口直出，
   *  供链卡渲染成员健康点阵；不含 keyMetrics（参数明细仍走详情接口）。 */
  members?: CommnavMemberHealth[];
}

export interface CommnavKeyMetric {
  metricKey?: string;
  displayName?: string;
  value?: number;
  unit?: string;
  decimals?: number;
  found?: boolean;
  stale?: boolean;
  state?: string;
  updatedAt?: string;
}

export interface CommnavMemberHealth {
  deviceId?: number;
  deviceName?: string;
  memberGroup?: string;
  role?: string;
  required?: boolean;
  health?: string;
  collectLagS?: number;
  activeAlarms?: number;
  categoryCode?: string;
  keyMetrics?: CommnavKeyMetric[];
}

export interface CommnavChainEventView {
  id?: number;
  eventType?: string;
  fromState?: string;
  toState?: string;
  actorDeviceId?: number;
  detailJson?: string;
  eventTime?: string;
}

export interface CommnavAvailability24h {
  normalS?: number;
  degradedS?: number;
  outageS?: number;
  unknownS?: number;
  switchoverCount?: number;
}

export interface CommnavChainDetail {
  chain?: CommnavChainSummary;
  members?: CommnavMemberHealth[];
  events?: CommnavChainEventView[];
  availability24h?: CommnavAvailability24h;
}

export const commnavChainService = {
  listTypes: () => request.get<{ items?: CommnavChainTypeInfo[] }>('/api/v1/monitor/commnav-chains/chain-types'),
  list: (p?: { airportId?: number; domain?: string; runwayEndId?: number; enabled?: boolean }) =>
    request.get<{ items?: CommnavChain[]; total?: number }>('/api/v1/monitor/commnav-chains', { params: p }),
  get: (id: number) => request.get<{ chain?: CommnavChain }>(`/api/v1/monitor/commnav-chains/${id}`),
  create: (data: CommnavChain) => request.post<{ chain?: CommnavChain }>('/api/v1/monitor/commnav-chains', { data }),
  update: (data: CommnavChain) =>
    request.put<{ chain?: CommnavChain }>(`/api/v1/monitor/commnav-chains/${data.id}`, { data }),
  remove: (id: number) => request.delete(`/api/v1/monitor/commnav-chains/${id}`),
  validate: (data: CommnavChain) =>
    request.post<{ ok?: boolean; warnings?: { code?: string; message?: string; level?: string }[] }>(
      '/api/v1/monitor/commnav-chains/validate',
      { data },
    ),
  listEvents: (id: number, limit = 50) =>
    request.get<{ items?: CommnavChainEventView[] }>(`/api/v1/monitor/commnav-chains/${id}/events`, { params: { limit } }),
};

export const commnavQueryService = {
  chains: (p?: { airportId?: number; domain?: string; state?: string; keyword?: string }) =>
    request.get<{ items?: CommnavChainSummary[] }>('/api/v1/monitor/query/commnav/chains', { params: p, timeout: 60000 }),
  detail: (id: number) => request.get<CommnavChainDetail>(`/api/v1/monitor/query/commnav/chains/${id}`, { timeout: 60000 }),
};

// ===================== 06-数据管理（monitorquery 导出/保留策略 + analysis 子服务） =====================

// ---- 数据导出任务（monitorquery 2.8，export_tasks）----
export interface ExportTaskEntity {
  id?: number;
  taskNo?: string;
  exportType?: string; // metric_history-指标历史 / alarm_history-告警历史
  exportFormat?: string; // csv / excel
  params?: string;
  status?: string; // pending/running/success/failed/canceled
  progress?: number;
  recordCount?: number;
  fileSize?: number;
  errorMessage?: string;
  exportedBy?: number;
  startedAt?: string;
  completedAt?: string;
  createdAt?: string;
  downloadUrl?: string;
}

async function fetchExportBlob(taskId: string | number): Promise<Blob> {
  return request.get<Blob>(`/api/v1/monitor/query/export/tasks/${Number(taskId)}/download`, {
    responseType: 'blob',
    timeout: 120000,
  });
}

export const exportTaskService = {
  list(opts: { page?: number; pageSize?: number; exportType?: string; status?: string; keyword?: string } = {}) {
    return monitorQueryClient.ListExportTasks({
      page: opts.page ?? 1,
      pageSize: opts.pageSize ?? 10,
      exportType: opts.exportType || undefined,
      status: opts.status || undefined,
      keyword: opts.keyword || undefined,
    }) as Promise<ListResponse<ExportTaskEntity>>;
  },
  get(id: string | number) {
    return monitorQueryClient.GetExportTask({ id: Number(id) }) as Promise<ExportTaskEntity>;
  },
  create(data: {
    exportType: string;
    exportFormat: string;
    deviceIds?: string;
    metricKeys?: string;
    granularity?: string;
    deviceId?: number;
    alarmLevel?: string;
    alertLevel?: number;
    status?: string;
    ruleId?: number;
    keyword?: string;
    startTime: string;
    endTime: string;
  }) {
    return monitorQueryClient.CreateExportTask({
      exportType: data.exportType,
      exportFormat: data.exportFormat,
      deviceIds: data.deviceIds || undefined,
      metricKeys: data.metricKeys || undefined,
      granularity: data.granularity || undefined,
      deviceId: data.deviceId,
      alarmLevel: data.alarmLevel || undefined,
      alertLevel: data.alertLevel,
      status: data.status || undefined,
      ruleId: data.ruleId,
      keyword: data.keyword || undefined,
      startTime: data.startTime,
      endTime: data.endTime,
    }) as Promise<ExportTaskEntity>;
  },
  cancel(id: string | number) {
    return monitorQueryClient.CancelExportTask({ id: Number(id) }) as Promise<unknown>;
  },
  // 同步导出（详设 §2.3.1：≤5000 条；自定义路由 POST /export:sync，请求内完成并返回 success 任务）
  createSync(data: {
    exportType: string;
    exportFormat: string;
    deviceIds?: string;
    metricKeys?: string;
    granularity?: string;
    deviceId?: number;
    alarmLevel?: string;
    alertLevel?: number;
    status?: string;
    ruleId?: number;
    keyword?: string;
    startTime: string;
    endTime: string;
  }) {
    return request.post<ExportTaskEntity>(
      '/api/v1/monitor/query/export:sync',
      {
        exportType: data.exportType,
        exportFormat: data.exportFormat,
        deviceIds: data.deviceIds || undefined,
        metricKeys: data.metricKeys || undefined,
        granularity: data.granularity || undefined,
        deviceId: data.deviceId,
        alarmLevel: data.alarmLevel || undefined,
        alertLevel: data.alertLevel,
        status: data.status || undefined,
        ruleId: data.ruleId,
        keyword: data.keyword || undefined,
        startTime: data.startTime,
        endTime: data.endTime,
      },
      { timeout: 60000 },
    );
  },
  // 鉴权流式下载（Bearer 经 axios 拦截器注入）；csv 产物为 gzip 压缩
  async download(task: ExportTaskEntity) {
    const blob = await fetchExportBlob(task.id as number);
    const ext = task.exportFormat === 'excel' ? 'xlsx' : 'csv.gz';
    downloadBlob(blob, `${task.taskNo || 'export'}.${ext}`);
  },
};

// ---- 数据保留策略（monitorquery 2.8，data_retention_policies）----
export interface RetentionPolicyEntity {
  id?: number;
  name?: string;
  code?: string;
  targetType?: string; // device_metrics/device_metrics_aggregated/alarm_events/device_statistics/analysis_results/prediction_results/export_files/report_files
  targetCollection?: string;
  retentionDays?: number;
  archiveDays?: number;
  archiveStorage?: string;
  archivePath?: string;
  cleanupEnabled?: boolean;
  cleanupCron?: string;
  archiveBeforeCleanup?: boolean;
  lastCleanupAt?: string;
  lastCleanupCount?: number;
  status?: number; // 1-启用 0-禁用
  remark?: string;
  createdAt?: string;
  updatedAt?: string;
}

export const retentionPolicyService = {
  list(opts: { page?: number; pageSize?: number; targetType?: string; status?: number; keyword?: string } = {}) {
    return monitorQueryClient.ListRetentionPolicies({
      page: opts.page ?? 1,
      pageSize: opts.pageSize ?? 10,
      targetType: opts.targetType || undefined,
      status: opts.status,
      keyword: opts.keyword || undefined,
    }) as Promise<ListResponse<RetentionPolicyEntity>>;
  },
  get(id: string | number) {
    return monitorQueryClient.GetRetentionPolicy({ id: Number(id) }) as Promise<RetentionPolicyEntity>;
  },
  create(data: Partial<RetentionPolicyEntity>) {
    return monitorQueryClient.CreateRetentionPolicy({
      name: data.name,
      code: data.code,
      targetType: data.targetType,
      targetCollection: data.targetCollection || undefined,
      retentionDays: data.retentionDays,
      archiveDays: data.archiveDays,
      archiveStorage: data.archiveStorage || undefined,
      archivePath: data.archivePath || undefined,
      cleanupEnabled: data.cleanupEnabled,
      cleanupCron: data.cleanupCron || undefined,
      archiveBeforeCleanup: data.archiveBeforeCleanup,
      status: data.status,
      remark: data.remark || undefined,
    }) as Promise<RetentionPolicyEntity>;
  },
  update(id: string | number, data: Partial<RetentionPolicyEntity>) {
    return monitorQueryClient.UpdateRetentionPolicy({
      id: Number(id),
      name: data.name,
      targetCollection: data.targetCollection || undefined,
      retentionDays: data.retentionDays,
      archiveDays: data.archiveDays,
      archiveStorage: data.archiveStorage || undefined,
      archivePath: data.archivePath || undefined,
      cleanupEnabled: data.cleanupEnabled,
      cleanupCron: data.cleanupCron || undefined,
      archiveBeforeCleanup: data.archiveBeforeCleanup,
      status: data.status,
      remark: data.remark || undefined,
    }) as Promise<RetentionPolicyEntity>;
  },
  delete(id: string | number) {
    return monitorQueryClient.DeleteRetentionPolicy({ id: Number(id) }) as Promise<unknown>;
  },
  // 手动执行清理，返回执行摘要（cleanedCount/archivedCount/message）
  execute(id: string | number) {
    return monitorQueryClient.ExecuteRetentionPolicy({ id: Number(id) }) as Promise<{
      targetType?: string;
      cleanedCount?: number;
      archivedCount?: number;
      message?: string;
      executedAt?: string;
    }>;
  },
};

