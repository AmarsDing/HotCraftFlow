// ---- 大屏自定义组件模板（§14.6：存为模板 / 面板"自定义"分组实例化） ----
export interface ComponentTemplateEntity {
  id?: number;
  name?: string;
  componentType?: string;
  size?: { width?: number; height?: number; [k: string]: unknown };
  dataSource?: DashboardComponentEntity['dataSource'];
  // 插件化定制（§14.7）：图标=material图标名或图片dataURL；描述=悬停预览；分类=面板分组
  icon?: string;
  description?: string;
  category?: string;
  createTime?: string;
  updateTime?: string;
  remark?: string;
}
export const componentTemplateService = {
  list: (params?: { keyword?: string; componentType?: string; category?: string }) =>
    componentTemplateClient.ListComponentTemplates({
      keyword: params?.keyword,
      componentType: params?.componentType,
      category: params?.category,
    }) as Promise<{ items?: ComponentTemplateEntity[] }>,
  create: (data: Partial<ComponentTemplateEntity>) =>
    componentTemplateClient.CreateComponentTemplate({ data: data as never }) as Promise<unknown>,
  update: (id: number, data: Partial<ComponentTemplateEntity>) => {
    const updateMask = buildUpdateMask(data as Record<string, unknown>);
    return componentTemplateClient.UpdateComponentTemplate({ id, data: data as never, updateMask }) as Promise<unknown>;
  },
  delete: (id: number) => componentTemplateClient.DeleteComponentTemplate({ id }) as Promise<unknown>,
};

// 大屏组件（对应 proto DashboardComponent；position/size/dataSource 为 JSON Struct）
export interface DashboardComponentEntity {
  id?: number;
  configId?: number;
  componentType?: string;
  position?: { x?: number; y?: number; [k: string]: unknown };
  size?: { width?: number; height?: number; [k: string]: unknown };
  dataSource?: {
    name?: string;
    // 旧模型：type 直写数据源类型；新模型（综合态势大屏）：dataType=provider|static + providerType
    type?: string;
    dataType?: 'provider' | 'static' | 'api' | 'pond' | '';
    providerType?: string;
    params?: Record<string, unknown>;
    static?: { columns?: unknown[]; rows?: unknown[] };
    filter?: string;
    bind?: { dim?: string; metrics?: string[] };
    // 可视化筛选器（§14.3）：AND 组合，客户端行过滤，替代手写 JS
    filters?: { field?: string; op?: string; value?: string | number }[];
    // 指标格式化与阈值变色（§14.4 Grafana 式三件套）
    options?: Record<string, unknown> & {
      format?: { decimals?: number | 'auto'; thousands?: boolean; unit?: string };
      thresholds?: { op?: string; value?: number; color?: string }[];
    };
    style?: { title?: string; titleColor?: string; backgroundColor?: string; [k: string]: unknown };
    [k: string]: unknown;
  };
  refreshInterval?: number;
  // 预览聚合数据（仅 PreviewDashboard 返回）：按 data_source.type 由后端并行聚合；
  // 单组件失败填充 { error }；08/09/10 未建设数据源填充 { unsupported: true }
  data?: Record<string, unknown>;
  remark?: string;
}

// 大屏详情（GetDashboard/PreviewDashboard 返回：配置 + 组件列表）
export interface DashboardDetailEntity {
  config?: DashboardConfigEntity;
  components?: DashboardComponentEntity[];
}

