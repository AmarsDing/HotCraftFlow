      pageSize: opts.pageSize ?? 20,
      alarmEventId: opts.alarmEventId,
      channelId: opts.channelId,
      status: opts.status || undefined,
    }) as Promise<{ items: AlarmNotifyLogEntity[]; total: number }>;
  },
  // 手动重发失败/卡死的通知记录（渠道按最新配置，消息按关联告警事件重建）
  retryLog(id: number) {
    return alarmNotifyClient.RetryNotifyLog({ id }) as Promise<RetryNotifyLogResponse>;
  },
};

// ===================== 数据到达监控（23-气象综合业务平台 P0，monitoralarm data-arrival 模块） =====================

export interface ArrivalOverviewEntity extends ArrivalOverview {}
export interface ArrivalStreamStatusEntity extends ArrivalStreamStatus {}
export interface ArrivalTimelineResult extends ArrivalTimeline {}
export interface ArrivalTimelineRowEntity extends ArrivalTimelineRow {}
export interface ArrivalTimelineCellEntity extends ArrivalTimelineCell {}
export interface ArrivalSlotEntity extends ArrivalSlot {}
export interface ArrivalTaskRunEntity extends ArrivalTaskRun {}
export interface ArrivalStreamEntity extends ArrivalStream {}
export interface ArrivalLinkTargetEntity extends ArrivalLinkTarget {}
export interface ArrivalDiscoverResult extends DiscoverArrivalStreamsResponse {}
// 新建监控流向导：源采集任务候选（任务+展开流键+exists 标记）
export interface ArrivalSourceTaskEntity extends ArrivalSourceTask {}
export interface ArrivalStreamKeyCandidateEntity extends ArrivalStreamKeyCandidate {}
// 到达周期统计实体（24-统计分析与AI洞察 S1）
export interface ArrivalStatisticsEntity extends ArrivalStatistics {}
export interface ArrivalStatSummaryEntity extends ArrivalStatSummary {}
export interface ArrivalSourceStatEntity extends ArrivalSourceStat {}
export interface ArrivalStreamStatEntity extends ArrivalStreamStat {}
export interface ArrivalTrendPointEntity extends ArrivalTrendPoint {}
export interface ArrivalLateHourDistEntity extends ArrivalLateHourDist {}

export const arrivalMonitorService = {
  // 汇总卡：流总数/正常/迟到/缺失/任务异常/活跃告警数/今日准时率
  getOverview() {
    return dataArrivalClient.GetArrivalOverview({}) as Promise<ArrivalOverviewEntity>;
  },
  // 流实时状态表（含最近数据时刻/下次期望/延迟/连缺/当前状态/活跃告警）
  listStatus(opts: { sourceType?: string; enabled?: number } = {}) {
    return dataArrivalClient.ListArrivalStatus({
      sourceType: opts.sourceType || undefined,
      enabled: opts.enabled,
    }) as Promise<{ items: ArrivalStreamStatusEntity[] }>;
  },
  // 热力矩阵：streamIds + start/end(ISO) + slotMinutes → rows×slots（cell=最差状态+计数）
  getTimeline(opts: { streamIds?: number[]; start?: string; end?: string; slotMinutes?: number } = {}) {
    return dataArrivalClient.GetArrivalTimeline({
      streamIds: opts.streamIds && opts.streamIds.length > 0 ? opts.streamIds : undefined,
      start: opts.start || undefined,
      end: opts.end || undefined,
      slotMinutes: opts.slotMinutes,
    }) as Promise<ArrivalTimelineResult>;
  },
  // 到达周期统计（24-统计分析与AI洞察 S1-T1.7）：KPI 摘要+等长前窗环比/分源/脆弱流（准时率升序）/
  // 趋势分桶/迟到 24h 分布；start/end 传 ISO 串，granularity hour|day 空=后端自适应
  getStatistics(
    opts: {
      sourceType?: string;
      streamIds?: number[];
      start?: string;
      end?: string;
      granularity?: string;
    } = {},
  ) {
    return dataArrivalClient.GetArrivalStatistics({
      sourceType: opts.sourceType || undefined,
      streamIds: opts.streamIds && opts.streamIds.length > 0 ? opts.streamIds : undefined,
      start: opts.start || undefined,
      end: opts.end || undefined,
      granularity: opts.granularity || undefined,
    }) as Promise<ArrivalStatisticsEntity>;
  },
  // 单流时次明细（点击矩阵单元格/行下钻）
  listSlots(opts: {
    streamId: number;
    start?: string;
    end?: string;
    status?: string;
    page?: number;
    pageSize?: number;
  }) {
    return dataArrivalClient.ListArrivalSlots({
      streamId: opts.streamId,
      start: opts.start || undefined,
      end: opts.end || undefined,
      status: opts.status || undefined,
      page: opts.page ?? 1,
      pageSize: opts.pageSize ?? 50,
    }) as Promise<{ items: ArrivalSlotEntity[]; total: number }>;
  },
  // 任务运行记录（源/任务/状态/时间筛选分页）
  listTaskRuns(
    opts: {
      sourceType?: string;
      taskId?: number;
      status?: string;
      start?: string;
      end?: string;
      page?: number;
      pageSize?: number;
    } = {},
  ) {
    return dataArrivalClient.ListArrivalTaskRuns({
      sourceType: opts.sourceType || undefined,
      taskId: opts.taskId,
      status: opts.status || undefined,
      start: opts.start || undefined,
      end: opts.end || undefined,
      page: opts.page ?? 1,
      pageSize: opts.pageSize ?? 50,
    }) as Promise<{ items: ArrivalTaskRunEntity[]; total: number }>;
  },
  // 监控流列表/新建/更新/删除（软删除）
  listStreams(opts: { sourceType?: string; enabled?: number; page?: number; pageSize?: number } = {}) {
    return dataArrivalClient.ListArrivalStreams({
      sourceType: opts.sourceType || undefined,
      enabled: opts.enabled,
      page: opts.page ?? 1,
      pageSize: opts.pageSize ?? 100,
    }) as Promise<{ items: ArrivalStreamEntity[]; total: number }>;
  },
  createStream(data: Partial<ArrivalStreamEntity>) {
    return dataArrivalClient.CreateArrivalStream(data as never) as Promise<ArrivalStreamEntity>;
  },
  updateStream(id: number, data: Partial<ArrivalStreamEntity>) {
    return dataArrivalClient.UpdateArrivalStream({ id, ...data } as never) as Promise<ArrivalStreamEntity>;
  },
  deleteStream(id: number) {
    return dataArrivalClient.DeleteArrivalStream({ id }) as Promise<unknown>;
  },
  // 从 4 张 fetch_tasks + flight_sources 自动发现导入（幂等）
  discoverStreams() {
    return dataArrivalClient.DiscoverArrivalStreams({}) as Promise<ArrivalDiscoverResult>;
  },
  // 源采集任务候选清单（新建监控流向导"选择代替手填"）：任务+展开流键+exists 标记，与 discover 同口径
  listSourceTasks(sourceType: string) {
    return dataArrivalClient.ListArrivalSourceTasks({ sourceType }) as Promise<{ items: ArrivalSourceTaskEntity[] }>;
  },
  // 立即检查（手动触发该流对账+判定）
  checkStream(id: number) {
    return dataArrivalClient.CheckArrivalStream({ id }) as Promise<unknown>;
  },
  // 链路体检目标解析（P2 B5：stream→fetch_task→source endpoint_url，空=需手输）
  getLinkTarget(id: number) {
    return dataArrivalClient.GetArrivalLinkTarget({ id }) as Promise<ArrivalLinkTargetEntity>;
  },
};

