    return radarMosaicClient.GenerateMosaic({ config }) as Promise<RadarMosaicGenerateResult>;
  },
  // 获取拼图数据（GRID=base64 网格二进制；IMAGE=PNG 渲染图鉴权下载 URL；GEOJSON=矢量下载 URL）
