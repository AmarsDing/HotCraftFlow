  userName?: string;
  channel?: string;
  templateId?: number;
  title?: string;
  content?: string;
  contact?: string;
  noticeProfileId?: number;
  status?: string;
  sentAt?: string;
  error?: string;
  retryCount?: number;
  sendDuration?: number;
  isEscalation?: boolean;
  // v2.0 通知中心：类型/事件级别/关联业务/来源模块
  noticeType?: string;
  eventLevel?: string;
  relatedId?: string;
  sourceModule?: string;
}
// 通知中心统计卡（v2.0 §4.9）：待发送数/今日发送数/今日类型数
export interface NoticeRecordsSummaryEntity {
  pendingCount?: number;
  todaySentCount?: number;
  todayTypeCount?: number;
}
export const noticeRecordService = {
  list(opts: PagingRequest & { formValues?: Record<string, unknown> } = {}) {
    const params = buildQueryParams(opts.formValues, opts);
    const fv = opts.formValues ?? {};
    return noticeRecordClient.ListRecords({
      alarmId: fv.alarmId as string | undefined,
      userId: fv.userId as number | undefined,
      channel: fv.channel as string | undefined,
      status: fv.status as string | undefined,
      noticeType: fv.noticeType as string | undefined,
      startTime: fv.startTime as string | undefined,
      endTime: fv.endTime as string | undefined,
      page: params.page ? Number(params.page) : undefined,
      pageSize: params.pageSize ? Number(params.pageSize) : undefined,
    }) as Promise<ListResponse<NoticeRecordEntity>>;
  },
  get(id: string | number) {
    return noticeRecordClient.GetRecord({ id: Number(id) }) as Promise<NoticeRecordEntity>;
  },
  retry(id: string | number) {
    return noticeRecordClient.RetryRecord({ id: Number(id) }) as Promise<unknown>;
  },
  // 人工标记为已发送（仅 pending/failed 可操作，重复标记后端返回 409）
  markSent(id: string | number) {
    return noticeRecordClient.MarkRecordSent({ id: Number(id) }) as Promise<NoticeRecordEntity>;
  },
  getSummary() {
    return noticeRecordClient.GetRecordsSummary({}) as Promise<NoticeRecordsSummaryEntity>;
  },
};

