// ===================== Collector: 采集质量 =====================
export interface CollectionQualityStatEntity {
  statHour?: string;
  deviceId?: number;
  taskId?: number;
  protocolType?: string;
  nodeId?: number;
  totalAttempts?: number;
  successCount?: number;
  failureCount?: number;
  timeoutCount?: number;
  successRate?: number;
  avgDurationMs?: number;
  maxDurationMs?: number;
  minDurationMs?: number;
  p95DurationMs?: number;
  p99DurationMs?: number;
  missingCount?: number;
  missingRate?: number;
}
// proto JSON 将 int64 序列化为字符串（2026-08-24 实测 totalAttempts:"60"）；
// 前端聚合若直接 += 会退化为字符串拼接（"0606060…"），此处统一归一化为 number
function normalizeQualityStat(raw: CollectionQualityStatEntity): CollectionQualityStatEntity {
  const num = (v: unknown): number | undefined => {
    if (v === null || v === undefined || v === '') return undefined;
    const n = Number(v);
    return Number.isFinite(n) ? n : undefined;
  };
  return {
    ...raw,
    deviceId: num(raw.deviceId),
    taskId: num(raw.taskId),
    nodeId: num(raw.nodeId),
    totalAttempts: num(raw.totalAttempts),
    successCount: num(raw.successCount),
    failureCount: num(raw.failureCount),
    timeoutCount: num(raw.timeoutCount),
    successRate: num(raw.successRate),
    avgDurationMs: num(raw.avgDurationMs),
    maxDurationMs: num(raw.maxDurationMs),
    minDurationMs: num(raw.minDurationMs),
    p95DurationMs: num(raw.p95DurationMs),
    p99DurationMs: num(raw.p99DurationMs),
    missingCount: num(raw.missingCount),
    missingRate: num(raw.missingRate),
  };
}
export const qualityService = {
  // 按小时聚合质量查询（时间范围 / deviceId / protocolType 可选 + 分页）
  list(
    opts: {
      startTime?: number;
      endTime?: number;
      deviceId?: number;
      protocolType?: string;
      page?: number;
      pageSize?: number;
    } = {},
  ) {
    return qualityClient
      .ListCollectionQuality({
        startTime: opts.startTime,
        endTime: opts.endTime,
        deviceId: opts.deviceId,
        protocolType: opts.protocolType,
        page: opts.page,
        pageSize: opts.pageSize,
      })
      .then((resp) => {
        const r = resp as { items?: CollectionQualityStatEntity[]; total?: number };
        // total 同为 int64 可能字符串化，与 items 同口径归一（分页计算依赖）
        const total = Number(r.total);
        return {
          items: (r.items || []).map(normalizeQualityStat),
          total: Number.isFinite(total) ? total : 0,
        };
      });
  },
  // 单设备质量查询（按小时聚合，时间倒序）
  getDeviceQuality(deviceId: string | number, opts: { startTime?: number; endTime?: number } = {}) {
    return qualityClient
      .GetDeviceCollectionQuality({
        id: Number(deviceId),
        startTime: opts.startTime,
        endTime: opts.endTime,
      })
      .then((resp) => {
        const r = resp as { items?: CollectionQualityStatEntity[] };
        return { items: (r.items || []).map(normalizeQualityStat) };
      });
  },
};

