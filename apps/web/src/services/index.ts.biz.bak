    return radarMosaicClient.SaveMosaicConfig({ config }) as Promise<{ id: number }>;
  },
  // 删除拼图配置（软删）
  deleteConfig(id: number) {
    return radarMosaicClient.DeleteMosaicConfig({ id }) as Promise<Record<never, never>>;
  },
};

// ===================== 雷达风暴追踪（雷达数据整合平台 Phase 4，T46 后端 / T49 面板，radar 服务 MonitorRadarStormService） =====================
export const radarStormService = {
  // 追踪风暴（站点+时次序列取 CR 产品逐帧识别，匈牙利匹配生成追踪链并持久化；threshold<=0 缺省 40dBZ）
  track(siteId: number, scanTimes: string[], threshold?: number) {
    return radarStormClient.TrackStorms({
      siteId,
      scanTimes,
      threshold: threshold && threshold > 0 ? threshold : undefined,
    }) as Promise<{ tracks: RadarStormTrack[] }>;
  },
  // 获取已持久化风暴轨迹（站点 + 时间窗；siteId 缺省=全部站点）
  getTracks(opts: { siteId?: number; startTime?: string; endTime?: string } = {}) {
    return radarStormClient.GetStormTracks({
      siteId: opts.siteId || undefined,
      startTime: opts.startTime || undefined,
      endTime: opts.endTime || undefined,
    }) as Promise<{ tracks: RadarStormTrack[] }>;
  },
};

// ===================== 雷达预警区域（雷达数据整合平台 Phase 4，T47 后端 / T50 绘制工具，radar 服务 MonitorRadarAlertRegionService） =====================
export const radarAlertRegionService = {
  // 查询关注区列表（enabled 缺省=全部，true=仅启用）
  list(opts: { enabled?: boolean } = {}) {
    return radarAlertRegionClient.ListAlertRegions({ enabled: opts.enabled || undefined }) as Promise<{
      regions: RadarAlertRegion[];
    }>;
  },
  // 创建关注区（多边形 >=3 顶点 / 圆形半径 km；threshold 为告警阈值 dBZ；
  // proto 生成类型 polygon/circle 为必填键（值可 undefined），显式补键）
  create(region: RadarAlertRegion) {
    return radarAlertRegionClient.CreateAlertRegion({
      region: { ...region, polygon: region.polygon, circle: region.circle },
    }) as Promise<{ id: number }>;
  },
  // 更新关注区（仅传需变更字段；几何整体替换；undefined 键 JSON 序列化自动剔除）
  update(
    id: number,
    patch: {
      name?: string;
      type?: AlertRegionType;
      polygon?: RadarAlertRegion['polygon'];
      circle?: RadarAlertRegion['circle'];
      threshold?: number;
      enabled?: boolean;
    },
  ) {
    return radarAlertRegionClient.UpdateAlertRegion({
      id,
      name: patch.name,
      type: patch.type,
      polygon: patch.polygon,
      circle: patch.circle,
      threshold: patch.threshold,
      enabled: patch.enabled,
    }) as Promise<Record<never, never>>;
  },
  // 删除关注区（软删）
  remove(id: number) {
    return radarAlertRegionClient.DeleteAlertRegion({ id }) as Promise<Record<never, never>>;
  },
};

