// ===================== Alarm: 告警抑制规则 =====================
export interface AlarmSuppressionRuleEntity extends CrudEntity {
  name?: string;
  description?: string;
  suppressionType?: string;
  timeWindow?: number;
  countThreshold?: number;
  suppressionScope?: Record<string, unknown>;
  suppressionTarget?: Record<string, unknown>;
  handleAction?: string;
  status?: number;
  tenantId?: number;
}
export const alarmSuppressionRuleService = {
  // protoc-gen-typescript-http 生成的 GET 客户端对数值 query 用真值判断，status=0（禁用）会被丢弃；
  // 列表改走 axios 直传 params（0 值保留），与 dangerRule list 同一修法，保证状态筛选语义正确。
  list(opts: PagingRequest & { formValues?: Record<string, unknown> } = {}) {
    const params = buildQueryParams(opts.formValues, opts);
    const fv = opts.formValues ?? {};
    const status = fv.status;
    return request.get<ListResponse<AlarmSuppressionRuleEntity>>('/api/v1/monitor/alarm/suppression-rules', {
      params: {
        page: params.page ? Number(params.page) : 1,
        pageSize: params.pageSize ? Number(params.pageSize) : 10,
        suppressionType: (fv.suppressionType as string) || undefined,
        status: status === undefined || status === null || status === '' ? undefined : Number(status),
        keyword: (fv.keyword as string) || undefined,
      },
    });
  },
  get(id: string | number) {
    return alarmSuppressionRuleClient.GetSuppressionRule({ id: Number(id) }) as Promise<AlarmSuppressionRuleEntity>;
  },
  create(data: Partial<AlarmSuppressionRuleEntity>) {
    return alarmSuppressionRuleClient.CreateSuppressionRule({ data: data as never }) as Promise<unknown>;
  },
  update(id: string | number, data: Partial<AlarmSuppressionRuleEntity>) {
    return alarmSuppressionRuleClient.UpdateSuppressionRule({
      id: Number(id),
      data: data as never,
    }) as Promise<unknown>;
  },
  delete(id: string | number) {
    return alarmSuppressionRuleClient.DeleteSuppressionRule({ id: Number(id) }) as Promise<unknown>;
  },
};

