  // ---- 网络发现增强（网络发现增强开发文档 §4）：已知主机标记 / WOL / 端口扫描 ----
  markResultsKnown(resultIds: number[], known: boolean, name?: string) {
    return opstoolsDiscoveryClient.MarkDiscoveryResultsKnown({
      resultIds,
      known,
      name: name || undefined,
    }) as Promise<MarkDiscoveryResultsKnownResponse>;
  },
  listKnownHosts(opts: { page?: number; pageSize?: number; keyword?: string } = {}) {
    return opstoolsDiscoveryClient.ListKnownHosts({
      keyword: opts.keyword || undefined,
      page: opts.page ?? 1,
      pageSize: opts.pageSize ?? 20,
