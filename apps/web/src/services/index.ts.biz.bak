// ===================== Gateway（11 薄网关管理 API） =====================
// 网关管理面为手写 net/http（无 proto 客户端），响应裸 JSON：
// 列表直接返回数组，写操作返回 {status}，日志返回 {items,total}。
const GW_BASE = '/api/v1/monitor/gateway';

export interface GatewayRouteEntity {
  id?: number;
  name?: string;
  pathPrefix?: string;
  serviceName?: string;
  targetAddr?: string;
  priority?: number;
  timeoutMs?: number;
  retryCount?: number;
  lbPolicy?: string; // wrr-加权轮询 / rr-轮询
  deprecated?: number; // 1-已弃用
  sunsetAt?: string; // 下线时间（RFC3339）
  status?: number; // 1-启用 0-停用
  remark?: string;
  createdAt?: string;
  updatedAt?: string;
}

export interface GatewayServiceEntity {
  id?: number;
  serviceName?: string;
  addr?: string;
  weight?: number; // 权重（wrr 生效）
  version?: string; // 实例版本标签；空 = 默认版本
  healthPath?: string;
  status?: number; // 1-启用 0-停用
  remark?: string;
  createdAt?: string;
  updatedAt?: string;
}

export interface GatewayAccessLogEntity {
  id?: number;
  requestId?: string;
  userId?: number;
  username?: string;
  ip?: string;
  method?: string;
  path?: string;
  statusCode?: number;
  latencyMs?: number;
  serviceName?: string;
  upstreamAddr?: string;
  responseSize?: number;
  userAgent?: string;
  createdAt?: string;
}

// 服务对应容器运行视图（virtman 聚合；未接入/不可达时为 undefined）
export interface GatewayServiceContainer {
  containerId?: number;
  dockerId?: string;
  name?: string;
  image?: string;
  state?: string; // running/exited/paused/...
  statusText?: string;
  cpuPercent?: number | null;
  memUsageMB?: number | null;
  memLimitMB?: number | null;
  memPercent?: number | null;
  uptimeSeconds?: number | null;
  startedAt?: string;
  ports?: string[];
  restartCount?: number;
  memoryLimitMb?: number | null;
}

export interface GatewayServiceHealth {
  serviceName?: string;
  addr?: string;
  healthy?: boolean;
  latencyMs?: number;
  breakerState?: string; // closed/open/half-open
  lastError?: string;
  checkedAt?: string;
  container?: GatewayServiceContainer | null;
}

// 容器操作回执（透传 virtman）
export interface GatewayServiceOpResult {
  status?: string; // ok / failed
  op?: string;
  state?: string;
  statusText?: string;
  exitCode?: number;
  stateError?: string;
  oomKilled?: boolean;
  logTail?: string;
}

export const gatewayServiceOpsService = {
  operate(serviceName: string, action: 'start' | 'stop' | 'restart' | 'pause' | 'unpause', timeout = 30) {
    // 显式 axios 超时 60s：virtman stop 最多同步阻塞 timeout 秒，网关侧已放宽至 timeout+15s，
    // 前端必须大于后端（排队 + 转发余量），否则后端还在跑前端已放弃（request 透传 AxiosRequestConfig）。
    return request.post<GatewayServiceOpResult>(
      `${GW_BASE}/services/${serviceName}/ops`,
      { action, timeout },
      { timeout: 60000 },
    );
  },
};

// ---- 更新中心（12 P2）----

// 制品元数据
export interface GatewayDeployArtifact {
  id?: number;
  serviceName?: string;
  version?: string;
  kind?: string; // binary / config
  sha256?: string;
  sizeBytes?: number;
  gitCommit?: string;
  changelog?: string;
  storagePath?: string;
  createdBy?: number;
  createdName?: string;
  createdAt?: string;
}

// 健康门禁单项结果
export interface GatewayDeployHealthCheck {
  name?: string;
  url?: string;
  ok?: boolean;
  detail?: string;
}

// 健康门禁聚合结果
export interface GatewayDeployHealthGate {
  healthy?: boolean;
  attempts?: number;
  elapsedMs?: number;
  message?: string;
  checks?: GatewayDeployHealthCheck[];
}

// 部署记录
export interface GatewayDeployRecord {
  id?: number;
  serviceName?: string;
  deployType?: string; // binary / config / image
  fromVersion?: string;
  toVersion?: string;
  artifactId?: number;
  artifactSha256?: string;
  status?: string; // building/deploying/health_gate/done/failed/rolled_back
  strategy?: string; // recreate / canary
  operatorId?: number;
  operatorName?: string;
  healthGate?: GatewayDeployHealthGate | null;
  rollbackOf?: number;
  errorMessage?: string;
  createdAt?: string;
  updatedAt?: string;
}

// 更新包逐项登记结果
export interface GatewayDeployPackItem {
  service?: string;
  version?: string;
  kind?: string;
  file?: string;
  artifactId?: number;
  ok?: boolean;
  error?: string;
}

// 更新包登记结果（部分成功语义）
export interface GatewayDeployPackResult {
  registered?: number;
  total?: number;
  items?: GatewayDeployPackItem[];
}

export const gatewayDeployService = {
  // 执行器就绪状态（前端据此置灰"发起更新"）
  status() {
    return request.get<{ executorReady: boolean }>(`${GW_BASE}/deploy/status`);
  },
  listArtifacts(service?: string) {
    return request.get<GatewayDeployArtifact[]>(`${GW_BASE}/deploy/artifacts`, {
      params: { service: service || undefined },
    });
  },
  // 上传制品（multipart）：file + service/version/kind/gitCommit/changelog
  uploadArtifact(form: FormData) {
    return request.post<GatewayDeployArtifact>(`${GW_BASE}/deploy/artifacts`, form, {
      headers: { 'Content-Type': 'multipart/form-data' },
      timeout: 300000,
    });
  },
  // 上传更新包（multipart）：file 为 .zip（根目录 manifest.json），逐项登记，部分成功语义
  uploadPack(form: FormData) {
    return request.post<GatewayDeployPackResult>(`${GW_BASE}/deploy/pack`, form, {
      headers: { 'Content-Type': 'multipart/form-data' },
      timeout: 300000,
    });
  },
  deleteArtifact(id: number) {
    return request.delete(`${GW_BASE}/deploy/artifacts/${id}`);
  },
  // 发起更新（异步，返回初始记录供轮询）
  run(data: { service: string; artifactId: number; strategy?: string }) {
    return request.post<GatewayDeployRecord>(`${GW_BASE}/deploy/run`, data);
  },
  listRecords(opts: { service?: string; status?: string; limit?: number } = {}) {
    return request.get<GatewayDeployRecord[]>(`${GW_BASE}/deploy/records`, {
      params: {
        service: opts.service || undefined,
        status: opts.status || undefined,
        limit: opts.limit || undefined,
      },
    });
  },
  getRecord(id: number) {
    return request.get<GatewayDeployRecord>(`${GW_BASE}/deploy/records/${id}`);
  },
  rollback(id: number) {
    return request.post<GatewayDeployRecord>(`${GW_BASE}/deploy/records/${id}/rollback`);
  },
};

export const gatewayRouteService = {
  list() {
    return request.get<GatewayRouteEntity[]>(`${GW_BASE}/routes`);
