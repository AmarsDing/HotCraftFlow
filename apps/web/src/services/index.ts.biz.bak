  },
  update(id: string | number, data: Partial<AlarmUserEntity>) {
    return alarmNoticeUserClient.UpdateUser({ id: Number(id), data: data as never }) as Promise<unknown>;
  },
  delete(id: string | number) {
    return alarmNoticeUserClient.DeleteUser({ id: Number(id) }) as Promise<unknown>;
  },
  updatePreference(userId: string | number, data: Partial<AlarmUserPreferenceEntity>) {
    return alarmNoticeUserClient.UpdateUserPreference({
      id: Number(userId),
      data: { userId: Number(userId), ...data } as never,
    }) as Promise<unknown>;
  },
  updateDutyStatus(id: string | number, isOnDuty: number) {
    return alarmNoticeUserClient.UpdateDutyStatus({ id: Number(id), isOnDuty }) as Promise<unknown>;
  },
};

