  total_gb?: number;
  used_gb?: number;
  usage_percent?: number;
  status?: string; // available / in-use
  ref_count?: number; // 引用该卷的容器数（后端聚合）
  labels?: unknown;
  last_sync_at?: string;
  created_at?: string;
  updated_at?: string;
}

// 卷列表统计卡片（响应 data.summary）
export interface VirtmanVolumeSummary {
  total?: number;
  in_use?: number;
  available?: number;
  total_gb?: number;
  used_gb?: number;
}

// 清理空闲卷结果（POST /volumes/prune 响应）
export interface VirtmanVolumePruneResult {
  deleted?: string[];
  space_reclaimed?: number;
}

export interface VirtmanVolumeUpdateInput {
  total_gb?: number;
  used_gb?: number;
  volume_type?: string;
  labels?: Record<string, string>;
}

export const virtmanVolumeService = {
  list(opts: { page?: number; pageSize?: number; endpointId?: number; keyword?: string; status?: string } = {}) {
    return unwrapVirt(
      request.get<VirtEnvelope<{ items: VirtmanVolumeEntity[]; total: number; summary: VirtmanVolumeSummary }>>(
        `${VIRT_BASE}/volumes`,
        {
          params: {
            page: opts.page ?? 1,
            pageSize: opts.pageSize ?? 10,
            endpoint_id: opts.endpointId || undefined,
            keyword: opts.keyword || undefined,
            status: opts.status || undefined,
          },
        },
      ),
    );
  },
  get(id: number) {
    return unwrapVirt(request.get<VirtEnvelope<VirtmanVolumeEntity>>(`${VIRT_BASE}/volumes/${id}`));
  },
  // 引用该卷的容器名列表（详情抽屉）
  listContainers(id: number) {
    return unwrapVirt(request.get<VirtEnvelope<{ items: string[] }>>(`${VIRT_BASE}/volumes/${id}/containers`));
  },
  create(data: { endpoint_id: number; name: string; driver?: string; labels?: Record<string, string> }) {
    return unwrapVirt(request.post<VirtEnvelope<VirtmanVolumeEntity>>(`${VIRT_BASE}/volumes`, data));
  },
  // 编辑人工资产属性（total_gb/used_gb/volume_type/labels）
  update(id: number, data: VirtmanVolumeUpdateInput) {
    return unwrapVirt(request.put<VirtEnvelope<unknown>>(`${VIRT_BASE}/volumes/${id}`, data));
  },
  // 删除；skipErrorNotify → 409 由页面弹引用容器明细，其余错误页面自弹
  remove(id: number) {
    return unwrapVirt(
      request.delete<VirtEnvelope<unknown>>(`${VIRT_BASE}/volumes/${id}`, { skipErrorNotify: true } as Record<
        string,
        unknown
      >),
    );
  },
  // 清理指定端点未被引用的卷（all=true 含具名卷）
  prune(endpointId: number, all: boolean) {
    return unwrapVirt(
      request.post<VirtEnvelope<VirtmanVolumePruneResult>>(`${VIRT_BASE}/volumes/prune`, {
        endpoint_id: endpointId,
        all,
      }),
    );
  },
  sync(endpointId?: number) {
    return unwrapVirt(
      request.post<VirtEnvelope<unknown>>(`${VIRT_BASE}/volumes/sync`, {
        endpoint_id: endpointId || 0,
      }),
    );
  },
};

