// ---- 数据库连接（详设 §2.9）----
export const opstoolsDbConnectionService = {
  // protoc-gen-typescript-http 生成的 GET 客户端对数值 query 用真值判断，status=0（禁用）会被丢弃；
  // 列表改走 axios 直传 params（0 值保留），保证状态筛选语义正确（同 danger-rule list）。
  list(opts: { page?: number; pageSize?: number; keyword?: string; dbType?: string; status?: number } = {}) {
    return request.get<OpstoolsListResponse<DbConnection>>('/api/v1/monitor/opstools/db-connections', {
      params: {
        page: opts.page ?? 1,
        pageSize: opts.pageSize ?? 12,
        keyword: opts.keyword || undefined,
        dbType: opts.dbType || undefined,
        status: opts.status,
      },
    });
  },
  getStats: () => opstoolsDbConnectionClient.GetDbConnectionStats({}) as Promise<DbConnectionStats>,
  create: (data: Partial<DbConnection>) =>
    opstoolsDbConnectionClient.CreateDbConnection({ data }) as Promise<DbConnection>,
  update(id: number, data: Partial<DbConnection>) {
    const updateMask = buildUpdateMask(data as Record<string, unknown>);
    return opstoolsDbConnectionClient.UpdateDbConnection({ id, data, updateMask }) as Promise<unknown>;
  },
  delete: (id: number) => opstoolsDbConnectionClient.DeleteDbConnection({ id }) as Promise<unknown>,
  // persist=true 且 data.id>0：测试结果落库 last_test_*（卡片快捷测试健康展示，§2.9.4）；
  // 缺省 false：编辑弹窗内"表单当前参数"试测不污染健康状态。
  test: (data: Partial<DbConnection>, persist?: boolean) =>
    opstoolsDbConnectionClient.TestDbConnection({
      data,
      persist: persist || undefined,
    }) as Promise<TestDbConnectionResponse>,
  // 深度检查：实时采集运行指标（版本/连接/吞吐/缓存/健康/存储），并同步刷新 last_test_* 健康状态（§2.9.5）。
  // 建连失败为结果数据（success=false + errorReason），非 HTTP 错误；部分组失败降级 warnings。
  inspect: (id: number) =>
    opstoolsDbConnectionClient.InspectDbConnection({ id }) as Promise<InspectDbConnectionResponse>,
  // 指标趋势（16-03 M2）：window=1h/6h/24h/7d/30d/90d；keys 空=注册表默认集；step=auto 分层降采样。
  trends: (id: number, opts: { window?: string; keys?: string[]; step?: string } = {}) =>
    opstoolsDbConnectionClient.GetDbConnectionTrends({
      id,
      window: opts.window || undefined,
      keys: opts.keys,
      step: opts.step || undefined,
    }) as Promise<GetDbConnectionTrendsResponse>,
  // 会话列表（16-03 M5）：只读查询当前会话（processlist/pg_stat_activity/v$session）；
  // sqlite/权限不足降级 warning；建连失败为结果数据（success=false + errorReason）。
  sessions: (id: number, limit?: number) =>
    opstoolsDbConnectionClient.ListDbConnectionSessions({
      id,
      limit: limit && limit > 0 ? limit : undefined,
    }) as Promise<ListDbConnectionSessionsResponse>,
};

// ---- 文件流下载（自定义路由非 proto；axios blob + Bearer 头，经网关鉴权）----
function jsonFileName(prefix: string): string {
  const d = new Date();
  const pad = (n: number) => String(n).padStart(2, '0');
  return `${prefix}_${d.getFullYear()}${pad(d.getMonth() + 1)}${pad(d.getDate())}_${pad(d.getHours())}${pad(d.getMinutes())}${pad(d.getSeconds())}.json`;
}

async function downloadJsonFile(url: string, filename: string, params?: Record<string, unknown>) {
  const cleaned: Record<string, string> = {};
  if (params) {
    for (const [k, v] of Object.entries(params)) {
      if (v !== undefined && v !== null && v !== '') cleaned[k] = String(v);
    }
  }
  const blob = await request.get<Blob>(url, {
    params: Object.keys(cleaned).length > 0 ? cleaned : undefined,
    responseType: 'blob',
    timeout: 120000,
  });
  downloadBlob(blob, filename);
}

// ===================== 语音精灵（19 模块，voice 服务） =====================
// 裸 HTTP 路由（非 proto），统一 {code, message, data} 信封；错误码段 42000-42099。
export interface VoiceSessionEntity {
  id?: string; // 会话 ID
  user_id?: number; // 用户 ID
  channel?: string; // 通道：ue（UE 大屏）/ web
  state?: string; // 状态：idle / listening / thinking / speaking
  last_active_at?: number; // 最后活跃时间（unix 秒）
}

export interface VoiceEnvelope<T> {
  code: number;
  message: string;
  data: T;
}

export const voiceSessionService = {
  // 在线会话列表（无分页：返回全部在线会话）
  async list(): Promise<VoiceSessionEntity[]> {
    const resp = await request.get<VoiceEnvelope<VoiceSessionEntity[] | null>>('/api/v1/monitor/voice/sessions');
    return resp.data ?? [];
  },
  // 强制下线（19.12 管理页）：code=0 成功；code=42002 会话不存在或已离线（HTTP 200，
  // 业务错误不经 axios 拦截器，由页面据 envelope.code 提示）。
  kick(sessionID: string) {
    return request.delete<VoiceEnvelope<{ kicked?: boolean }>>(
      `/api/v1/monitor/voice/sessions/${encodeURIComponent(sessionID)}`,
    );
  },
};

// 语音引擎健康（GET /health：模型加载态 + aranea 连通态 + 能力降级面 + 在线会话数；仪表盘 AI 全景格用）
export interface VoiceHealthEntity {
  status?: string; // ok / degraded
  models?: Record<string, string>; // kws/asr/tts/vad → ready / missing
  aranea?: string; // connected / unreachable / unconfigured
  // C8 能力降级面：orchestration（aranea 编排 ready/degraded/unavailable）、
  // report_generation（报告生成 ready/unavailable）、readonly_intents（Top10 只读意图降级引擎，恒 ready）
  capabilities?: Record<string, string>;
  degraded_reason?: string; // model_missing:kws,asr / aranea_unreachable / aranea_runtime_degraded（| 连接）
  sessions_online?: number;
}

export const voiceHealthService = {
  async get(): Promise<VoiceHealthEntity> {
    const resp = await request.get<VoiceEnvelope<VoiceHealthEntity>>('/api/v1/monitor/voice/health');
    return resp.data ?? {};
  },
};

// ---- 语音指令审计（sprite_interactions，ops 服务裸 REST；详设 12 增补章节）----
export interface SpriteInteractionEntity {
  id?: number;
  trace_id?: string; // 全链路追踪 ID（贯穿 aranea 编排日志）
  session_id?: string; // 语音会话 ID（= aranea WS 会话键）
  channel?: string; // ue / web
  user_id?: number;
  asr_text?: string; // 指令原文
  intent?: string;
  slots?: Record<string, unknown> | null; // 槽位（aranea final）
  scene_actions?: unknown[] | null; // 场景控制族指令
  tool_calls?: unknown[] | null; // 工具调用留痕（预留，aranea 契约扩展后回填）
  say_text?: string; // 播报话术
  safety_level?: string; // L1/L2/L3
  confirm_result?: string; // none/voice_confirmed/click_confirmed/rejected/timeout
  status?: string; // success/failed/cancelled/clarifying
  error_message?: string;
  duration_ms?: number;
  degraded?: boolean; // aranea 不可用走降级规则引擎
  created_at?: string;
}

export const spriteInteractionService = {
  // 分页查询（契约：GET /api/v1/monitor/ops/sprite-interactions，envelope.data={list,total}）
  async list(
    opts: {
      page?: number;
      pageSize?: number;
      traceId?: string;
      sessionId?: string;
      userId?: number;
      status?: string;
    } = {},
  ): Promise<{ list: SpriteInteractionEntity[]; total: number }> {
    const resp = await request.get<VoiceEnvelope<{ list: SpriteInteractionEntity[] | null; total?: number }>>(
      '/api/v1/monitor/ops/sprite-interactions',
      {
        params: {
          page: opts.page ?? 1,
          page_size: opts.pageSize ?? 20,
          trace_id: opts.traceId || undefined,
          session_id: opts.sessionId || undefined,
          user_id: opts.userId,
          status: opts.status || undefined,
        },
      },
    );
    return { list: resp.data?.list ?? [], total: resp.data?.total ?? 0 };
  },
};

