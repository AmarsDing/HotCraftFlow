  version: number;
  grid?: PanelLayoutGrid;
  panels: PanelLayoutEntry[];
}
export interface PanelTemplateEntity extends CrudEntity {
  deviceCategoryId?: number;
  name?: string;
  layout?: string;
  isDefault?: number;
  status?: number;
  remark?: string;
}
export const panelTemplateService = {
  list: (params: { deviceCategoryId?: number; status?: number; keyword?: string; page?: number; pageSize?: number }) =>
    panelTemplateClient.ListPanelTemplates({
      page: params.page ?? 1,
      pageSize: params.pageSize ?? 20,
      ...params,
    }) as Promise<ListResponse<PanelTemplateEntity>>,
  get: (id: string | number) =>
    panelTemplateClient.GetPanelTemplate({ id: Number(id) }) as Promise<PanelTemplateEntity>,
  create: (data: Partial<PanelTemplateEntity>) =>
    panelTemplateClient.CreatePanelTemplate({ data: data as never }) as Promise<unknown>,
  update: (id: string | number, data: Partial<PanelTemplateEntity>) => {
    const updateMask = buildUpdateMask(data as Record<string, unknown>);
    return panelTemplateClient.UpdatePanelTemplate({
      id: Number(id),
      data: data as never,
      updateMask,
    }) as Promise<unknown>;
  },
  delete: (id: string | number) =>
    panelTemplateClient.DeletePanelTemplate({ id: Number(id) }) as Promise<unknown>,
  // 按设备解析面板：显式 templateId → 分类默认 → 通用兜底（categoryId=0）
  // deviceId 为可选反查键：仅传 device_id 的触点（3D/拓扑/详情弹窗）由后端补全分类与绑定（P1-1）。
  resolve: (params: { templateId?: number; deviceCategoryId?: number; deviceId?: number }) =>
    panelTemplateClient.ResolveDevicePanel({
      templateId: params.templateId || undefined,
      deviceCategoryId: params.deviceCategoryId || undefined,
      deviceId: params.deviceId || undefined,
