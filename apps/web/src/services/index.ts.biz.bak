  lastTestStatus?: string;
  description?: string;
}
// 告警源类型及动态表单 configSchema（GET /sources/types）
export interface AlertSourceTypeEntity {
  sourceType?: string;
  displayName?: string;
  configSchema?: Record<string, unknown>;
  description?: string;
}
// 连接测试结果
export interface AlertSourceTestResult {
  success?: boolean;
  error?: string;
  externalEventId?: number;
}
// token 旋转结果（新 secret 仅在响应中可见一次）
export interface AlertSourceRotateResult {
  webhookToken?: string;
  webhookSecret?: string;
  webhookUrl?: string;
}
// 接入指南文案
export interface AlertSourceGuideEntity {
  sourceType?: string;
  guideMarkdown?: string;
  webhookUrl?: string;
}
export const alertSourceService = {
  list(opts: PagingRequest & { formValues?: Record<string, unknown> } = {}) {
    const params = buildQueryParams(opts.formValues, opts);
    const fv = opts.formValues ?? {};
    return alertSourceClient.ListAlertSources({
      sourceType: fv.sourceType as string | undefined,
      isEnabled: fv.isEnabled as number | undefined,
      keyword: fv.keyword as string | undefined,
      page: params.page ? Number(params.page) : undefined,
      pageSize: params.pageSize ? Number(params.pageSize) : undefined,
    }) as Promise<ListResponse<AlertSourceEntity>>;
  },
  get(id: string | number) {
    return alertSourceClient.GetAlertSource({ id: Number(id) }) as Promise<AlertSourceEntity>;
  },
  create(data: Partial<AlertSourceEntity>) {
    // 创建响应含完整 webhook_url（一次性复制）
    return alertSourceClient.CreateAlertSource({ data: data as never }) as Promise<AlertSourceEntity>;
  },
  update(id: string | number, data: Partial<AlertSourceEntity>) {
    return alertSourceClient.UpdateAlertSource({ id: Number(id), data: data as never }) as Promise<unknown>;
  },
  delete(id: string | number) {
    return alertSourceClient.DeleteAlertSource({ id: Number(id) }) as Promise<unknown>;
  },
  // 发送测试告警（连接测试），走完整接收→字段映射→级别归一化链路
  test(id: string | number) {
    return alertSourceClient.TestAlertSource({ id: Number(id) }) as Promise<AlertSourceTestResult>;
  },
  updateStatus(id: string | number, isEnabled: number) {
    return alertSourceClient.UpdateAlertSourceStatus({ id: Number(id), isEnabled }) as Promise<unknown>;
  },
  // 旋转 Webhook token/secret，旧值立即失效
  rotateToken(id: string | number, rotateSecret: boolean) {
    return alertSourceClient.RotateAlertSourceToken({
      id: Number(id),
      rotateSecret,
    }) as Promise<AlertSourceRotateResult>;
  },
  // 支持的告警源类型及动态表单 configSchema
  listTypes() {
    return alertSourceClient.ListAlertSourceTypes({}) as Promise<{ items?: AlertSourceTypeEntity[] }>;
  },
  getGuide(id: string | number) {
    return alertSourceClient.GetAlertSourceGuide({ id: Number(id) }) as Promise<AlertSourceGuideEntity>;
  },
};

