    return monitorQueryClient.GetOpsOverlay({});
  },
};

// ---- 统一气象时间轴（气象数据存储分层 P1-T7，详设 2026-08-21 方案 §6.4）----
// 跨 radar/windfield/metar/taf/satellite/flight 六域查 weather_timeline 只读视图，
// 分桶聚合输出 count+sampleRefs，替代前端"逐域查 files 表"；时间窗强制 ≤7d。
export type {
  GetWeatherTimelineRequest,
  WeatherTimelineBucket,
  WeatherTimelineResponse,
} from './kratos/monitorquery/service/v1';
export const weatherTimelineService = {
  /** 统一时间轴分桶查询：domains 逗号分隔（空=六域全量）；granularity auto/6min/10min/1h */
  getTimeline(
    opts: {
      domains?: string;
      startTime?: string;
      endTime?: string;
      granularity?: string;
      maxSamples?: number;
    } = {},
  ) {
    return monitorQueryClient.GetWeatherTimeline({
      domains: opts.domains || undefined,
      startTime: opts.startTime || undefined,
      endTime: opts.endTime || undefined,
      granularity: opts.granularity || undefined,
      maxSamples: opts.maxSamples ?? undefined,
    });
  },
};

