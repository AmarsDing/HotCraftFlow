// ---- Compose 编排（compose_projects 表；up/down/restart 经 docker compose CLI） ----
// 项目状态：stopped-已停止 / deploying-部署中 / running-运行中 / error-异常
export interface VirtmanComposeProjectEntity {
  id?: number;
  name?: string;
  description?: string;
  endpoint_id?: number;
  yaml_content?: string;
  status?: string;
  service_count?: number;
  running_count?: number;
  last_operation?: string;
  last_operation_at?: string;
  validated_at?: string;
  created_at?: string;
  updated_at?: string;
}

export interface VirtmanComposeProjectInput {
  name: string;
  description?: string;
  endpoint_id: number;
  yaml_content: string;
}

export interface VirtmanComposeYamlError {
  line?: number;
  message?: string;
}

// 语法验证结果（失败时后端 400 + data.valid=false，axios 拦截器提示 message，
// 调用方 catch 时无法拿到 data —— 故 validate 用 raw request 自行处理响应）
export interface VirtmanComposeValidateResult {
  valid?: boolean;
  errors?: VirtmanComposeYamlError[];
  services?: string[];
}

export interface VirtmanComposeServiceItem {
  name?: string;
  image?: string;
  status?: string;
  ports?: string[];
}

// Compose 列表统计卡片（响应 data.summary；口径=当前端点筛选）
export interface VirtmanComposeSummary {
  total?: number;
  running?: number;
  stopped?: number;
  deploying?: number;
  error?: number;
}

export const virtmanComposeService = {
  list(opts: { page?: number; pageSize?: number; endpointId?: number; keyword?: string; status?: string } = {}) {
    return unwrapVirt(
      request.get<
        VirtEnvelope<{ items: VirtmanComposeProjectEntity[]; total: number; summary?: VirtmanComposeSummary }>
      >(`${VIRT_BASE}/compose/projects`, {
        params: {
          page: opts.page ?? 1,
          pageSize: opts.pageSize ?? 10,
          endpoint_id: opts.endpointId || undefined,
          keyword: opts.keyword || undefined,
          status: opts.status || undefined,
        },
      }),
    );
  },
  get(id: number) {
    return unwrapVirt(request.get<VirtEnvelope<VirtmanComposeProjectEntity>>(`${VIRT_BASE}/compose/projects/${id}`));
  },
  create(data: VirtmanComposeProjectInput) {
    return unwrapVirt(request.post<VirtEnvelope<VirtmanComposeProjectEntity>>(`${VIRT_BASE}/compose/projects`, data));
  },
  update(id: number, data: VirtmanComposeProjectInput) {
    return unwrapVirt(request.put<VirtEnvelope<unknown>>(`${VIRT_BASE}/compose/projects/${id}`, data));
  },
  remove(id: number) {
    return unwrapVirt(request.delete<VirtEnvelope<unknown>>(`${VIRT_BASE}/compose/projects/${id}`));
  },
  // YAML 语法验证：不 unwrap —— 失败 400 时 response.data.errors 明细需自行取用，
  // 绕过拦截器统一错误提示（由调用方展示 errors 列表）。
  validate(yamlContent: string) {
    return request.post<VirtEnvelope<VirtmanComposeValidateResult>>(
      `${VIRT_BASE}/compose/projects/validate`,
      { yaml_content: yamlContent },
      { skipErrorNotify: true } as Record<string, unknown>,
    );
  },
  up(id: number) {
    return unwrapVirt(request.post<VirtEnvelope<unknown>>(`${VIRT_BASE}/compose/projects/${id}/up`));
  },
  down(id: number) {
    return unwrapVirt(request.post<VirtEnvelope<unknown>>(`${VIRT_BASE}/compose/projects/${id}/down`));
  },
  restart(id: number) {
    return unwrapVirt(request.post<VirtEnvelope<unknown>>(`${VIRT_BASE}/compose/projects/${id}/restart`));
  },
  services(id: number) {
    return unwrapVirt(
      request.get<VirtEnvelope<{ items: VirtmanComposeServiceItem[]; total: number }>>(
        `${VIRT_BASE}/compose/projects/${id}/services`,
      ),
    );
  },
  // 聚合日志（text/plain 纯文本，非信封）
  logs(id: number, tail = 100) {
    return request.get<string>(`${VIRT_BASE}/compose/projects/${id}/logs`, {
      params: { tail },
      responseType: 'text',
    });
  },
};

