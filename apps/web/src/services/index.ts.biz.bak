// ---- VNC 服务端安装介质（远程桌面配套：目标设备需自装 TightVNC/TigerVNC，介质托管在服务端随环境部署）----
// 清单/下载均为手写路由（非 proto）：GET /api/v1/monitor/opstools/vnc-tools[/{file}]，白名单文件名。
export interface VncToolItem {
  file: string; // 文件名（下载用）
  name: string; // 产品名
  os: 'windows' | 'linux';
  kind: 'installer' | 'package' | 'script';
  version: string;
  sizeBytes: number;
}
export const opstoolsVncToolsService = {
  // 介质清单（目录中实际存在的文件；未部署时返回空数组，不阻断页面）
  list() {
    return request
      .get<{ items: VncToolItem[] }>('/api/v1/monitor/opstools/vnc-tools', { timeout: 15000 })
      .then((r) => (r as unknown as { items: VncToolItem[] }).items ?? []);
  },
  // 介质下载（blob 流，文件名保持服务端原名）
  download(file: string) {
    return request
      .get(`/api/v1/monitor/opstools/vnc-tools/${encodeURIComponent(file)}`, {
        responseType: 'blob',
        timeout: 300000,
      })
      .then((blob) => downloadBlob(blob as unknown as Blob, file));
  },
};

// ---- 统一远程会话审计（远程运维能力增强 B7；F1 远程记录页 / F4 在线徽标 / B9 二次确认令牌）----
export const opstoolsSessionService = {
  // 远程会话记录列表（type/assetId/operatorId/status/时间范围筛选，按 startedAt DESC）
  listSessions(
    opts: {
      page?: number;
      pageSize?: number;
      sessionType?: string;
      assetId?: number;
      operatorId?: number;
      status?: string;
      startTime?: string;
      endTime?: string;
    } = {},
  ) {
    return opstoolsSessionClient.ListSessions({
      page: opts.page ?? 1,
      pageSize: opts.pageSize ?? 20,
      sessionType: opts.sessionType || undefined,
      assetId: opts.assetId,
      operatorId: opts.operatorId,
      status: opts.status || undefined,
      startTime: opts.startTime,
      endTime: opts.endTime,
    }) as Promise<ListSessionsResponse>;
  },
  // 当前活跃远程会话（status=active，在线远程徽标数据源；assetId 可选过滤）
  listActiveSessions(assetId?: number) {
    return opstoolsSessionClient.ListActiveSessions({ assetId }) as Promise<ListActiveSessionsResponse>;
  },
  // 签发高危资产远程会话二次确认令牌（一次性，随 connect/open/wake 请求携带）
  issueSessionConfirm(assetId: number, sessionType: string) {
    return opstoolsSessionClient.IssueSessionConfirm({
      assetId,
      sessionType,
    }) as Promise<IssueSessionConfirmResponse>;
  },
};

// ---- 命令执行与历史（详设 §2.6）----
export const opstoolsCommandService = {
  execute: (req: ExecuteCommandRequest) => opstoolsCommandClient.ExecuteCommand(req) as Promise<ExecuteCommandResponse>,
  // protoc-gen-typescript-http 生成的 GET 客户端对 boolean 按真值判断，success=false/blocked=false
  // 筛选会被丢弃（与 dangerRule list 同类问题）；列表改走 axios 直传 params（false 值保留）。
  listHistory(opts: Omit<ListCommandHistoryRequest, 'page' | 'pageSize'> & { page?: number; pageSize?: number } = {}) {
    return request.get<OpstoolsListResponse<CommandExecution>>('/api/v1/monitor/opstools/commands/history', {
      params: {
        page: opts.page ?? 1,
        pageSize: opts.pageSize ?? 10,
        assetId: opts.assetId,
        operatorId: opts.operatorId,
        success: opts.success,
        blocked: opts.blocked,
        batchId: opts.batchId || undefined,
        commandKeyword: opts.commandKeyword || undefined,
        startTime: opts.startTime,
        endTime: opts.endTime,
      },
    });
  },
  // 高频命令聚合（常用命令智能推荐：近 N 天成功执行命令按次数降序）
  listFrequent(opts: { days?: number; limit?: number } = {}) {
    return opstoolsCommandClient.ListFrequentCommands({
      days: opts.days ?? 7,
      limit: opts.limit ?? 8,
    }) as Promise<ListFrequentCommandsResponse>;
  },
  // 取消批量执行批次（命令库增强 §6.3：仅终止未开始的设备，执行中设备由单台超时兜底）
  cancelBatch: (batchId: string) => opstoolsCommandClient.CancelBatch({ batchId }) as Promise<{ cancelled?: boolean }>,
  // 历史导出（JSON 文件流，自定义路由非 proto；筛选参数与 ListCommandHistory 一致，上限 10000 条）
  exportHistory(opts: Omit<ListCommandHistoryRequest, 'page' | 'pageSize'> = {}) {
    return downloadJsonFile(
      '/api/v1/monitor/opstools/commands/history/export',
      jsonFileName('command_history'),
      opts as Record<string, unknown>,
    );
  },
};

