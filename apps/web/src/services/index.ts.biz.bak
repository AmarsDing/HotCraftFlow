// 变更（change_records，详细设计 §1.29/§2.9）
export interface ChangeRecordEntity extends CrudEntity {
  changeNo?: string;
  changeType?: string; // device_config-设备配置变更/system_config-系统配置变更/software_update-软件升级/hardware_replace-硬件更换
  targetType?: string; // device-设备/system-系统/software-软件
  targetId?: number;
  title?: string;
  description?: string;
  beforeData?: Record<string, unknown>; // 变更前数据 JSON
  afterData?: Record<string, unknown>; // 变更后数据 JSON
  riskLevel?: string; // low/medium/high
  applicantId?: number;
  approverId?: number;
  approvalComment?: string;
  approvedAt?: string;
  status?: string; // pending-待审批/approved-已审批/rejected-已驳回/executing-执行中/completed-已完成/rollback-已回滚
  executedAt?: string;
  executorId?: number;
  executionResult?: string;
  manageDeptId?: number;
  remark?: string;
  applicantName?: string;
  approverName?: string;
  executorName?: string;
  creatorName?: string;
  manageDeptName?: string;
  targetName?: string;
}

export const changeService = {
  ...makeCrudServiceFromClient<ChangeRecordEntity>(changeClient),
  // 变更审批：approved=true 通过 / false 驳回，comment 为审批意见
  approve(id: string | number, approved: boolean, comment?: string) {
    return changeClient.Approve({ id: Number(id), approved, comment }) as Promise<unknown>;
  },
  // 变更执行登记：action=start/complete/rollback，executionResult 为执行结果或回滚说明
  execute(id: string | number, action: string, executionResult?: string) {
    return changeClient.Execute({ id: Number(id), action, executionResult }) as Promise<unknown>;
  },
};

// 事件（incident_records，详细设计 §1.30/§2.10）
// 受影响设备/时间线元素为后端 structpb 透传 JSON，键名为 snake_case（与 biz 校验/写入对齐）
export interface IncidentAffectedDevice {
  device_id?: number;
  device_name?: string;
  impact?: string;
}

export interface IncidentTimelineNode {
  time?: string;
  event_type?: string;
  description?: string;
}

export interface IncidentRecordEntity extends CrudEntity {
  incidentNo?: string;
  title?: string;
  severity?: string; // minor-一般/major-重大/critical-特别重大
  description?: string;
  affectedDevices?: IncidentAffectedDevice[]; // 受影响设备 JSON 数组
  affectScope?: string;
  timeline?: IncidentTimelineNode[]; // 事件时间线 JSON 数组
  rootCause?: string;
  resolution?: string;
  escalationLevel?: number; // 0-未升级 1-一级 2-二级 3-三级
  escalatedTo?: number;
  escalatedAt?: string;
  reviewResult?: string;
  reviewedBy?: number;
  reviewedAt?: string;
  status?: string; // open-处理中/resolved-已解决/closed-已关闭/reviewed-已复盘
  closedAt?: string;
  manageDeptId?: number;
  creatorName?: string;
  escalatedToName?: string;
  reviewedByName?: string;
  manageDeptName?: string;
}

export const incidentService = {
  ...makeCrudServiceFromClient<IncidentRecordEntity>(incidentClient),
  // 事件升级：escalationLevel 必须大于当前级别
  escalate(id: string | number, escalationLevel: number, escalatedTo?: number, reason?: string) {
    return incidentClient.Escalate({ id: Number(id), escalationLevel, escalatedTo, reason }) as Promise<unknown>;
  },
  // 事件解决：填写根本原因与处理措施
  resolve(id: string | number, rootCause?: string, resolution?: string) {
    return incidentClient.Resolve({ id: Number(id), rootCause, resolution }) as Promise<unknown>;
  },
  // 事件复盘：填写复盘结果
  review(id: string | number, reviewResult: string) {
    return incidentClient.Review({ id: Number(id), reviewResult }) as Promise<unknown>;
  },
};

