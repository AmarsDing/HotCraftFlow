};

// ===================== Notice: 通知统计 =====================
// 2026-09-15 P2-2 维度深化：级别/类型/模板/失败原因/重试分布/投递时延。
// 计数均为 proto uint32 → JSON number（不适用 int64 字符串化陷阱），无需 normalize。
export interface NoticeDimensionStatEntity {
  key: string;
  total: number;
  success: number;
  failed: number;
}
export interface NoticeStatisticsEntity {
  totalSent?: number;
  totalSuccess?: number;
  totalFailed?: number;
  successRate?: number;
  channelStats?: Array<{ channel: string; total: number; success: number; failed: number }>;
  levelStats?: NoticeDimensionStatEntity[];
  typeStats?: NoticeDimensionStatEntity[];
  templateStats?: NoticeDimensionStatEntity[];
  topFailureReasons?: Array<{ reason: string; count: number }>;
  retryDistribution?: Array<{ retryCount: number; count: number }>;
  latency?: { avgMs?: number; p50Ms?: number; p95Ms?: number };
}
export interface NoticeTrendPointEntity {
  timestamp: string;
  total: number;
  success: number;
  failed: number;
}
export const noticeStatisticsService = {
  getStatistics(startTime?: string, endTime?: string) {
    return noticeStatisticsClient.GetStatistics({ startTime, endTime }) as Promise<NoticeStatisticsEntity>;
  },
  getStatisticsTrend(startTime?: string, endTime?: string, granularity = 'day') {
    return noticeStatisticsClient.GetStatisticsTrend({ startTime, endTime, granularity }) as Promise<{
      points: NoticeTrendPointEntity[];
    }>;
  },
};

