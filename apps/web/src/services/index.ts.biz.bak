// 阶段1D 框架搭建：导出原始客户端供 placeholder 页面引用，具体 service 包装将在阶段3实现。

// ---- 3D 场景管理 ----
export interface SceneEntity extends CrudEntity {
  name?: string;
  sceneType?: string;
  parentSceneId?: number;
  airportId?: number;
  filePath?: string;
  description?: string;
  roomInfo?: Record<string, unknown>;
  defaultCamera?: Record<string, unknown>;
  sort?: number;
  status?: number;
  remark?: string;
  // ---- 只读聚合统计（List 批量回填，Create/Update 忽略） ----
  deviceCount?: number;
  layoutItemCount?: number;
  modelCount?: number;
  layoutUpdateTime?: string;
}
// 场景依赖的 3D 模型项（device_3d_models 只读投影 + 引用计数）
export interface SceneModelDependencyEntity {
  modelId?: number;
  name?: string;
  fileFormat?: string;
  fileSize?: number;
  version?: number;
  lastSyncedAt?: string;
  thumbnailPath?: string;
  refCount?: number;
}
// 场景版本快照（p3d_scene_versions）
export interface SceneVersionEntity {
  id?: number;
  sceneId?: number;
  versionNo?: number;
  changeSummary?: string;
  snapshot?: Record<string, unknown>;
  createTime?: string;
  createBy?: number;
}
// 机场场景树节点
export interface AirportTreeNodeEntity {
  id: number;
  name: string;
  sceneType: string;
  children?: AirportTreeNodeEntity[];
}
// 场景设备绑定项（布局文档投影，UE spawn 数据源）
export interface SceneDeviceEntity {
  deviceId?: number;
  assetCode?: string;
  deviceName?: string;
  sceneId?: number;
  positionX?: number;
  positionY?: number;
  positionZ?: number;
  rotationX?: number;
  rotationY?: number;
  rotationZ?: number;
  scaleX?: number;
  scaleY?: number;
  scaleZ?: number;
  modelId?: string;
}
export const sceneService = {
  list: (params: {
    sceneType?: string;
    status?: number;
    keyword?: string;
    parentSceneId?: number;
    airportId?: number;
    page?: number;
    pageSize?: number;
    orderBy?: string;
  }) =>
    sceneClient.ListScenes({ page: params.page ?? 1, pageSize: params.pageSize ?? 10, ...params }) as Promise<
      ListResponse<SceneEntity>
    >,
  get: (id: string | number) => sceneClient.GetScene({ id: Number(id) }) as Promise<SceneEntity>,
  create: (data: Partial<SceneEntity>) => sceneClient.CreateScene({ data: data as never }) as Promise<unknown>,
  update: (id: string | number, data: Partial<SceneEntity>) => {
    const updateMask = buildUpdateMask(data as Record<string, unknown>);
    return sceneClient.UpdateScene({ id: Number(id), data: data as never, updateMask }) as Promise<unknown>;
  },
  delete: (id: string | number) => sceneClient.DeleteScene({ id: Number(id) }) as Promise<unknown>,
  getAirportTree: () => sceneClient.GetAirportTree({}) as Promise<{ items?: AirportTreeNodeEntity[] }>,
  listChildren: (id: string | number, params?: { page?: number; pageSize?: number }) =>
    sceneClient.ListChildScenes({
      id: Number(id),
      page: params?.page ?? 1,
      pageSize: params?.pageSize ?? 100,
    }) as Promise<ListResponse<SceneEntity>>,
  listDevices: (id: string | number) =>
    sceneClient.ListSceneDevices({ id: Number(id) }) as Promise<{ items?: SceneDeviceEntity[] }>,
  // 场景依赖的 3D 模型清单（布局文档 modelId 聚合，UE5 模型同步排查用）
  listModelDependencies: (id: string | number) =>
    sceneClient.ListSceneModelDependencies({ id: Number(id) }) as Promise<{ items?: SceneModelDependencyEntity[] }>,
  // ---- 场景版本（追加写，回退生成新版本） ----
  listVersions: (sceneId: string | number, params?: { page?: number; pageSize?: number }) =>
    sceneClient.ListSceneVersions({
      sceneId: Number(sceneId),
      page: params?.page ?? 1,
      pageSize: params?.pageSize ?? 20,
    }) as Promise<ListResponse<SceneVersionEntity>>,
  getVersion: (sceneId: string | number, versionNo: number) =>
    sceneClient.GetSceneVersion({ sceneId: Number(sceneId), versionNo }) as Promise<SceneVersionEntity>,
  rollbackVersion: (sceneId: string | number, versionNo: number) =>
    sceneClient.RollbackSceneVersion({ sceneId: Number(sceneId), versionNo }) as Promise<unknown>,
  // ---- 场景布局 content 文档（O7.2 文档级契约，If-Match/expectedRevision 乐观并发） ----
  getContent: (sceneId: number) => sceneLayoutClient.GetSceneContent({ sceneId }) as Promise<SceneContentDocument>,
  putContent: (sceneId: number, items: SceneContentItem[], expectedRevision: number) =>
    sceneLayoutClient.PutSceneContent({ sceneId, items, expectedRevision }) as Promise<SceneContentDocument>,
  // ---- 编辑器底图（§6.3 room_info.floorplan） ----
  // 上传底图到 scenes/floorplans/<uuid>.<ext>，返回存储相对路径（消费方用 file:download?path= 读取）
  uploadFloorplan(file: File): Promise<string> {
    const ext = (file.name.split('.').pop() || 'png').toLowerCase();
    return uploadToBucket(file, `floorplans/${crypto.randomUUID()}.${ext}`, undefined, 'scenes');
  },
  // 拉取底图 Blob（行内预览用，Authorization 头由 request 拦截器注入）
  fetchFloorplanBlob(relPath: string): Promise<Blob> {
    return request.get<Blob>('/api/v1/monitor/file:download', {
      params: { path: relPath },
      responseType: 'blob',
    });
  },
};

// 场景布局 content 类型（O7.2 起替代 SceneDeviceBinding 逐设备绑定写）
export type { SceneContentDocument, SceneContentItem };

// ---- 拓扑管理 ----
export interface TopologyEntity extends CrudEntity {
  name?: string;
  type?: string;
  renderMode?: string;
  sceneId?: number;
  layoutType?: string;
  autoDiscover?: number;
  sort?: number;
  status?: number;
  remark?: string;
}
export const topologyService = {
  list: (params: { type?: string; status?: number; keyword?: string; page?: number; pageSize?: number }) =>
    topologyClient.ListTopologies({ page: params.page ?? 1, pageSize: params.pageSize ?? 10, ...params }) as Promise<
      ListResponse<TopologyEntity>
    >,
  get: (id: string | number) => topologyClient.GetTopology({ id: Number(id) }) as Promise<TopologyDetailEntity>,
  create: (data: Partial<TopologyEntity>) => topologyClient.CreateTopology({ data: data as never }) as Promise<unknown>,
  update: (id: string | number, data: Partial<TopologyEntity>) => {
    const updateMask = buildUpdateMask(data as Record<string, unknown>);
    return topologyClient.UpdateTopology({ id: Number(id), data: data as never, updateMask }) as Promise<unknown>;
  },
  delete: (id: string | number) => topologyClient.DeleteTopology({ id: Number(id) }) as Promise<unknown>,
  // 查询拓扑运行时状态（topology_runtime_states：node_states/link_states 快照）
  getRuntime: (id: string | number) =>
    topologyClient.GetTopologyRuntime({ id: Number(id) }) as Promise<{
      configId?: number;
      nodeStates?: Record<string, unknown>;
      linkStates?: Record<string, unknown>;
    }>,
  // ---- 拓扑节点/连线编辑（3.1.3 编辑器） ----
  addNode: (configId: number, data: Partial<TopologyNodeEntity>) =>
    topologyClient.AddNode({ configId, data: data as never }) as Promise<unknown>,
  updateNode: (id: number, data: Partial<TopologyNodeEntity>) => {
    const updateMask = buildUpdateMask(data as Record<string, unknown>);
    return topologyClient.UpdateNode({ id, data: data as never, updateMask }) as Promise<unknown>;
  },
  deleteNode: (id: number) => topologyClient.DeleteNode({ id }) as Promise<unknown>,
  addLink: (configId: number, data: Partial<TopologyLinkEntity>) =>
    topologyClient.AddLink({ configId, data: data as never }) as Promise<unknown>,
  updateLink: (id: number, data: Partial<TopologyLinkEntity>) => {
    const updateMask = buildUpdateMask(data as Record<string, unknown>);
    return topologyClient.UpdateLink({ id, data: data as never, updateMask }) as Promise<unknown>;
  },
  deleteLink: (id: number) => topologyClient.DeleteLink({ id }) as Promise<unknown>,
  // 触发拓扑自动发现（对接 08 线路监控拓扑，增量同步节点/连线）
  discover: (id: number | string) =>
    topologyClient.DiscoverTopology({ id: Number(id) }) as Promise<{
      addedNodes?: number;
      updatedNodes?: number;
      addedLinks?: number;
      updatedLinks?: number;
    }>,
  // 触发 3D 自动布局（按拓扑配置 layoutType 重排全部节点坐标）
  autoLayout3D: (id: number | string) => topologyClient.AutoLayout3D({ id: Number(id) }) as Promise<unknown>,
  // 按设备ID反查拓扑节点落位（设备 360° 抽屉「空间」Tab 数据源，可视化信息关联重组 P1）
  listNodesByDevice: (deviceId: number) =>
    topologyClient.ListTopologyNodesByDevice({ deviceId }) as Promise<{ items?: TopologyNodePlacementEntity[] }>,
};

// 拓扑节点落位（对应 proto TopologyNodePlacement，设备 360° 抽屉「空间」Tab 条目）
