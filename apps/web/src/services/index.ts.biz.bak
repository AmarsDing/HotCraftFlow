/** 当前航段信息（仅 legMode=CURRENT 返回；与 api/flight/v1 FlightLegInfo 对应）。 */
export interface FlightLegInfoEntity {
  startTime?: string;
  endTime?: string;
  pointCount?: number;
  windowPoints?: number;
}

export interface FlightTrackEntity {
  flightKey?: string;
  icao24?: string;
  callsign?: string;
  points?: FlightTrackPointEntity[];
  total?: number;
  /** 仅 legMode=CURRENT 返回；旧后端无此字段，前端按 undefined 处理。 */
  leg?: FlightLegInfoEntity;
}

export interface FlightStatsEntity {
  activeFlights?: number;
  airborneFlights?: number;
  totalPositions?: number;
  sourcesTotal?: number;
  sourcesOn?: number;
  trackPointsTotal?: number;
  lastReceiveTime?: string;
  asterixFramesPerMin?: number;
  asterixDecodeErrorsPerMin?: number;
}

export interface FlightPollStatusEntity {
  id?: number;
  lastPollAt?: string;
  lastStatus?: string;
  lastError?: string;
  nextPollAt?: string;
}

// 数据源接入测试（TestSourceAccess）：检查数据是否到达 + 是否准确。
// 拉取型（ADSB/RADAR/MOCK）试取一轮报文解析校验（不落库）；
// ASTERIX 观察窗模式（源须已保存且 ON），观察 observeSeconds 秒统计帧到达/解码错误。
export interface AccessTestIssueEntity {
  code?: string; // NO_FLIGHT_KEY/NO_POSITION/BAD_COORD/OUT_OF_REGION/TIME_SKEW/DECODE_ERRORS
  count?: number;
}

export interface AccessTestSampleEntity {
  flightKey?: string; // 航班键（拉取型）
  callsign?: string;
  icao24?: string;
  longitude?: number;
  latitude?: number;
  altitudeM?: number;
  asterixCat?: number; // ASTERIX 类目（帧抽样）
  recordsCount?: number; // 帧解码记录数（帧抽样）
  receiveTime?: string; // 接收时刻（帧抽样）
  status?: string; // 问题代码（拉取型，空=正常）/ 帧状态（ASTERIX）
  error?: string;
}

export interface TestSourceAccessParams {
  sourceId?: number; // 已保存源ID（>0 时空字段回退库内配置；ASTERIX 观察窗依赖该源监听）
  providerType?: string; // ADSB/RADAR/MOCK/ASTERIX
  endpointUrl?: string;
  credentialId?: number;
  lonMin?: number;
  lonMax?: number;
  latMin?: number;
  latMax?: number;
  asterixConfig?: string;
  observeSeconds?: number; // ASTERIX 观察窗秒数（3-20，默认 10）
}

export interface TestSourceAccessResult {
  configValid?: boolean;
  configErrors?: string[];
  dataArrived?: boolean;
  arrivalCode?: string; // OK/FETCH_FAILED/PARSE_FAILED/NO_TARGETS/NOT_LISTENING/NO_FRAMES
  arrivalDetail?: string;
  // 拉取型结果
  fetchedCount?: number;
  validCount?: number;
  // ASTERIX 结果
  framesReceived?: number;
  decodeErrorCount?: number;
  decodeErrorRate?: number; // 0-1
  listenerStatus?: string; // RUNNING/STOPPED/DEGRADED
  degraded?: boolean;
  issues?: AccessTestIssueEntity[];
  samples?: AccessTestSampleEntity[];
}

export const flightService = {
  // ---------- 数据源 ----------
  listSources(
    opts: {
      page?: number;
      pageSize?: number;
      keyword?: string;
      providerType?: string;
      status?: string;
    } = {},
  ): Promise<ListResponse<FlightSourceEntity>> {
    return request.get('/api/v1/monitor/flight/sources', {
      params: {
        page: opts.page ?? 1,
        pageSize: opts.pageSize ?? 10,
        keyword: opts.keyword || undefined,
        providerType: opts.providerType || undefined,
        status: opts.status || undefined,
      },
    }) as Promise<unknown> as Promise<ListResponse<FlightSourceEntity>>;
  },
  getSource(id: string | number): Promise<FlightSourceEntity> {
    return request.get(
      `/api/v1/monitor/flight/sources/${Number(id)}`,
    ) as Promise<unknown> as Promise<FlightSourceEntity>;
  },
  createSource(data: Partial<FlightSourceEntity>): Promise<unknown> {
    return request.post('/api/v1/monitor/flight/sources', { data });
  },
  updateSource(id: string | number, data: Partial<FlightSourceEntity>): Promise<unknown> {
    return request.put(`/api/v1/monitor/flight/sources/${Number(id)}`, { data });
  },
  deleteSource(id: string | number): Promise<unknown> {
    return request.delete(`/api/v1/monitor/flight/sources/${Number(id)}`);
  },
  triggerPoll(id: string | number): Promise<unknown> {
    return request.post(`/api/v1/monitor/flight/sources/${Number(id)}:trigger`);
  },
  getPollStatus(id: string | number): Promise<FlightPollStatusEntity> {
    return request.get(
      `/api/v1/monitor/flight/sources/${Number(id)}/status`,
    ) as Promise<unknown> as Promise<FlightPollStatusEntity>;
  },
  // 数据源接入测试（全提供方）：检查数据是否到达 + 是否准确。
  // 拉取型同步返回试取结果；ASTERIX 阻塞观察 observeSeconds 秒返回观察窗统计。
  testSourceAccess(params: TestSourceAccessParams): Promise<TestSourceAccessResult> {
    return request.post('/api/v1/monitor/flight/sources:test', {
      sourceId: params.sourceId || undefined,
      providerType: params.providerType || undefined,
      endpointUrl: params.endpointUrl || undefined,
      credentialId: params.credentialId || undefined,
      lonMin: params.lonMin ?? undefined,
      lonMax: params.lonMax ?? undefined,
      latMin: params.latMin ?? undefined,
      latMax: params.latMax ?? undefined,
      asterixConfig: params.asterixConfig || undefined,
      observeSeconds: params.observeSeconds || undefined,
    }) as Promise<unknown> as Promise<TestSourceAccessResult>;
  },
  // ---------- 实时位置 ----------
  listPositions(
    opts: {
      page?: number;
      pageSize?: number;
      keyword?: string;
      sourceId?: number;
      airborneOnly?: boolean;
      lonMin?: number;
      lonMax?: number;
      latMin?: number;
      latMax?: number;
      updatedWithinSeconds?: number;
      asterixCats?: number[]; // ASTERIX 类目筛选（多选，仅 ASTERIX 来源行有值；重复查询参数 asterixCats=21&asterixCats=62）
    } = {},
  ): Promise<ListResponse<FlightPositionEntity>> {
    const bbox =
      opts.lonMin != null && opts.lonMax != null && opts.latMin != null && opts.latMax != null
        ? { lonMin: opts.lonMin, lonMax: opts.lonMax, latMin: opts.latMin, latMax: opts.latMax }
        : {};
    return request.get('/api/v1/monitor/flight/positions', {
      params: {
        page: opts.page ?? 1,
        pageSize: opts.pageSize ?? 500,
        keyword: opts.keyword || undefined,
        sourceId: opts.sourceId || undefined,
        airborneOnly: opts.airborneOnly || undefined,
        updatedWithinSeconds: opts.updatedWithinSeconds || undefined,
        asterixCats: opts.asterixCats?.length ? opts.asterixCats : undefined,
        ...bbox,
      },
      // indexes:null 把数组展开为重复 key（asterixCats=21&asterixCats=62），
      // 匹配 gRPC transcoding 对 repeated 字段的解析（默认 asterixCats[]=21 形式后端不认）
      paramsSerializer: { indexes: null },
    }) as Promise<unknown> as Promise<ListResponse<FlightPositionEntity>>;
  },
  getPosition(flightKey: string): Promise<FlightPositionEntity> {
    return request.get(
      `/api/v1/monitor/flight/positions/${encodeURIComponent(flightKey)}`,
    ) as Promise<unknown> as Promise<FlightPositionEntity>;
  },
  // ---------- 历史航迹 ----------
  getTrack(
    flightKey: string,
    opts: {
      startTime?: string;
      endTime?: string;
      limit?: number;
      /** 'CURRENT'=仅当前航段（时间缺口≥30min ∪ 停场岛≥10min 切分）；缺省返回保留期全窗。 */
      legMode?: 'CURRENT' | '';
      legGapMinutes?: number;
      legDwellMinutes?: number;
    } = {},
  ): Promise<FlightTrackEntity> {
    return request.get(`/api/v1/monitor/flight/tracks/${encodeURIComponent(flightKey)}`, {
      params: {
        startTime: opts.startTime || undefined,
        endTime: opts.endTime || undefined,
        limit: opts.limit ?? 2000,
        legMode: opts.legMode || undefined,
        legGapMinutes: opts.legGapMinutes ?? undefined,
        legDwellMinutes: opts.legDwellMinutes ?? undefined,
      },
    }) as Promise<unknown> as Promise<FlightTrackEntity>;
  },
  // ---------- 统计 ----------
  getStats(activeWithinSeconds = 300): Promise<FlightStatsEntity> {
    return request.get('/api/v1/monitor/flight/stats', {
      params: { activeWithinSeconds },
    }) as Promise<unknown> as Promise<FlightStatsEntity>;
  },
};

// ===================== ASTERIX（配置驱动类目扩展 + 解码详情） =====================

// UAP Profile（flight_asterix_profiles；FILE 基线 + DB 覆盖两级存储）
export interface AsterixProfileEntity {
  id?: number;
  category?: number; // 1-255
  version?: string;
  name?: string;
  description?: string;
  uapJson?: string; // 完整 Profile JSON 文本
  enabled?: boolean;
  origin?: string; // FILE/DB
  createTime?: string;
  updateTime?: string;
}

// 解码帧留存（flight_asterix_frames；排障型短留存数据）
export interface AsterixFrameEntity {
  id?: number;
  sourceId?: number;
  category?: number;
  sac?: number;
  sic?: number;
  blockLen?: number;
  recordsCount?: number;
  status?: string; // OK/PARTIAL/UNKNOWN_CAT/DECODE_ERROR/FILTERED/DEGRADED_SKIP
  error?: string;
  rawHex?: string;
  decoded?: Record<string, unknown>; // 通用解码树（Struct）
  receiveTime?: string;
}

// 单源 ASTERIX 运行统计
export interface AsterixSourceStatEntity {
  sourceId?: number;
  framesPerMin?: number;
  decodeErrorsPerMin?: number;
  decodeErrorRate?: number; // 5min 滑窗 0-1
  degraded?: boolean;
  lastReceiveTime?: string;
}

export interface AsterixValidateResult {
  valid?: boolean;
  errors?: string[];
  warnings?: string[];
}

export interface AsterixDecodeHexResult {
  frames?: Array<Record<string, unknown>>; // 解码树数组
  warnings?: string[];
}

export const asterixService = {
  // ---------- UAP Profile ----------
  listProfiles(opts: { category?: number; enabled?: boolean } = {}): Promise<ListResponse<AsterixProfileEntity>> {
    return request.get('/api/v1/monitor/flight/asterix/profiles', {
      params: {
        category: opts.category || undefined,
        enabled: opts.enabled ?? undefined,
      },
    }) as Promise<unknown> as Promise<ListResponse<AsterixProfileEntity>>;
  },
  getProfile(id: string | number): Promise<AsterixProfileEntity> {
    return request.get(
      `/api/v1/monitor/flight/asterix/profiles/${Number(id)}`,
    ) as Promise<unknown> as Promise<AsterixProfileEntity>;
  },
  createProfile(data: Partial<AsterixProfileEntity>): Promise<unknown> {
    return request.post('/api/v1/monitor/flight/asterix/profiles', { data });
  },
  updateProfile(id: string | number, data: Partial<AsterixProfileEntity>): Promise<unknown> {
    return request.put(`/api/v1/monitor/flight/asterix/profiles/${Number(id)}`, { data });
  },
  deleteProfile(id: string | number): Promise<unknown> {
    return request.delete(`/api/v1/monitor/flight/asterix/profiles/${Number(id)}`);
  },
  validateProfile(uapJson: string): Promise<AsterixValidateResult> {
    return request.post('/api/v1/monitor/flight/asterix/profiles:validate', {
      uapJson,
    }) as Promise<unknown> as Promise<AsterixValidateResult>;
  },
  // ---------- 解码帧 ----------
  listFrames(
    opts: {
      page?: number;
      pageSize?: number;
      sourceId?: number;
      category?: number;
      status?: string;
      startTime?: string;
      endTime?: string;
    } = {},
  ): Promise<ListResponse<AsterixFrameEntity>> {
    return request.get('/api/v1/monitor/flight/asterix/frames', {
      params: {
        page: opts.page ?? 1,
        pageSize: opts.pageSize ?? 20,
        sourceId: opts.sourceId || undefined,
        category: opts.category || undefined,
        status: opts.status || undefined,
        startTime: opts.startTime || undefined,
        endTime: opts.endTime || undefined,
      },
    }) as Promise<unknown> as Promise<ListResponse<AsterixFrameEntity>>;
  },
  getFrame(id: string | number): Promise<AsterixFrameEntity> {
    return request.get(
      `/api/v1/monitor/flight/asterix/frames/${Number(id)}`,
    ) as Promise<unknown> as Promise<AsterixFrameEntity>;
  },
  // ---------- 工具 ----------
  decodeHex(hex: string, profileId?: number): Promise<AsterixDecodeHexResult> {
    return request.post('/api/v1/monitor/flight/asterix:decode', {
      hex,
      profileId: profileId || undefined,
    }) as Promise<unknown> as Promise<AsterixDecodeHexResult>;
  },
  getSourceStats(sourceId?: number): Promise<ListResponse<AsterixSourceStatEntity>> {
    return request.get('/api/v1/monitor/flight/asterix/stats', {
      params: { sourceId: sourceId || undefined },
    }) as Promise<unknown> as Promise<ListResponse<AsterixSourceStatEntity>>;
  },
};

// ===================== 设备分组与标签（02 v2.0，3.2） =====================

// 资产分组（asset_groups，自引用树，path 物化路径）
export interface AssetGroupEntity extends CrudEntity {
  name?: string;
  parentId?: number;
  description?: string;
  path?: string;
  sort?: number;
  parentName?: string;
  assetCount?: number;
}

export interface AssetGroupTreeNode {
  id?: number;
  name?: string;
  parentId?: number;
  path?: string;
  sort?: number;
  assetCount?: number;
  children?: AssetGroupTreeNode[];
}

export const assetGroupService = {
  ...makeCrudServiceFromClient<AssetGroupEntity>(assetGroupClient),
  tree() {
    return assetGroupClient.Tree({}) as Promise<{ items?: AssetGroupTreeNode[] }>;
  },
  // 变更资产分组（groupId=0 表示移出分组）
  setAssetGroup(assetId: string | number, groupId: number) {
    return assetGroupClient.SetAssetGroup({ id: Number(assetId), groupId }) as Promise<unknown>;
  },
};

// 资产标签（asset_tags）
export interface AssetTagEntity extends CrudEntity {
  name?: string;
  color?: string;
  description?: string;
  assetCount?: number;
}

export const assetTagService = {
  ...makeListWriteServiceFromClient<AssetTagEntity>(assetTagClient),
  // 设置资产标签（全量替换；空数组清空）
  setAssetTags(assetId: string | number, tagIds: number[]) {
    return assetTagClient.SetAssetTags({ id: Number(assetId), tagIds }) as Promise<unknown>;
  },
  listAssetTags(assetId: string | number) {
    return assetTagClient.ListAssetTags({ id: Number(assetId) }) as Promise<ListResponse<AssetTagEntity>>;
  },
};

// 资源组（resource_groups，只读：数据权限角色绑定与分析任务 target_type=resource_group 候选）
export interface ResourceGroupEntity {
  id?: number;
  name?: string;
  description?: string;
  status?: string;
  createTime?: string;
  updateTime?: string;
}

export const resourceGroupService = {
  list(opts: PagingRequest & { formValues?: Record<string, unknown> } = {}) {
    const params = buildQueryParams(opts.formValues, opts);
    return resourceGroupClient.List({
      page: params.page ? Number(params.page) : undefined,
      pageSize: params.pageSize ? Number(params.pageSize) : undefined,
      noPaging: params.noPaging === 'true' ? true : undefined,
      query: params.query,
      orderBy: params.orderBy,
      fieldMask: params.fieldMask,
      sorting: undefined,
    }) as Promise<ListResponse<ResourceGroupEntity>>;
  },
  get(id: string | number) {
    return resourceGroupClient.Get({ id: Number(id) }) as Promise<ResourceGroupEntity>;
  },
};

