    return dcRoomItemClient.BatchUpsert({ roomId, items: items as never }) as Promise<unknown>;
  },
};

export const dcRackService = {
  ...makeCrudServiceFromClient<DcRackEntity>(dcRackClient),
  // 机柜热力图数据（按机房分组）
  heatmap() {
    return dcRackClient.Heatmap({}) as Promise<{ rooms?: DcHeatmapRoomGroup[] }>;
  },
  // U 位立面图数据（从 u_total 到 1）
  rackSlots(id: number) {
    return dcRackClient.RackSlots({ id }) as Promise<DcRackSlotsViewData>;
  },
