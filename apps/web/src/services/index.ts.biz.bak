  dataSource?: string; // device_metrics/alarm_events/device_statistics/mixed/device_health/data_arrival/container_resource/line_quality/inventory_stats/aiops_stats/ticket_stats/notice_stats
  outputFormat?: string; // word/excel/pdf/markdown/html
