  // 立即执行（创建任务；幂等键由服务端按 trigger/source/scene 生成）
  execute(id: number, data: { params?: Record<string, unknown>; targetAssetIds?: number[] }) {
    return aiScenarioClient.ExecuteScenario({
      id,
      params: data.params,
      targetAssetIds: data.targetAssetIds ?? [],
    }) as Promise<AiopsCreateTaskResponse>;
