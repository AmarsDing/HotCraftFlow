  itemId?: number;
  locationId?: number;
  actualQuantity?: number;
  remark?: string;
}

// 盘点任务状态机：created → in_progress（分配负责人）→ completed（全部录完）/ cancelled（删除仅 created 态）
export const inventoryCheckService = {
  listTasks(opts: PagingRequest & { formValues?: Record<string, unknown> } = {}) {
    return inventoryCheckClient.ListTasks(buildPaging(opts)) as Promise<ListResponse<InventoryCheckTaskEntity>>;
  },
  getTask(id: string | number) {
    return inventoryCheckClient.GetTask({ id: Number(id) }) as Promise<InventoryCheckTaskEntity>;
  },
  createTask(data: Partial<InventoryCheckTaskEntity>) {
    return inventoryCheckClient.CreateTask({ data: data as never }) as Promise<unknown>;
  },
  deleteTask(id: string | number) {
    return inventoryCheckClient.DeleteTask({ id: Number(id) }) as Promise<unknown>;
  },
  // 开始盘点：created → in_progress，分配负责人
  startTask(id: string | number, assignedTo?: number) {
    return inventoryCheckClient.StartTask({ id: Number(id), assignedTo }) as Promise<unknown>;
  },
  // 批量录入盘点记录
  submitRecords(id: string | number, records: CheckRecordEntryInput[]) {
    return inventoryCheckClient.SubmitRecords({ id: Number(id), records: records as never }) as Promise<{
      submittedCount?: number;
      taskCompleted?: boolean;
    }>;
  },
  // 确认差异：pending → confirmed
  confirmRecord(id: string | number, recordId: number, reason: string) {
    return inventoryCheckClient.ConfirmRecord({ id: Number(id), recordId, reason }) as Promise<unknown>;
  },
  // 驳回差异：pending → rejected
  rejectRecord(id: string | number, recordId: number, reason: string) {
    return inventoryCheckClient.RejectRecord({ id: Number(id), recordId, reason }) as Promise<unknown>;
  },
  // 差异调整：对 confirmed 记录按 difference 增减库存，置 adjusted（幂等）
  adjust(id: string | number) {
    return inventoryCheckClient.Adjust({ id: Number(id) }) as Promise<{ adjustedCount?: number }>;
  },
};

// ===================== 09 批次 C：智能库房（库房设备 / 库房环境） =====================

// 库房设备（warehouse_devices，§1.24）
export interface WarehouseDeviceEntity extends CrudEntity {
  warehouseId?: number;
  // 设备类型：camera/door_lock/ac/dehumidifier/ups/lighting
  deviceType?: string;
  deviceCode?: string;
  deviceName?: string;
  deviceModel?: string;
  ipAddress?: string;
  locationDesc?: string;
  // 状态：online/offline/alarm/maintenance
  status?: string;
  lastHeartbeat?: string;
  config?: Record<string, unknown>;
  remark?: string;
  warehouseName?: string;
}

export const warehouseDeviceService = {
  ...makeCrudServiceFromClient<WarehouseDeviceEntity>(warehouseDeviceClient),
  // 设备心跳：更新 last_heartbeat=now；status=offline 时自动恢复 online
  heartbeat(id: string | number) {
    return warehouseDeviceClient.Heartbeat({ id: Number(id) }) as Promise<unknown>;
  },
};

// 库房环境监控数据（warehouse_environment，twinmonitor_log 库，§1.25）
export interface EnvironmentRecordEntity {
  id?: number;
  warehouseId?: number;
  temperature?: number;
  humidity?: number;
  // 烟感状态：true-告警
  smoke?: boolean;
  // 漏水状态：true-告警
  waterLeak?: boolean;
  pm25?: number;
  // 门禁状态：open/closed/locked
  doorStatus?: string;
  deviceId?: string;
  recordedAt?: string;
}

export const warehouseEnvironmentService = {
  // 查询仓库最新一条环境数据（仪表盘实时卡片）
  latest(warehouseId: string | number) {
    return warehouseEnvironmentClient.Latest({ warehouseId: Number(warehouseId) }) as Promise<EnvironmentRecordEntity>;
  },
  // 按仓库 + 时间范围分页查询历史环境数据（仪表盘趋势图，startTime/endTime 为 RFC3339）
  query(params: {
    warehouseId: string | number;
    startTime?: string;
    endTime?: string;
    page?: number;
    pageSize?: number;
  }) {
    return warehouseEnvironmentClient.Query({
      warehouseId: Number(params.warehouseId),
      startTime: params.startTime,
      endTime: params.endTime,
      page: params.page,
      pageSize: params.pageSize,
    }) as Promise<ListResponse<EnvironmentRecordEntity>>;
  },
};

// ===================== 资产中心聚合服务（UI 简化后统一入口） =====================
// 见 docs/开发文档/02-设备资产管理/03-设备资产管理-详细设计文档.md §3.6
// 旧 15 页拆分 CRUD 全部收敛到 /asset/center 单页 + 详情抽屉。

// 资产完整详情（§2.2.4）：一次请求聚合基础信息 + 设备扩展 + 资产扩展 + 3D 模型 + 协议绑定 + 履历
export interface AssetFullDetail {
  asset?: MonitorAssetEntity;
  device?: MonitorDeviceEntity;
  extend?: AssetExtendEntity;
  model3d?: { id?: number; name?: string; modelPath?: string; [k: string]: unknown };
  bindings?: DeviceProtocolBindingEntity[];
  histories?: AssetHistoryEntity[];
}

// 资产履历条目
export interface AssetHistoryEntity extends CrudEntity {
  assetId?: number;
  action?: string;
  actionLabel?: string;
  fromStatus?: number;
  toStatus?: number;
  operatorId?: number;
  operatorName?: string;
  remark?: string;
}

// 协议密码字段（解密后，前端按字段渲染）
export interface ProtocolPasswordField {
  protocolType?: string;
  bindingId?: number;
  configTable?: string;
  fields?: Record<string, string>;
}

// 测试连接结果
export interface TestConnectionResult {
  success?: boolean;
  protocolType?: string;
  errorMessage?: string;
  latencyMs?: number;
}

// 从模板创建结果
export interface CreateFromTemplateResult {
  bindingId?: number;
  protocolType?: string;
}

// 批量从模板创建回执（W4/P5）
export interface BatchCreateFromTemplateResult {
  successCount?: number;
  failCount?: number;
  failures?: { deviceId?: number; reason?: string }[];
}

export const assetCenterService = {
  // 资产完整详情（聚合查询，§2.2.4）
  getFullAsset(id: string | number) {
    return monitorAssetClient.GetFullAsset({ id: Number(id) }) as unknown as Promise<AssetFullDetail>;
  },
};

export const protocolBindingService = {
  // 查询设备的所有协议绑定
  listByDevice(deviceId: string | number) {
    return deviceProtocolBindingClient.ListByDevice({ deviceId: Number(deviceId) }) as unknown as Promise<
      ListResponse<DeviceProtocolBindingEntity>
    >;
  },
  // 查询完整协议配置（含解密密码，供编辑表单回填）
  getFullConfig(bindingId: string | number) {
    return deviceProtocolBindingClient.GetFullConfig({ bindingId: Number(bindingId) }) as unknown as Promise<{
      binding?: DeviceProtocolBindingEntity;
      config: Record<string, unknown>;
    }>;
  },
  // 创建协议绑定 + 配置（单事务）
  create(
    deviceId: string | number,
    data: {
      protocolType: string;
      config: Record<string, unknown>;
      isEnabled?: number;
      sort?: number;
      credentialId?: number;
    },
  ) {
    return deviceProtocolBindingClient.CreateBindingWithConfig({
      deviceId: Number(deviceId),
      protocolType: data.protocolType,
      config: data.config as never,
      isEnabled: data.isEnabled,
      sort: data.sort,
      credentialId: data.credentialId,
    }) as Promise<unknown>;
  },
  // 更新协议绑定 + 配置
  update(
    deviceId: string | number,
    bindingId: string | number,
    data: {
      protocolType: string;
      config: Record<string, unknown>;
      isEnabled?: number;
      sort?: number;
      /** 不传=不变更；0=清除引用回到内联凭证；>0=引用凭证库 */
      credentialId?: number;
    },
  ) {
    return deviceProtocolBindingClient.UpdateBindingWithConfig({
      deviceId: Number(deviceId),
      bindingId: Number(bindingId),
      protocolType: data.protocolType,
      config: data.config as never,
      isEnabled: data.isEnabled,
      sort: data.sort,
      credentialId: data.credentialId,
    }) as Promise<unknown>;
  },
  // 删除协议绑定 + 配置（级联软删除）
  remove(deviceId: string | number, bindingId: string | number) {
    return deviceProtocolBindingClient.DeleteBindingWithConfig({
      deviceId: Number(deviceId),
      bindingId: Number(bindingId),
    }) as Promise<unknown>;
  },
  // 测试连接
  testConnection(deviceId: string | number, bindingId: string | number) {
    return deviceProtocolBindingClient.TestConnection({
      deviceId: Number(deviceId),
      bindingId: Number(bindingId),
    }) as unknown as Promise<TestConnectionResult>;
  },
  // 从模板创建
  createFromTemplate(
    deviceId: string | number,
    templateId: string | number,
    opts?: { isEnabled?: number; sort?: number },
  ) {
    return deviceProtocolBindingClient.CreateFromTemplate({
      deviceId: Number(deviceId),
      templateId: Number(templateId),
      isEnabled: opts?.isEnabled,
      sort: opts?.sort,
    }) as unknown as Promise<CreateFromTemplateResult>;
  },
  // 批量从模板创建绑定（W4/P5：逐设备独立事务，回执成功N/失败N+原因）
  batchCreateFromTemplate(
    deviceIds: number[],
    templateId: string | number,
    opts?: { isEnabled?: number; sort?: number },
  ) {
    return deviceProtocolBindingClient.BatchCreateFromTemplate({
      deviceIds,
      templateId: Number(templateId),
      isEnabled: opts?.isEnabled,
      sort: opts?.sort,
    }) as unknown as Promise<BatchCreateFromTemplateResult>;
  },
  // 查询密码字段（需 X-Operation-Password 二次鉴权）
  // 直接使用 axios 实例（绕过生成的客户端，因为后者不支持 per-call header）
  getPasswordView(deviceId: string | number, operationPassword: string) {
    return request.get<{ items: ProtocolPasswordField[] }>(`/api/v1/monitor/devices/${deviceId}/password`, {
      headers: { 'X-Operation-Password': operationPassword },
    });
  },
};

// ===================== Collector: 采集任务 =====================
export interface CollectionTaskEntity extends CrudEntity {
  deviceId?: number;
  protocolType?: string;
  protocolBindingId?: number;
  taskName?: string;
  priority?: number;
  collectionInterval?: number;
  timeout?: number;
  retryCount?: number;
  retryInterval?: number;
  status?: number;
  offlineThreshold?: number;
  nodeId?: number;
  lastCollectAt?: string;
  lastCollectStatus?: number;
  consecutiveFailures?: number;
  // 采集结果派生态（后端按 lastCollectStatus + lastCollectAt 新鲜度推导）：1成功 2失败 3停滞 4未调度
  collectHealth?: number;
  tenantId?: number;
}
export interface CollectOnceResult {
  accepted: boolean;
  message: string;
}
export interface ReloadConfigResult {
  loaded: number;
  failed: number;
  failedBindingIds: number[];
}
export const collectionTaskService = {
  list(opts: PagingRequest & { formValues?: Record<string, unknown> } = {}) {
    const params = buildQueryParams(opts.formValues, opts);
    return collectionTaskClient.ListTasks({
      page: params.page ? Number(params.page) : undefined,
      pageSize: params.pageSize ? Number(params.pageSize) : undefined,
      noPaging: params.noPaging === 'true' ? true : undefined,
      query: params.query,
      orderBy: params.orderBy,
      fieldMask: params.fieldMask,
    } as never) as Promise<ListResponse<CollectionTaskEntity>>;
  },
  get(id: string | number) {
    return collectionTaskClient.GetTask({ id: Number(id) }) as Promise<CollectionTaskEntity>;
  },
  create(data: Partial<CollectionTaskEntity>) {
    return collectionTaskClient.CreateTask({ data: data as never }) as Promise<unknown>;
  },
  update(id: string | number, data: Partial<CollectionTaskEntity>) {
    return collectionTaskClient.UpdateTask({ id: Number(id), data: data as never }) as Promise<unknown>;
  },
  delete(id: string | number) {
    return collectionTaskClient.DeleteTask({ id: Number(id) }) as Promise<unknown>;
  },
  start(id: string | number) {
    return collectionTaskClient.StartTask({ id: Number(id) }) as Promise<unknown>;
  },
  stop(id: string | number) {
    return collectionTaskClient.StopTask({ id: Number(id) }) as Promise<unknown>;
  },
  pause(id: string | number) {
    return collectionTaskClient.PauseTask({ id: Number(id) }) as Promise<unknown>;
  },
  collectOnce(id: string | number) {
    return collectionTaskClient.CollectOnce({ id: Number(id) }) as unknown as Promise<CollectOnceResult>;
  },
  reloadConfig() {
    return collectionTaskClient.ReloadConfig({}) as unknown as Promise<ReloadConfigResult>;
  },
};

