// ===================== Alarm: 实时告警事件 =====================
// alarmId 为业务主键（ALM+YYYYMMDD+seq 字符串），非 numeric id。
// list/get/confirm/escalate/recover/close/getStatistics 均为非标准 CRUD，手写。
export interface AlarmEventEntity {
  id?: number;
  alarmId?: string;
  ruleId?: number;
  deviceId?: number;
  deviceName?: string;
  deviceType?: string;
  location?: string;
  alarmType?: string;
  alarmLevel?: string;
  alertLevel?: number;
  metricName?: string;
  metricKey?: string;
  metricValue?: number;
  metricUnit?: string;
  threshold?: number;
  alarmTime?: string;
  alarmDuration?: number;
  status?: string;
  message?: string;
  description?: string;
  noticeProfileId?: number;
  dataSource?: string;
  isSolve?: number;
  confirmedAt?: string;
  confirmedBy?: number;
  recoveredAt?: string;
  closedAt?: string;
  // v2.0 外部接入 / AI 增强
  source?: string;
  sourceId?: number;
  rawSeverity?: string;
  aiAnalyzed?: number;
  aiAnalysisId?: string;
  aiAdvice?: string;
  aiQuarantined?: number;
  aiRcaConclusion?: string;
  aiRcaConfidence?: number;
  createTime?: string;
  updateTime?: string;
}
export interface AlarmStatisticsEntity {
  totalEvents?: number;
  activeEvents?: number;
  confirmedEvents?: number;
  recoveredEvents?: number;
  closedEvents?: number;
  mttr?: number;
  mtta?: number;
  levelDistribution?: Record<string, number>;
  statusDistribution?: Record<string, number>;
  topDevices?: Array<{ deviceId?: number; deviceName?: string; alarmCount?: number }>;
}
export const alarmEventService = {
  list(
    opts: PagingRequest & {
      formValues?: Record<string, unknown>;
      deviceId?: number;
      alarmLevel?: string;
      status?: string;
      ruleId?: number;
      metricKey?: string;
      keyword?: string;
      // 告警来源（monitoralarm alarm_events.source 精确匹配；opstools_dbmonitor 为 16-03 M3 库告警源）
      source?: string;
      startTime?: string;
      endTime?: string;
      // 分类轴过滤（2026-09-21 告警分类化）：分类树根 code 或保留轴 line/data/misc
      categoryCode?: string;
    } = {},
  ) {
    const params = buildQueryParams(opts.formValues, opts);
    const fv = opts.formValues ?? {};
    return alarmEventClient.ListEvents({
      deviceId: opts.deviceId ?? (fv.deviceId as number | undefined),
      alarmLevel: opts.alarmLevel ?? (fv.alarmLevel as string | undefined),
      status: opts.status ?? (fv.status as string | undefined),
      ruleId: opts.ruleId ?? (fv.ruleId as number | undefined),
      metricKey: opts.metricKey ?? (fv.metricKey as string | undefined),
      keyword: opts.keyword ?? (fv.keyword as string | undefined),
      source: opts.source ?? (fv.source as string | undefined),
      startTime: opts.startTime ?? (fv.startTime as string | undefined),
      endTime: opts.endTime ?? (fv.endTime as string | undefined),
      categoryCode: opts.categoryCode ?? (fv.categoryCode as string | undefined),
      page: params.page ? Number(params.page) : undefined,
      pageSize: params.pageSize ? Number(params.pageSize) : undefined,
    }) as Promise<ListResponse<AlarmEventEntity>>;
  },
  get(alarmId: string | number) {
    return alarmEventClient.GetEvent({ alarmId: String(alarmId) }) as Promise<AlarmEventEntity>;
  },
  confirmEvent(
    alarmId: string,
    payload: { userId?: number; userName?: string; confirmRemark?: string; clientRequestId?: string },
  ) {
    return alarmEventClient.ConfirmEvent({
      alarmId,
      userId: payload.userId,
      userName: payload.userName,
      confirmRemark: payload.confirmRemark,
      clientRequestId: payload.clientRequestId,
    }) as Promise<unknown>;
  },
  escalateEvent(
    alarmId: string,
    payload: {
      newLevel?: string;
      escalationType?: string;
      escalationReason?: string;
      userId?: number;
      userName?: string;
      clientRequestId?: string;
    },
  ) {
    return alarmEventClient.EscalateEvent({
      alarmId,
      newLevel: payload.newLevel,
      escalationType: payload.escalationType,
      escalationReason: payload.escalationReason,
      userId: payload.userId,
      userName: payload.userName,
      clientRequestId: payload.clientRequestId,
    }) as Promise<unknown>;
  },
  recoverEvent(
    alarmId: string,
    payload: { userId?: number; userName?: string; recoverRemark?: string; clientRequestId?: string },
  ) {
    return alarmEventClient.RecoverEvent({
      alarmId,
      userId: payload.userId,
      userName: payload.userName,
      recoverRemark: payload.recoverRemark,
      clientRequestId: payload.clientRequestId,
    }) as Promise<unknown>;
  },
  closeEvent(
    alarmId: string,
    payload: { userId?: number; userName?: string; closeRemark?: string; clientRequestId?: string },
  ) {
    return alarmEventClient.CloseEvent({
      alarmId,
      userId: payload.userId,
      userName: payload.userName,
      closeRemark: payload.closeRemark,
      clientRequestId: payload.clientRequestId,
    }) as Promise<unknown>;
  },
  noteEvent(
    alarmId: string,
    payload: { userId?: number; userName?: string; note: string; source?: string; clientRequestId?: string },
  ) {
    return alarmEventClient.NoteEvent({
      alarmId,
      userId: payload.userId,
      userName: payload.userName,
      note: payload.note,
      source: payload.source ?? 'Web',
      clientRequestId: payload.clientRequestId,
    }) as Promise<unknown>;
  },
  // 查询告警处置动作时间线（confirm/escalate/recover/close/note 合并，按时间倒序）
  listEventActions(alarmId: string) {
    return alarmEventClient.ListEventActions({ alarmId }) as Promise<{ items?: AlarmEventActionEntity[] }>;
  },
  // 查询自动处理记录（alert_process_logs，分页，按 alert_id/action/status/mapping_id/时间范围筛选）
  listProcessLogs(
    opts: PagingRequest & {
      alertId?: string;
      action?: string;
      status?: string;
      mappingId?: number;
      startTime?: string;
      endTime?: string;
    } = {},
  ) {
    return alarmEventClient.ListProcessLogs({
      alertId: opts.alertId,
      action: opts.action,
      status: opts.status,
      mappingId: opts.mappingId,
      startTime: opts.startTime,
      endTime: opts.endTime,
      page: opts.page,
      pageSize: opts.pageSize,
    }) as Promise<ListResponse<AlertProcessLogEntity>>;
  },
  getProcessLog(id: string | number) {
    return alarmEventClient.GetProcessLog({ id: Number(id) }) as Promise<AlertProcessLogEntity>;
  },
  // 手动触发告警处理（v2.0 §4.4.4）：映射匹配/维修策略/AI 分析异步受理，结果见过程日志。
  // 2026-09-21 接线：此前 RPC 存在但前端无入口，过程日志"手动链路"长期空数据。
  processEvent(alarmId: string, operatorId?: number) {
    return alarmEventClient.ProcessEvent({
      alarmId,
      operatorId: operatorId ?? 0,
    }) as Promise<{
      alarmId?: string;
      matchedRepairStrategies?: number;
      matchedMappings?: number;
      createdExecutions?: number;
      aiAnalysisTaskId?: string;
      message?: string;
    }>;
  },
  // 按设备分组统计告警摘要（运维中心卡片墙批量取数；deviceIds 为空=统计全部设备）
  // 仅返回有告警记录的设备，未出现的设备视为无告警。
  countByDevice(deviceIds: number[] = []) {
    return alarmEventClient.CountEventsByDevice({ deviceIds }) as Promise<DeviceAlarmSummaryListResponse>;
  },
  // W4/G-5 告警统计聚合：一次拿级别分布/状态分布（IT 告警页级别条 + 页签徽标，替代 4+1 次 pageSize=1 轮询）。
  // status/categoryCode 与列表同口径；不传则为全量。
  getStatistics(
    opts: {
      startTime?: string;
      endTime?: string;
      deviceId?: number;
      alarmLevel?: string;
      status?: string;
      categoryCode?: string;
    } = {},
  ) {
    return alarmEventClient.GetStatistics({
      startTime: opts.startTime ?? undefined,
      endTime: opts.endTime ?? undefined,
      deviceId: opts.deviceId ?? undefined,
      alarmLevel: opts.alarmLevel ?? undefined,
      status: opts.status ?? undefined,
      categoryCode: opts.categoryCode ?? undefined,
    }) as Promise<AlarmStatisticsEntity>;
  },
};

