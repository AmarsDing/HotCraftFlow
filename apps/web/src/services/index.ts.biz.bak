};

export const dcPduDeviceService = makeCrudServiceFromClient<DcPduDeviceEntity>(dcPduDeviceClient);
export const dcPowerCabinetService = makeCrudServiceFromClient<DcPowerCabinetEntity>(dcPowerCabinetClient);
export const dcPowerLineService = makeCrudServiceFromClient<DcPowerLineEntity>(dcPowerLineClient);
// 线缆（CRUD + 批量新建：CSV 批量导入用，行级容错返回逐行错误）
export const dcCableService = {
  ...makeCrudServiceFromClient<DcCableEntity>(dcCableClient),
  batchCreate(items: DcCableEntity[]) {
    const payload = items.map((it) => ({
      label: it.label,
      cableType: it.cableType,
      status: it.status,
      aAssetId: it.aAssetId,
      bAssetId: it.bAssetId,
      lengthM: it.lengthM,
      aPort: it.aPort,
      bPort: it.bPort,
      spec: it.spec,
      color: it.color,
      networkDomain: it.networkDomain,
    }));
    return dcCableClient.BatchCreate({ items: payload }) as Promise<{
      succeeded?: number;
      failed?: number;
      errors?: { stage?: string; name?: string; message?: string }[];
    }>;
  },
};

// 生命周期履历（只读服务，无 CRUD），复用 buildPaging 组装分页查询
export const dcLifecycleLogService = {
  list(opts: PagingRequest & { formValues?: Record<string, unknown> } = {}) {
    return dcLifecycleLogClient.List(buildPaging(opts)) as Promise<ListResponse<DcLifecycleLogEntity>>;
  },
};

// 数据中心导入导出（§2.19.9）
export const dcIOService = {
  exportData() {
    return dcIOClient.Export({}) as Promise<Record<string, unknown>>;
  },
  importData(payload: Record<string, unknown>) {
    return dcIOClient.Import(payload as never) as Promise<DcImportResultData>;
  },
};

