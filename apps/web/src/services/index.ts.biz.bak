  id: string;
  type: 'line' | 'bar' | 'gauge' | 'liquid' | 'ring' | 'stat' | 'radar' | 'table';
  title: string;
  position: PanelLayoutPosition;
  dataSource: PanelLayoutDataSource;
  style?: Record<string, unknown>;
}
