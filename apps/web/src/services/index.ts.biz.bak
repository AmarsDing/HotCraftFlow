// U 位分配（§2.19.2/§2.19.3，动作型 POST）
export const dcRackSlotService = {
  assign(data: { rackId: number; assetId: number; startU: number; endU: number; direction: string }) {
    return dcRackSlotClient.Assign(data) as Promise<unknown>;
  },
  move(id: number, data: { rackId: number; startU: number; endU: number; direction: string }) {
    return dcRackSlotClient.Move({ id, ...data }) as Promise<unknown>;
  },
  unassign(id: number) {
    return dcRackSlotClient.Unassign({ id }) as Promise<unknown>;
