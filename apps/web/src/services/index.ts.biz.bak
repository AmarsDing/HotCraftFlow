// 排班生成生效模式（排班变更管理设计 §5）
export const GENERATE_MODE = {
  draftOnly: 'draft_only',
  skipPublished: 'skip_published',
  regenerateUntouched: 'regenerate_untouched',
  regenerateAll: 'regenerate_all',
} as const;
export type GenerateMode = (typeof GENERATE_MODE)[keyof typeof GENERATE_MODE];

export const scheduleService = {
  ...makeCrudServiceFromClient<ScheduleEntity>(scheduleClient),
  generate(ruleId: number, startDate: string, endDate: string, opts?: { mode?: GenerateMode; dryRun?: boolean }) {
    return scheduleClient.Generate({
      ruleId,
      startDate,
      endDate,
      includeHoliday: false,
      mode: opts?.mode,
      dryRun: opts?.dryRun,
    }) as Promise<GenerateScheduleResult>;
  },
  adjust(detailId: number, userId: number, reason?: string) {
    return scheduleClient.Adjust({ detailId, userId, reason }) as Promise<unknown>;
  },
  publish(ids: number[]) {
    return scheduleClient.Publish({ ids }) as Promise<unknown>;
  },
  // 排班变更管理设计 §4：单日变更四动作（换班对调/整天替换/加人/减人）
  swap(detailIdA: number, detailIdB: number, reason?: string) {
    return scheduleClient.Swap({ detailIdA, detailIdB, reason }) as Promise<unknown>;
  },
  batchAdjust(scheduleId: number, userIds: number[], reason?: string) {
    return scheduleClient.BatchAdjust({ scheduleId, userIds, reason }) as Promise<unknown>;
  },
  addDetail(scheduleId: number, userId: number, reason?: string) {
    return scheduleClient.AddDetail({ scheduleId, userId, reason }) as Promise<unknown>;
  },
  removeDetail(detailId: number, reason?: string) {
    return scheduleClient.RemoveDetail({ detailId, reason }) as Promise<unknown>;
  },
};

