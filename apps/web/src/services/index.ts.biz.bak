// ===================== 统一凭证库（credential_store，v2.0 §2.20） =====================
// 秘密字段（password/privateKey/authKey/privKey）写入时传明文（后端 AES-256-GCM 加密存储），
// List/Get 出参一律脱敏为 ******；明文仅通过 getSecret 按需解密返回（二次鉴权）。
export interface CredentialEntity extends CrudEntity {
  name?: string;
  // ssh_key-SSH 私钥 / password-账号密码 / snmp_v2c / snmp_v3
  credType?: string;
  username?: string;
  // 密码（snmp_v2c 复用为社区字符串）；出参脱敏
  password?: string;
  // SSH 私钥；出参脱敏
  privateKey?: string;
  keyFingerprint?: string;
  snmpPort?: number;
  snmpVersion?: string;
  authProtocol?: string;
  authKey?: string;
  privProtocol?: string;
  privKey?: string;
  description?: string;
  // 使用计数（协议绑定 + PDU 引用 + 摄像头引用数），只读
  usageCount?: number;
  // 最近连接测试时间/结果/信息（只读，连接测试后由后端回写，§2.20.2 v2.4）
  lastTestedAt?: string;
  lastTestSuccess?: boolean;
  lastTestMessage?: string;
  tenantId?: number;
}

export interface CredentialTestResult {
  success?: boolean;
  message?: string;
  latencyMs?: number;
  // 机器可读错误分类（空串=成功；DECRYPT_FAILED/KEY_PARSE_FAILED/DIAL_TIMEOUT/CONN_REFUSED/
  // HOST_UNREACHABLE/AUTH_FAILED/SESSION_FAILED/EXEC_FAILED/SNMP_NO_RESPONSE/SNMP_FAILED/DIAL_FAILED/UNSUPPORTED_TYPE）
  errorCode?: string;
}

export interface CredentialSecretEntity {
  credType?: string;
  username?: string;
  password?: string;
  privateKey?: string;
  authKey?: string;
  privKey?: string;
}

export interface CredentialUsageEntity {
  usageCount?: number;
  devices?: {
    deviceId?: number;
    bindingId?: number;
    deviceName?: string;
    protocolType?: string;
    // 资产 ID（跳转资产中心用）
    assetId?: number;
    // 目标主机/端口（按 config_table+config_id 从协议配置表解析；配置缺失时为空，前端禁用行内测试）
    host?: string;
    port?: number;
    // 绑定是否启用：0-否，1-是
    isEnabled?: number;
  }[];
  pduDevices?: {
    id?: number;
    name?: string;
    rackNo?: string;
    // 管理 IP（测试目标 = ip : 凭证 snmp_port）
    ip?: string;
  }[];
  // 摄像头引用（rtsp/onvif 凭证；测试目标 = main_stream URL 解析 host/port，缺省 rtsp 554/onvif 80）
  cameras?: {
    id?: number;
    deviceId?: number;
    deviceName?: string;
    protocol?: string;
    host?: string;
    port?: number;
  }[];
}

// 协议目标（ListProtocolTargets 批量聚合，测试连接"从全部设备选择"数据源）
export interface ProtocolTargetItem {
  assetId?: number;
  assetName?: string;
  deviceCategoryId?: number;
  host?: string;
  port?: number;
  credentialConfigured?: boolean;
  hasEnabledSnmp?: boolean;
}

export const credentialService = {
  ...makeCrudServiceFromClient<CredentialEntity>(credentialClient),
  // 连接测试（§2.20.2）：host 必填，port 可空（SSH 默认 22，SNMP 默认取凭证 snmp_port）
  testConnection(id: string | number, host: string, port?: number) {
    return credentialClient.TestConnection({ id: Number(id), host, port }) as Promise<CredentialTestResult>;
  },
  // 查看明文（§2.20.3，二次鉴权：X-Operation-Password 携带用户独立操作密码）。
  // 直接使用 axios 实例（生成的客户端不支持 per-call header），与 getPasswordView 同模式。
  getSecret(id: string | number, operationPassword: string) {
    return request.get<CredentialSecretEntity>(`/api/v1/monitor/credentials/${Number(id)}/secret`, {
      headers: { 'X-Operation-Password': operationPassword },
    });
  },
  // 使用情况（§2.20.4）：引用该凭证的设备绑定 / PDU 清单（含目标地址，支撑行内测试）
  getUsage(id: string | number) {
    return credentialClient.GetUsage({ id: Number(id) }) as Promise<CredentialUsageEntity>;
  },
  // 批量协议目标列表（测试连接"从全部设备选择"数据源；按凭证类型映射协议：ssh_key/password→ssh，snmp_*→snmp）
  listProtocolTargets(protocolType: string) {
    return deviceProtocolBindingClient.ListProtocolTargets({ protocolType }) as Promise<{
      items?: ProtocolTargetItem[];
    }>;
  },
};

