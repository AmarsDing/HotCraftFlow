  isDefault?: number;
  tenantId?: number;
}
export interface AlarmDeviceTemplateItemEntity {
  id?: number;
  templateId?: number;
  itemName?: string;
  itemKey?: string;
  metricType?: string;
  unit?: string;
  warningMin?: number;
  warningMax?: number;
  fatalMin?: number;
  fatalMax?: number;
  recoverWarningMin?: number;
  recoverWarningMax?: number;
  recoverFatalMin?: number;
  recoverFatalMax?: number;
