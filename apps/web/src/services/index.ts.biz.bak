// 机房（dc_rooms，§1.29）
export interface DcRoomEntity extends CrudEntity {
  name?: string;
  label?: string;
  description?: string;
  widthM?: number;
  depthM?: number;
  sort?: number;
  /** 机房状态：0-启用，1-禁用 */
  status?: number;
  /** 楼层（如 2 / B1） */
  floor?: string;
  /** 面积（平方米） */
  areaM2?: number;
  /** 联系人 */
  contact?: string;
  rackCount?: number;
}

// 机柜（dc_racks，§1.30）
export interface DcRackEntity extends CrudEntity {
  rackNo?: string;
  roomId?: number;
  rowNo?: string;
  uTotal?: number;
  sort?: number;
  status?: number;
  // 资产台账 ID（v2.6 D4：机柜纳入资产台账，可建档/归属/盘点；rackNo 作为位置标识不被覆盖）
