// ---- 线路全息摘要（监控工作台全息卡：24h 健康热力槽 + 活跃事件 + 主备承载 + 端点设备身份）----
// 端点设备告警计数由前端经 monitoralarm countByDevice 聚合（跨服务不互调，同 ops-center 卡片墙模式）
export interface LineInsightSlot {
  time?: string; // 槽起始时刻（10min 对齐，时间升序）
  status?: string; // 槽内最差态：online/degraded/offline/no_data
  rtt?: number; // 槽内 RTT 均值 ms（无数据 0）
  packetLossRate?: number; // 槽内丢包率均值 %
}

export interface LineInsightEvent {
  id?: number;
  eventType?: string;
  severity?: string;
  startTime?: string;
  thresholdValue?: string;
  actualValue?: string;
}

export interface LineInsightDigest {
  lineId?: number;
  slots?: LineInsightSlot[];
  activeEventCount?: number;
  latestEvent?: LineInsightEvent; // 最新一条活跃事件；无则缺省
  switchoverActive?: boolean;
  activeLineId?: number; // 当前承载线路（无切换=本线 id）
  activeLineName?: string;
  sourceDeviceId?: number;
  sourceDeviceName?: string;
  targetDeviceId?: number;
  targetDeviceName?: string;
}

// ---- 实时状态 / 看板 / 历史 ----
export interface LineRealtimeStatusEntity {
  lineId?: number;
  lineName?: string;
  status?: string; // online/offline/degraded/unknown
  inBandwidth?: number;
  outBandwidth?: number;
  totalBandwidthUsage?: number;
  rtt?: number;
  avgDelay?: number;
  maxDelay?: number;
  packetLossRate?: number;
  qualityScore?: number;
  lastProbeAt?: string;
  lastEventType?: string;
}

export interface LineDashboardData {
  total?: number;
  online?: number;
  offline?: number;
  degraded?: number;
  activeEvents?: number;
  items?: LineRealtimeStatusEntity[];
}

export interface LineHistoryPointEntity {
  time?: string;
  rtt?: number;
  avgDelay?: number;
  maxDelay?: number;
  packetLossRate?: number;
  totalBandwidthUsage?: number;
  qualityScore?: number;
  status?: string;
  inBandwidth?: number;
  outBandwidth?: number;
}

export const lineStatusService = {
  dashboard() {
    return lineMonitorClient.GetDashboard({}) as Promise<LineDashboardData>;
  },
  realtime(lineId: string | number) {
    return lineMonitorClient.GetLineRealtime({ id: Number(lineId) }) as Promise<LineRealtimeStatusEntity>;
  },
  // 历史指标（interval 为空后端自动：≤24h raw / ≤7d 1h / 否则 1d）
  history(lineId: string | number, opts: { startTime: string; endTime: string; metrics?: string; interval?: string }) {
    return lineMonitorClient.GetLineHistory({
      id: Number(lineId),
      startTime: opts.startTime,
      endTime: opts.endTime,
      metrics: opts.metrics || undefined,
      interval: opts.interval || undefined,
    }) as Promise<{ lineId?: number; points?: LineHistoryPointEntity[] }>;
  },
  // 热重载线路/监控/阈值配置（运维操作）
  reload() {
    return lineMonitorClient.Reload({}) as Promise<unknown>;
  },
  // 线路拓扑（设备节点 + 线路状态连线，P3 工作台拓扑态数据源）
  topology() {
    return lineMonitorClient.GetTopology({}) as Promise<LineTopologyData>;
  },
  // 全息卡关联摘要（可见卡片批量 1-50 条；生成客户端尚未覆盖新 RPC，走原生 GET）
  insightDigest(lineIds: number[]) {
    return request.get<{ items?: LineInsightDigest[] }>('/api/v1/monitor/linemonitor/lines/insight-digest', {
      params: { lineIds: lineIds.join(',') },
    });
  },
};

