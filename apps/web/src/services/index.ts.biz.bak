  },
  onboard(body: {
    templateCode?: string;
    name: string;
    siteCode: string;
    siteName?: string;
    latitude?: number;
    longitude?: number;
    band?: string;
    radarModel?: string;
    createSite?: boolean;
    host?: string;
    port?: number;
    leaf?: string;
  }) {
    return request.post<{
      deviceId?: number;
      assetId?: number;
      alarmTemplateBound?: boolean;
      idempotent?: boolean;
      error?: string;
      protocol?: string;
      nextSteps?: string[];
      bindingWarning?: string;
      binding?: { id?: number; protocolType?: string; configTable?: string; configId?: number };
    }>('/api/v1/admin/metradar/wizard/onboard', body);
  },
  listAlarmCodes(leaf?: string) {
    return request.get<{ items?: MetradarAlarmCodeEntity[] }>('/api/v1/admin/metradar/alarm-codes', {
      params: leaf ? { leaf } : undefined,
    });
  },
  upsertAlarmCode(body: MetradarAlarmCodeEntity) {
    return request.post<{ ok?: boolean }>('/api/v1/admin/metradar/alarm-codes', body);
  },
  importAlarmCodes(file: File) {
    const fd = new FormData();
    fd.append('file', file);
    return request.post<{ imported?: number }>('/api/v1/admin/metradar/alarm-codes:import', fd);
  },
};

