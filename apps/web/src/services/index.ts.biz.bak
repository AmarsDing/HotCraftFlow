  },
  // 手动同步；endpointId 0/缺省 = 跨主机全部端点
  sync(endpointId?: number) {
    return unwrapVirt(
      request.post<VirtEnvelope<unknown>>(`${VIRT_BASE}/images/sync`, {
        endpoint_id: endpointId || 0,
      }),
    );
