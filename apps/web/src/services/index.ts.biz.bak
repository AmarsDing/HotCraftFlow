  },
  dnsQuery(req: DnsQueryRequest) {
    return opstoolsDiagnoseClient.DnsQuery(req) as Promise<DnsQueryResponse>;
  },
  sslCheck(req: SslCheckRequest) {
    return opstoolsDiagnoseClient.SslCheck(req) as Promise<SslCheckResponse>;
  },
  mtuDetect(req: MtuDetectRequest) {
    return opstoolsDiagnoseClient.MtuDetect(req) as Promise<MtuDetectResponse>;
  },
  neighborProbe(req: NeighborProbeRequest) {
    return opstoolsDiagnoseClient.NeighborProbe(req) as Promise<NeighborProbeResponse>;
  },
  // F17 内网测速（打流风控：时长 ≤30s、并行 ≤8，全程审计）
  throughputTest(req: ThroughputTestRequest) {
    return opstoolsDiagnoseClient.ThroughputTest(req) as Promise<ThroughputTestResponse>;
  },
  // F18 会话数压测（梯度爬升 + 成功率 <50% 熔断）
  sessionStressTest(req: SessionStressTestRequest) {
    return opstoolsDiagnoseClient.SessionStressTest(req) as Promise<SessionStressTestResponse>;
  },
  // F19 DHCP 私接检测（UDP 广播，bridge 网络限本容器网段）
